   if(!rename($msTmp,$msPath))throw new RuntimeException('A script cseréje sikertelen.');$msTmp=null;
   if(file_get_contents($msPath)!==$msChanged)throw new RuntimeException('A visszaolvasás sikertelen. Biztonsági másolat: '.$msBackup);
   $msSource=$msChanged;$msValues=$msNew;$msMessage='Sikeresen mentve és visszaellenőrizve. A következő scriptfutás ezeket használja. Biztonsági másolat: '.basename($msBackup);
  }
 }
}catch(Throwable $e){$msError=$e->getMessage();}
finally{if($msTmp&&is_file($msTmp))unlink($msTmp);if(is_resource($msLock)){flock($msLock,LOCK_UN);fclose($msLock);}}
