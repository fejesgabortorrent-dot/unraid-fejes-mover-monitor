<script>
(()=>{const t=document.getElementById('ms-threshold'),s=document.getElementById('ms-slider'),c=document.getElementById('ms-cooldown'),free=<?=json_encode($msFree!==false?$msFree/1073741824:null)?>,total=<?=json_encode($msTotal?$msTotal/1073741824:null)?>;function preview(){document.getElementById('ms-hours').textContent=(Number(c.value)/60).toLocaleString('en-US',{maximumFractionDigits:2})+' hours';document.getElementById('ms-marker').style.left=Math.max(0,Math.min(100,100*(1-Number(t.value)/total)))+'%';document.getElementById('ms-preview').textContent=free===null?'Cache data is currently unavailable.':free<Number(t.value)?'Free space is already below the threshold. The next check decides whether to start based on guards and the retry interval.':'Another '+(free-Number(t.value)).toLocaleString('en-US',{maximumFractionDigits:1})+' GiB of free space can be used before reaching the threshold.';}t.addEventListener('input',()=>{s.value=t.value;preview()});s.addEventListener('input',()=>{t.value=s.value;preview()});c.addEventListener('input',preview);t.form.addEventListener('reset',()=>setTimeout(preview,0));preview();})();
