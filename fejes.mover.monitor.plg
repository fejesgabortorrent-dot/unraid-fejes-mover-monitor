  if($fmc['error']||!is_resource($fmc['lock']))throw new RuntimeException('A konfiguráció nem olvasható biztonságosan.');
  if($fmc['mode']==='demo'){
   if(!in_array($fpAction,['check','dry-run'],true))throw new RuntimeException('Demo módban nincs élő művelet.');
   $fpReport=['torrent'=>'no_torrent_blocker','checked_torrents'=>7,'blocking_torrents'=>0,'cache_free_bytes'=>633*1073741824,'remaining_upper_bound_bytes'=>20*1073741824,'pressure'=>'ok'];
   if($fpAction==='dry-run')$fpReport['dry_run']=['decision'=>'wait','read_only'=>true,'checks'=>[['key'=>'capacity','state'=>'wait','detail'=>['free_gib'=>633,'threshold_gib'=>300]],['key'=>'torrent','state'=>'pass','detail'=>0],['key'=>'backup','state'=>'pass'],['key'=>'parity','state'=>'pass'],['key'=>'mover','state'=>'pass'],['key'=>'cooldown','state'=>'pass'],['key'=>'launcher','state'=>'pass']]];
   $fpMessage='Szimulált állapot. Nincs élő lekérdezés.';
