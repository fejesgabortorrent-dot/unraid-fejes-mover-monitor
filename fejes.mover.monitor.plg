<?php
$fmMounted=(static function(){foreach(explode("\n",@file_get_contents('/proc/self/mountinfo')?:'') as $line){$fields=explode(' ',$line);if(($fields[4]??'')==='/mnt/cache')return true;}return false;})();
$fmRead=static fn($p)=>@file_get_contents($p)?:'';
$fmEsc=static fn($s)=>htmlspecialchars((string)$s,ENT_QUOTES|ENT_SUBSTITUTE,'UTF-8');
$fmRaw=trim($fmRead('/var/run/mover.pid'));$fmPid=ctype_digit($fmRaw)?(int)$fmRaw:0;
$fmCmd=$fmPid?str_replace(chr(0),' ',$fmRead("/proc/$fmPid/cmdline")):'';
$fmRun=$fmPid>1&&preg_match('~(?:^|[ /])mover(?: |$)~',$fmCmd);
$fmIds=[];$fmFiles=[];
if($fmRun){
$fmIds[$fmPid]=true;$fmParents=[];
foreach(glob('/proc/[0-9]*/status')?:[] as $p){$s=$fmRead($p);if(preg_match('/^Pid:\s+(\d+)/m',$s,$a)&&preg_match('/^PPid:\s+(\d+)/m',$s,$b))$fmParents[(int)$a[1]]=(int)$b[1];}
do{$add=false;foreach($fmParents as $p=>$parent)if(isset($fmIds[$parent])&&!isset($fmIds[$p])){$fmIds[$p]=true;$add=true;}}while($add);
foreach($fmIds as $p=>$_)foreach(glob("/proc/$p/fd/*")?:[] as $fd){
$path=@readlink($fd);if(!$path||!str_starts_with($path,'/mnt/')||str_ends_with($path,' (deleted)'))continue;
$st=@stat($fd);if(!$st||(($st['mode']&0170000)!==0100000))continue;
$info=$fmRead("/proc/$p/fdinfo/".basename($fd));preg_match('/^pos:\s+(\d+)/m',$info,$pos);preg_match('/^flags:\s+([0-7]+)/m',$info,$fl);
$fmFiles[]=['path'=>$path,'pos'=>(int)($pos[1]??0),'size'=>$st['size'],'mode'=>isset($fl[1])?(octdec($fl[1])&3):-1];if(count($fmFiles)>=40)break 2;
}}
$fmTotal=$fmMounted?@disk_total_space('/mnt/cache'):false;$fmFree=$fmMounted?@disk_free_space('/mnt/cache'):false;
$fmUsed=$fmTotal&&$fmFree!==false?round(100*(1-$fmFree/$fmTotal),1):null;
$fmScript=$fmRead('/boot/config/plugins/user.scripts/scripts/Filmek_Mover_Threshold/script');preg_match('/^KUSZOB_GIB=(\d+)/m',$fmScript,$fmMatch);$fmThreshold=$fmMatch[1]??null;
$fmGiB=static fn($n)=>number_format($n/1073741824,1,',',' ');
$fmTail=static function($path,$limit){$f=@fopen($path,'rb');if(!$f)return '';$sz=fstat($f)['size'];$offset=max(0,$sz-$limit);fseek($f,$offset);$s=stream_get_contents($f);fclose($f);if($offset){$nl=strpos($s,"\n");$s=$nl===false?'':substr($s,$nl+1);}return $s;};
$fmLines=preg_split('/\r?\n/',$fmTail('/var/log/syslog',262144));$fmLines=array_filter($fmLines,static fn($s)=>preg_match('/\bmover(?:\[|:| )|Filmek Mover/i',$s));$fmLog=implode("\n",array_slice($fmLines,-30));
$fmScriptLog=$fmTail('/tmp/user.scripts/tmpScripts/Filmek_Mover_Threshold/log.txt',8192);
?>
<style>
#fm-monitor{max-width:1160px;margin:24px auto;padding:0 18px;font-size:15px}#fm-monitor h2{font-size:28px;margin:0 0 8px}#fm-monitor .fm-sub{opacity:.7;margin-bottom:24px}#fm-monitor .fm-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:16px}#fm-monitor .fm-card{border:1px solid #7775;border-radius:12px;padding:20px;margin-bottom:18px;background:#88808}#fm-monitor .fm-label{opacity:.7;font-size:13px;margin-bottom:12px}#fm-monitor .fm-value{font-size:25px;line-height:1.4}#fm-monitor progress{width:100%;height:18px;accent-color:#64b99b;margin-top:14px}#fm-monitor pre{white-space:pre-wrap;overflow-wrap:anywhere;max-height:260px;overflow:auto;font-size:12px;line-height:1.6;background:transparent}#fm-monitor table{width:100%;table-layout:fixed}#fm-monitor th,#fm-monitor td{text-align:left;padding:10px 6px;overflow-wrap:anywhere;border-bottom:1px solid #8884}#fm-monitor th:first-child{width:58%}#fm-monitor .fm-note{font-size:13px;opacity:.75;line-height:1.6}#fm-monitor button{margin-bottom:18px;padding:9px 14px}#fm-error{color:#ef967a;min-height:20px}
#fm-monitor .fm-flow{display:flex;align-items:center;justify-content:space-around;gap:12px;border:1px solid #659ed050;background:linear-gradient(110deg,#3996d51a,#64b99b18);border-radius:14px;padding:25px 12px;font-size:18px;font-weight:600}#fm-monitor .fm-flow b{font-size:30px;color:#888}#fm-monitor .fm-flow .fm-moving{color:#f2b84b;animation:fm-pulse 1s infinite alternate}#fm-monitor .fm-grid .fm-card:nth-child(1){border-top:3px solid #64b99b}#fm-monitor .fm-grid .fm-card:nth-child(2){border-top:3px solid #519bce}#fm-monitor .fm-grid .fm-card:nth-child(3){border-top:3px solid #c6a36d}#fm-monitor .fm-donut{width:110px;height:110px;border-radius:50%;display:grid;place-items:center;margin:10px auto;background:conic-gradient(#519bce calc(var(--used)*1%),#7773 0)}#fm-monitor .fm-donut span{display:grid;place-items:center;width:85px;height:85px;background:#20252b;color:#eee;border-radius:50%;font-size:24px}@keyframes fm-pulse{from{opacity:.3}to{opacity:1}}@media(max-width:600px){#fm-monitor .fm-flow{font-size:12px;gap:4px;padding:18px 8px}}@media(prefers-reduced-motion:reduce){#fm-monitor .fm-moving{animation:none!important}}</style>
<div id="fm-monitor" data-running="<?=$fmRun?1:0?>" data-uncertain="<?=$fmRaw&&!$fmRun?1:0?>" data-available="<?=$fmUsed!==null?1:0?>" data-used="<?=$fmUsed??0?>" data-free="<?=$fmFree!==false?$fmGiB($fmFree):'—'?>">
<h2>Mover figyelő</h2><p class="fm-sub">FejesNAS · Élő állapot · Csak megfigyelés</p>
<a href="/Tools/FejesMoverSettings" style="display:inline-block;margin-right:16px;color:#64c7ff">⚙ Beállítások</a><button type="button" id="fm-toggle">Automatikus frissítés: BE (5 mp)</button> <span>Adatok ideje: <?=date('Y-m-d H:i:s')?></span><div id="fm-error" role="status"></div>
<div class="fm-flow"><span>▣ CACHE / SSD</span><b class="<?=$fmRun?'fm-moving':''?>">➜</b><span>⇄ MOVER</span><b class="<?=$fmRun?'fm-moving':''?>">➜</b><span>▤ LEMEZTÖMB</span></div><p class="fm-note">Cache / lemeztömb szemléltetés; a tényleges irány megosztásonként eltérhet · <?=$fmRun?'A mover aktív.':'Jelenleg várakozik.'?></p><div class="fm-grid">
<section class="fm-card"><div class="fm-label">MOVER ÁLLAPOTA</div><div class="fm-value" style="color:<?=$fmRun?'#f2b84b':'#64b99b'?>"><?=$fmRun?'● Mover fut':($fmRaw?'⚠ Nem ellenőrizhető PID':'● Nem fut')?></div><p><?=$fmRun?count($fmIds).' kapcsolódó folyamat · PID '.$fmPid:'Jelenleg nincs igazolt aktív mozgatás.'?></p></section>
<section class="fm-card"><div class="fm-label">CACHE FOGLALTSÁGA</div><div class="fm-donut" style="--used:<?=$fmUsed??0?>"><span><?=$fmUsed!==null?$fmUsed.'%':'—'?></span></div><?php if($fmUsed!==null):?><progress max="100" value="<?=$fmUsed?>"></progress><p><?=$fmGiB($fmTotal-$fmFree)?> / <?=$fmGiB($fmTotal)?> GiB<br>Szabad: <?=$fmGiB($fmFree)?> GiB</p><?php endif?></section>
<section class="fm-card"><div class="fm-label">MEGLÉVŐ SCRIPT INDÍTÁSI KÜSZÖBE</div><div class="fm-value"><?=$fmThreshold!==null?$fmThreshold.' GiB alatt':'Nem olvasható'?></div><p><?=$fmFree!==false&&$fmThreshold!==null?($fmFree/1073741824>=$fmThreshold?'A szabad hely most a küszöb felett van.':'A szabad hely a küszöb alatt van. A script további feltételeket is ellenőriz.'):'A küszöb nem ellenőrizhető.'?></p></section>
</div>
<section class="fm-card"><h3>Éppen megnyitott fájlok</h3>
<?php if($fmFiles):?><table><thead><tr><th>Fájl / hely</th><th>Művelet</th><th>Fájlpozíció / méret</th></tr></thead><tbody><?php foreach($fmFiles as $f):?><tr><td><?=$fmEsc($f['path'])?></td><td><?=(['Olvasás','Írás','Olvasás és írás'][$f['mode']]??'Ismeretlen')?></td><td><?=$fmGiB($f['pos'])?> / <?=$fmGiB($f['size'])?> GiB</td></tr><?php endforeach?></tbody></table><?php else:?><p><?=$fmRun?'A mover fut, de most nincs megfigyelhető nyitott adatfájl. Lehet, hogy keres vagy várakozik.':'Várakozás a következő mover-futásra.'?></p><?php endif?>
<p class="fm-note">A mover és gyermekfolyamatai nyitott fájljainak pillanatképe. A fájlpozíció nem igazolja a mozgatás befejezését. A teljes hátralévő mennyiség, sebesség és befejezési idő ebből az adatforrásból nem állapítható meg megbízhatóan.</p></section>
<section class="fm-card"><h3>Legutóbbi mover-naplóbejegyzések</h3><pre><?=$fmEsc($fmLog?:'A rendszernapló utolsó 256 KiB-os részében nincs mover-bejegyzés. Ez önmagában nem hiba; a korábbi futások vagy a részletes fájlnaplózás nem feltétlenül érhetők el.')?></pre></section>
<?php if($fmScriptLog):?><section class="fm-card"><h3>Filmek Mover · legutóbbi scriptnapló</h3><pre><?=$fmEsc($fmScriptLog)?></pre></section><?php endif?>
<p class="fm-note">A figyelő a folyamatokat, a cache szabad helyét és a meglévő naplókat olvassa. A mozgatást a meglévő Unraid-beállítások és esetleges saját scripted vezérlik. Ez a kiadás cache nevű poolt figyel. Frissítés csak a lap megnyitása közben történik.</p></div>
<script>
(()=>{let enabled=true,busy=false;if(window.fejesMoverTimer)clearInterval(window.fejesMoverTimer);function bind(){const button=document.getElementById('fm-toggle');button.textContent='Automatikus frissítés: '+(enabled?'BE (5 mp)':'SZÜNET');button.onclick=()=>{enabled=!enabled;bind();};}bind();window.fejesMoverTimer=setInterval(async()=>{if(!enabled||busy||document.hidden)return;busy=true;const c=new AbortController(),t=setTimeout(()=>c.abort(),8000);try{const r=await fetch(location.href,{cache:'no-store',credentials:'same-origin',signal:c.signal});if(!r.ok)throw Error();const doc=new DOMParser().parseFromString(await r.text(),'text/html'),part=doc.getElementById('fm-monitor');if(!part)throw Error();document.getElementById('fm-monitor').replaceWith(part);bind();}catch(e){document.getElementById('fm-error').textContent='A frissítés sikertelen. A kijelzett adatok elavultak; ellenőrizd a kapcsolatot vagy a bejelentkezést.';}finally{clearTimeout(t);busy=false;}},5000);})();
</script>


]]></INLINE></FILE>
<FILE Name="/tmp/fejes-mover-monitor-2026.10.17/FejesMoverSettings.page"><INLINE><![CDATA[Menu="Utilities"
Title="Mover beállítások"
Icon="fa-sliders"
Tag="cogs"
---
<?php
$msMounted=(static function(){foreach(explode("\n",@file_get_contents('/proc/self/mountinfo')?:'') as $line){$fields=explode(' ',$line);if(($fields[4]??'')==='/mnt/cache')return true;}return false;})();
$msToken=(parse_ini_file('/var/local/emhttp/var.ini')['csrf_token']??'');
$msPath='/boot/config/plugins/user.scripts/scripts/Filmek_Mover_Threshold/script';
$msEsc=fn($v)=>htmlspecialchars((string)$v,ENT_QUOTES,'UTF-8');
$msSource=@file_get_contents($msPath);
if($msSource===false){
 echo '<div style="max-width:900px;margin:30px auto"><h2>Mover beállítások</h2><p>Ez az opcionális oldal a meglévő Filmek_Mover_Threshold User Scripts automatika paramétereit kezeli. A script nincs telepítve ezen a rendszeren.</p><p>A Mover figyelő ettől függetlenül használható. Ez a bővítmény nem telepít és nem ütemez automatikus mozgatást.</p><a href="/Tools/FejesMover">Vissza a Mover figyelőhöz</a></div>';
 return;
}

$msParse=function($s){$r=[];foreach(['KUSZOB_GIB','UJRA_PROBALKOZAS_MP'] as $k){if(preg_match_all('/^'.preg_quote($k,'/').'=(\d+)[ \t]*$/m',(string)$s,$m)!==1)throw new RuntimeException('A script paraméterei nem egyértelműek.');$r[$k]=(int)$m[1][0];}return $r;};
$msTotal=$msMounted?@disk_total_space('/mnt/cache'):false;$msFree=$msMounted?@disk_free_space('/mnt/cache'):false;$msMax=$msTotal?max(1,(int)floor($msTotal/1073741824)-1):0;
$msMessage='';$msError='';$msValues=['KUSZOB_GIB'=>300,'UJRA_PROBALKOZAS_MP'=>360];$msLock=null;$msTmp=null;
try{
 $msValues=$msParse($msSource);
 if(($_SERVER['REQUEST_METHOD']??'GET')==='POST'){
  if(!is_string($_POST['ms_csrf']??null)||empty($msToken)||!hash_equals($msToken,$_POST['ms_csrf']))throw new RuntimeException('Lejárt munkamenet. Töltsd újra az oldalt.');
  $msNew=[];foreach(['KUSZOB_GIB'=>$msMax,'UJRA_PROBALKOZAS_MP'=>10080] as $k=>$max){$v=$_POST[$k]??null;if(!is_string($v)||!preg_match('/^[1-9][0-9]{0,4}$/D',$v)||(int)$v>$max)throw new RuntimeException('Érvénytelen érték vagy nem elérhető cache.');$msNew[$k]=(int)$v;}
  $msLock=fopen('/var/run/fejes-mover-settings.lock','c');if(!$msLock||!flock($msLock,LOCK_EX|LOCK_NB))throw new RuntimeException('Másik mentés folyamatban.');
  $msSource=file_get_contents($msPath);$msValues=$msParse($msSource);
  if(!is_string($_POST['source_hash']??null)||!hash_equals(hash('sha256',$msSource),$_POST['source_hash']))throw new RuntimeException('A script közben megváltozott. Töltsd újra az oldalt.');
  if($msNew===$msValues){$msMessage='Ellenőrzés sikeres: az értékek már el vannak mentve. Nem történt módosítás.';}
  else{
   if(file_exists('/var/run/mover.pid'))throw new RuntimeException('Futó Mover mellett nem módosíthatók az értékek.');
   $msChanged=$msSource;foreach($msNew as $k=>$v)$msChanged=preg_replace('/^'.preg_quote($k,'/').'=[0-9]+[ \t]*$/m',$k.'='.$v,$msChanged);
   $msDir='/boot/config/plugins/fejes.mover.monitor/backups';if(!is_dir($msDir)&&!mkdir($msDir,0700,true))throw new RuntimeException('Nem hozható létre a mentési mappa.');
   $msBackup=$msDir.'/threshold-'.date('Ymd-His').'-'.bin2hex(random_bytes(3)).'.sh';
   if(file_put_contents($msBackup,$msSource,LOCK_EX)!==strlen($msSource)||file_get_contents($msBackup)!==$msSource)throw new RuntimeException('A biztonsági másolat ellenőrzése sikertelen.');
   $msTmp=tempnam(dirname($msPath),'.mover-');if(!$msTmp||file_put_contents($msTmp,$msChanged)!==strlen($msChanged))throw new RuntimeException('A mentés előkészítése sikertelen.');
   chmod($msTmp,fileperms($msPath)&0777);exec('/bin/bash -n '.escapeshellarg($msTmp).' 2>&1',$msOut,$msCode);if($msCode!==0)throw new RuntimeException('A script ellenőrzése sikertelen.');
   if(file_get_contents($msPath)!==$msSource)throw new RuntimeException('A script közben megváltozott.');
   if(!rename($msTmp,$msPath))throw new RuntimeException('A script cseréje sikertelen.');$msTmp=null;
   if(file_get_contents($msPath)!==$msChanged)throw new RuntimeException('A visszaolvasás sikertelen. Biztonsági másolat: '.$msBackup);
   $msSource=$msChanged;$msValues=$msNew;$msMessage='Sikeresen mentve és visszaellenőrizve. A következő scriptfutás ezeket használja. Biztonsági másolat: '.basename($msBackup);
  }
 }
}catch(Throwable $e){$msError=$e->getMessage();}
finally{if($msTmp&&is_file($msTmp))unlink($msTmp);if(is_resource($msLock)){flock($msLock,LOCK_UN);fclose($msLock);}}
?>
<style>
#ms{max-width:1100px;margin:22px auto;color:#dce8f5;font:15px/1.6 Arial,sans-serif}#ms *{box-sizing:border-box}#ms .hero,#ms .box{background:linear-gradient(130deg,#182738,#101b27);border:1px solid #30465e;border-radius:18px;padding:26px;margin-bottom:20px}#ms .hero{display:flex;justify-content:space-between;align-items:center}#ms h1{font-size:30px;color:#fff;margin:4px 0}#ms h2{font-size:20px;color:#fff;margin:0 0 12px}#ms p{color:#a9bdd0;margin:8px 0}#ms .grid{display:grid;grid-template-columns:1fr 1fr;gap:20px}#ms .kicker{color:#5fc4ff;letter-spacing:2px;font-size:12px}#ms input[type=number]{width:130px;font-size:26px;padding:10px;background:#0c1621;color:#fff;border:1px solid #4b6784;border-radius:10px}#ms input[type=range]{width:100%;accent-color:#58baff;margin:22px 0}#ms .bar{height:20px;border-radius:10px;background:#263c50;position:relative;margin:25px 0 12px;overflow:hidden}#ms .fill{height:100%;background:#399fdf}#ms .marker{position:absolute;top:0;bottom:0;width:4px;background:#ffbc57}#ms .badge{display:inline-block;border:1px solid #328b75;color:#8de1c3;border-radius:20px;padding:5px 12px;margin:5px 8px 5px 0}#ms .notice{padding:16px;border-radius:12px;margin-bottom:20px;background:#153b32;color:#a2f1d1}#ms .error{background:#502a26;color:#ffd0c0}#ms button,#ms .link{display:inline-block;border:1px solid #4c83ae;border-radius:10px;padding:11px 18px;background:#1d6094;color:#fff;text-decoration:none;cursor:pointer;font-size:15px}#ms .secondary{background:transparent;margin-left:10px}#ms .preview{font-size:18px;color:#fff;min-height:58px}#ms small{color:#a9bdd0}@media(max-width:750px){#ms .grid{grid-template-columns:1fr}#ms .hero{display:block}}
</style>
<div id="ms">
 <div class="hero"><div><div class="kicker">FEJESNAS / MOVER SETUP</div><h1>Hangold a működését</h1><p>Filmek automatika · cache → lemeztömb</p></div><a class="link secondary" href="/Tools/FejesMover">← Mover figyelő</a></div>
 <?php if($msMessage):?><div class="notice" role="status"><?=$msEsc($msMessage)?></div><?php endif?>
 <?php if($msError):?><div class="notice error" role="alert"><?=$msEsc($msError)?></div><?php endif?>
 <form method="post" action="/Tools/FejesMoverSettings">
 <input type="hidden" name="csrf_token" value="<?=$msEsc($msToken??'')?>"><input type="hidden" name="ms_csrf" value="<?=$msEsc($msToken)?>"><input type="hidden" name="source_hash" value="<?=hash('sha256',(string)$msSource)?>">
 <div class="grid">
 <div class="box"><h2>01 · Szabadhely-küszöb</h2><p>Ennyi szabad cache-hely alatt próbálja elindítani a beépített Movert.</p><label for="ms-threshold">Küszöb (GiB)</label><br><input id="ms-threshold" name="KUSZOB_GIB" type="number" min="1" max="<?=$msMax?>" required value="<?=$msValues['KUSZOB_GIB']?>"><input id="ms-slider" aria-label="Szabadhely-küszöb csúszka" type="range" min="1" max="<?=$msMax?>" value="<?=$msValues['KUSZOB_GIB']?>"><small>Nagyobb érték: hamarabb indulhat. Kisebb érték: tovább maradnak a fájlok a cache-en.</small></div>
 <div class="box"><h2>02 · Újrapróbálkozási idő</h2><p>Legalább ennyi idő teljen el két indítási próbálkozás között.</p><label for="ms-cooldown">Várakozás (perc)</label><br><input id="ms-cooldown" name="UJRA_PROBALKOZAS_MP" type="number" min="1" max="10080" required value="<?=$msValues['UJRA_PROBALKOZAS_MP']?>"><p id="ms-hours"></p><small>A script ellenőrzési ütemezése külön kezeli, mikor kerül sor a következő próbára.</small></div>
 </div>
 <div class="box"><h2>Élő beállítási előnézet</h2><p>Most szabad: <strong><?= $msFree!==false?number_format($msFree/1073741824,1,',',' '):'—'?> GiB</strong> · Cache kapacitás: <?= $msTotal?number_format($msTotal/1073741824,1,',',' '):'—'?> GiB</p><div class="bar"><div class="fill" style="width:<?=$msTotal&&$msFree!==false?100*(1-$msFree/$msTotal):0?>%"></div><div class="marker" id="ms-marker"></div></div><small>Kék: jelenlegi foglaltság · Sárga jel: a beállított indítási küszöb</small><p class="preview" id="ms-preview"></p></div>
 <div class="box"><h2>A meglévő automatika ellenőrzései</h2><p>A backup- és paritásvédelmet a saját scripted valósítja meg; ezt a beállítóoldal nem tudja igazolni. Mentéskor a Mover PID-fájlját ellenőrzi.</p><p>A mentés nem indít Movert. Az új értékeket a következő scriptfutás használja; minden módosítás előtt biztonsági másolat készül.</p><button type="submit">Beállítások mentése</button><button type="reset" class="secondary">Szerkesztés visszavonása</button><p><small>Ütemezés módosítása: a meglévő User Scripts oldalon.</small></p></div>
 </form>
</div>
<script>
(()=>{const t=document.getElementById('ms-threshold'),s=document.getElementById('ms-slider'),c=document.getElementById('ms-cooldown'),free=<?=json_encode($msFree!==false?$msFree/1073741824:null)?>,total=<?=json_encode($msTotal?$msTotal/1073741824:null)?>;function preview(){document.getElementById('ms-hours').textContent=(Number(c.value)/60).toLocaleString('hu-HU',{maximumFractionDigits:2})+' óra';document.getElementById('ms-marker').style.left=Math.max(0,Math.min(100,100*(1-Number(t.value)/total)))+'%';document.getElementById('ms-preview').textContent=free===null?'A cache adatai most nem érhetők el.':free<Number(t.value)?'A szabad hely már a küszöb alatt van. A következő ellenőrzés a védelmek és a várakozás alapján dönt az indításról.':'Még '+(free-Number(t.value)).toLocaleString('hu-HU',{maximumFractionDigits:1})+' GiB szabad hely fogyhat el a küszöbig.';}t.addEventListener('input',()=>{s.value=t.value;preview()});s.addEventListener('input',()=>{t.value=s.value;preview()});c.addEventListener('input',preview);t.form.addEventListener('reset',()=>setTimeout(preview,0));preview();})();
</script>


]]></INLINE></FILE>
<FILE Run="/bin/bash"><INLINE><![CDATA[#!/bin/bash
set -euo pipefail
src=/tmp/fejes-mover-monitor-2026.10.17
dst=/usr/local/emhttp/plugins/fejes.mover.monitor
for name in FejesMover.Dashboard.page FejesMover.page FejesMoverSettings.page; do
  php -l "$src/$name" >/dev/null
 done
install -d -m 0755 "$dst"
for name in FejesMover.Dashboard.page FejesMover.page FejesMoverSettings.page; do
  install -m 0644 "$src/$name" "$dst/$name"
 done
printf '%s\n' 'Fejes Mover Monitor installed. Open Tools / Mover figyelo.'
]]></INLINE></FILE>
<FILE Run="/bin/bash" Method="remove"><INLINE><![CDATA[#!/bin/bash
set -euo pipefail
dst=/usr/local/emhttp/plugins/fejes.mover.monitor
# Remove only runtime files owned by this plugin. Preserve settings and backups.
for name in FejesMover.page FejesMover.Dashboard.page FejesMoverSettings.page; do
  rm -f -- "$dst/$name"
done
rmdir "$dst" 2>/dev/null || true
printf '%s\n' 'Fejes Mover Monitor removed; local configuration and backups preserved.'
]]></INLINE></FILE>
</PLUGIN>
