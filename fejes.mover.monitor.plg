   if(file_put_contents($msBackup,$msSource,LOCK_EX)!==strlen($msSource)||file_get_contents($msBackup)!==$msSource)throw new RuntimeException('Backup verification failed.');
   $msTmp=tempnam(dirname($msPath),'.mover-');if(!$msTmp||file_put_contents($msTmp,$msChanged)!==strlen($msChanged))throw new RuntimeException('Unable to prepare the save.');
