<FILE Name="/tmp/fejes-mover-monitor-2026.10.25.4/torrent_preflight.py"><INLINE><![CDATA[#!/usr/bin/env python3
"""Read-only, conservative qBittorrent gate for an external Mover launcher."""
import argparse
import json
import math
import posixpath
import subprocess
import sys

READY = 0
DEFER = 10
UNAVAILABLE = 20
SEED_STATES = {"uploading", "stalledUP", "queuedUP", "forcedUP", "stoppedUP", "pausedUP"}
BUSY_STATES = {
    "allocating", "checkingDL", "checkingUP", "checkingResumeData", "moving",
    "downloading", "stalledDL", "queuedDL", "forcedDL", "stoppedDL", "pausedDL",
    "metaDL", "forcedMetaDL",
}


def absolute_path(value):
    if (not isinstance(value, str) or not value.startswith("/")
            or "\x00" in value or ".." in value.split("/")):
        raise ValueError("Missing or invalid content/mount path")
    return posixpath.normpath(value)


def host_path(path, mounts):
    path = absolute_path(path)
    matches = []
    for mount in mounts:
        if mount.get("Type") != "bind":
            continue
        dest = absolute_path(mount.get("Destination"))
        source = absolute_path(mount.get("Source"))
        if path == dest or path.startswith(dest.rstrip("/") + "/"):
            matches.append((len(dest), source, posixpath.relpath(path, dest)))
    if not matches:
        raise ValueError("Unfinished content has no known host bind mount")
    _, source, suffix = max(matches)
    return posixpath.normpath(posixpath.join(source, suffix))


def assess(torrents, mounts):
    if not isinstance(torrents, list) or not torrents:
        raise ValueError("Torrent snapshot is empty or invalid")
    if not isinstance(mounts, list):
        raise ValueError("Mount snapshot is invalid")
    protected = set()
    busy = 0
    for torrent in torrents:
        if not isinstance(torrent, dict):
            raise ValueError("Invalid torrent entry")
        progress, state = torrent.get("progress"), torrent.get("state")
        if (isinstance(progress, bool) or not isinstance(progress, (int, float))
                or not math.isfinite(progress) or not 0 <= progress <= 1):
            raise ValueError("Missing or invalid torrent progress")
        if not isinstance(state, str) or state not in SEED_STATES | BUSY_STATES:
            raise ValueError("Unknown, errored or unavailable torrent state")
        if progress < 1 or state in BUSY_STATES:
            busy += 1
            protected.add(host_path(torrent.get("content_path"), mounts))
    return {
        "exit_code": DEFER if busy else READY,
        "decision": "defer" if busy else "no_torrent_blocker",
        "checked_torrents": len(torrents),
        "blocking_torrents": busy,
        "protected_paths": sorted(protected),
    }


def read_snapshot(container, timeout):
    # No shell, credentials, API mutation or direct torrent-state database access.
    inspect = subprocess.run(
        ["docker", "inspect", "--format", "{{json .Mounts}}", container],
        capture_output=True, text=True, check=True, timeout=timeout)
    snapshot = subprocess.run(
        ["docker", "exec", container, "curl", "--fail", "--silent", "--show-error",
         "--connect-timeout", str(timeout), "--max-time", str(timeout),
         "http://127.0.0.1:8080/api/v2/torrents/info"],
        capture_output=True, text=True, check=True, timeout=timeout + 2)
    return json.loads(snapshot.stdout), json.loads(inspect.stdout)


def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--container", default="binhex-qbittorrentvpn")
    parser.add_argument("--timeout", type=int, default=5)
    parser.add_argument("--json", action="store_true", help="Include private host paths in JSON")
    args = parser.parse_args(argv)
    if args.timeout < 1 or args.timeout > 30:
        parser.error("timeout must be between 1 and 30 seconds")
    if not args.container or args.container.startswith("-"):
        parser.error("invalid container name")
    try:
        torrents, mounts = read_snapshot(args.container, args.timeout)
        result = assess(torrents, mounts)
    except (ValueError, TypeError, AttributeError, KeyError, OSError,
            subprocess.SubprocessError):
        # Do not echo subprocess output: tracker credentials may occur in API data.
        result = {"exit_code": UNAVAILABLE, "decision": "unavailable",
                  "reason": "Cannot verify qBittorrent state or host paths; defer Mover"}
    if args.json:
        print(json.dumps(result, ensure_ascii=False))
    elif result["exit_code"] == READY:
        print("No torrent blocker found; other Mover safeguards still apply.")
    elif result["exit_code"] == DEFER:
        print(f"Defer Mover: {result['blocking_torrents']} unfinished or busy torrent(s).")
    else:
        print(result["reason"])
    return result["exit_code"]


if __name__ == "__main__":
    sys.exit(main())
]]></INLINE></FILE>
<FILE Name="/tmp/fejes-mover-monitor-2026.10.25.4/integrity_preflight.py"><INLINE><![CDATA[#!/usr/bin/env python3
"""Run an existing generated Bunker schedule with live torrent exclusions."""
import argparse
import pathlib
import re
import shlex
import subprocess
import sys

from torrent_preflight import assess, read_snapshot

TOKEN = "/usr/local/emhttp/plugins/dynamix.file.integrity/scripts/bunker -Vqj "
MARKER = "# This is an auto-generated file, do not change manually!"
MEDIA_ROOT = re.compile(r"^/mnt/(?:user|user0|disk[0-9]+)/")


def folder_pattern(name):
    # Bunker interpolates -F entries into a sed ERE with / delimiters and comma IFS.
    # Accept only the plain basenames supported by this integration, not patterns.
    if not name or not re.fullmatch(r"[A-Za-z0-9._+ -]+", name):
        raise ValueError("Folder exclusion cannot safely be represented")
    return re.escape(name).replace(r"\ ", " ")


def config_exclusions(source):
    result = {}
    for key in ("exclude", "folders", "files"):
        values = re.findall(r'^' + key + r'="([^"\n]*)"\s*$', source, re.M)
        if len(values) != 1:
            raise ValueError("Missing or ambiguous exclusion configuration")
        result[key] = values[0]
    if result["files"]:
        raise ValueError("Custom file masks need separate integration review")
    return result


def prepare_script(source, config, protected_paths, is_dir):
    if MARKER not in source or not source.startswith("#!/bin/bash\n"):
        raise ValueError("Not the reviewed generated schedule format")
    count = source.count(TOKEN)
    if count < 1 or count > 64:
        raise ValueError("Cannot locate Bunker schedule invocations")
    # Accept only full-disk scheduled verify commands. Any changed format defers.
    for line in source.splitlines():
        if "bunker" in line:
            if (line.count(TOKEN) != 1 or not line.startswith("[[ ")
                    or not re.search(r" /mnt/disk[0-9]+ >/dev/null &$", line)
                    or re.search(r"(?:^|\s)-(?:E|F)(?:\s|$)", line)):
                raise ValueError("Unreviewed Bunker invocation format")
    settings = config_exclusions(config)
    folders = set(filter(None, settings["folders"].split(",")))
    for path in protected_paths:
        if not MEDIA_ROOT.match(path) or not is_dir(path):
            raise ValueError("Unfinished content is not a known array/user directory")
        folders.add(pathlib.PurePosixPath(path).name)
    args = []
    if folders:
        args += ["-F", ",".join(folder_pattern(f) for f in sorted(folders))]
    shares = list(filter(None, settings["exclude"].split(",")))
    if shares:
        args += ["-E", ",".join(folder_pattern(s) for s in shares)]
    if args:
        source = source.replace(TOKEN, TOKEN + shlex.join(args) + " ")
    return source, len(folders)


def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--container", default="binhex-qbittorrentvpn")
    parser.add_argument("--config", default="/boot/config/plugins/dynamix.file.integrity/dynamix.file.integrity.cfg")
    parser.add_argument("--script", default="/boot/config/plugins/dynamix.file.integrity/integrity-check.sh")
    parser.add_argument("--check-only", action="store_true")
    args = parser.parse_args(argv)
    if not args.container or args.container.startswith("-"):
        parser.error("invalid container name")
    try:
        torrents, mounts = read_snapshot(args.container, 5)
        decision = assess(torrents, mounts)
        script, count = prepare_script(
            pathlib.Path(args.script).read_text(), pathlib.Path(args.config).read_text(),
            decision["protected_paths"], lambda p: pathlib.Path(p).is_dir())
        subprocess.run(["bash", "-n"], input=script, text=True,
                       capture_output=True, check=True, timeout=5)
    except (ValueError, TypeError, AttributeError, KeyError, OSError, subprocess.SubprocessError):
        print("File Integrity deferred: torrent state, exclusions or schedule cannot be verified.")
        return 20
    print(f"File Integrity preflight: {count} folder exclusion(s).", flush=True)
    if args.check_only:
        print("Check only; no hashing or configuration change performed.")
        return 0
    # Original parity guard, disk rotation, nice/ionice and notifications are retained.
    # No /Items DELETE, torrent API writes, checksum updates or source-file edits.
    try:
        return subprocess.run(["bash"], input=script, text=True).returncode
    except OSError:
        print("File Integrity schedule could not be started.")
        return 20


if __name__ == "__main__":
    sys.exit(main())
]]></INLINE></FILE>
<FILE Name="/tmp/fejes-mover-monitor-2026.10.25.4/wire_integrity_cron.py"><INLINE><![CDATA[#!/usr/bin/env python3
"""Route the existing File Integrity cron job through its reviewed preflight."""
import argparse
import datetime
import fcntl
import os
import pathlib
import shutil
import subprocess
import sys
import tempfile

ROOT = pathlib.Path("/boot/config/plugins/dynamix.file.integrity")
GUARD = pathlib.Path("/boot/config/plugins/fejes.mover.monitor/tools/integrity_preflight.py")
ORIGINAL = "bash /boot/config/plugins/dynamix.file.integrity/integrity-check.sh"
REPLACEMENT = "python3 " + str(GUARD)
LOCK = '/var/run/fejes-integrity-cron.lock'


def rewrite_cron(source):
    lines = [line for line in source.splitlines() if line.strip() and not line.lstrip().startswith("#")]
    if len(lines) != 1:
        raise ValueError("Expected exactly one existing scheduled job")
    line = lines[0]
    fields = line.split(None, 5)
    if len(fields) != 6:
        raise ValueError("Unrecognized cron format")
    command = fields[5]
    if command == REPLACEMENT + " &> /dev/null":
        return source
    if command != ORIGINAL + " &> /dev/null":
        raise ValueError("Unrecognized File Integrity command")
    return source.replace(line, line.replace(ORIGINAL, REPLACEMENT, 1), 1)


def atomic_write(path, text, mode):
    fd, temp = tempfile.mkstemp(prefix=".integrity-cron-", dir=path.parent)
    try:
        with os.fdopen(fd, "w") as out:
            out.write(text)
            out.flush()
            os.fsync(out.fileno())
        os.chmod(temp, mode)
        os.replace(temp, path)
    finally:
        if os.path.exists(temp):
            os.unlink(temp)


def reload_cron():
    # Unraid versions may ship this script without a valid #! interpreter line.
    subprocess.run(["bash", "/usr/local/sbin/update_cron"], check=True)


def main(remove=False):
    cron = ROOT / "integrity-check.cron"
    if remove and not cron.exists():
        return 0
    with open(LOCK, "w") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        source = cron.read_text()
        if remove:
            if REPLACEMENT not in source:
                return 0
            if rewrite_cron(source) != source:
                raise ValueError("Unrecognized integrated cron")
            changed = source.replace(REPLACEMENT, ORIGINAL)
        else:
            changed = rewrite_cron(source)
        if not remove and (not GUARD.is_file() or not GUARD.with_name("torrent_preflight.py").is_file()):
            raise ValueError("Preflight tools are not installed")
        if not remove:
            subprocess.run(["python3", str(GUARD), "--check-only"], check=True)
        if source == changed:
            reload_cron()
            print("Existing cron job already uses the preflight; system cron reloaded.")
            return 0
        # Do not use .cron suffix for backups: Unraid must not schedule backups.
        backup = ROOT / ("integrity-cron-before-" + datetime.datetime.now().strftime("%Y%m%d-%H%M%S-%f") + ".txt")
        shutil.copy2(cron, backup)
        if cron.read_text() != source:
            raise ValueError("Cron configuration changed during preparation")
        mode = cron.stat().st_mode & 0o777
        atomic_write(cron, changed, mode)
        try:
            reload_cron()
        except (OSError, subprocess.SubprocessError):
            atomic_write(cron, source, mode)
            reload_cron()
            raise
        print("Original File Integrity schedule restored." if remove else
              "Existing File Integrity schedule now uses the preflight.")
        print("Backup:", backup)
        print("No hashing started. A later plugin settings save can regenerate this cron; recheck/reapply then.")
    return 0


if __name__ == "__main__":
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--remove', action='store_true', help='Restore original schedule without API checks')
    args = parser.parse_args()
    try:
        sys.exit(main(remove=args.remove))
    except (ValueError, OSError, subprocess.SubprocessError) as exc:
        print("Cron integration did not complete:", type(exc).__name__,
              "errno=" + str(getattr(exc, "errno", None)))
        sys.exit(20)
]]></INLINE></FILE>
<FILE Name="/tmp/fejes-mover-monitor-2026.10.25.4/fejes_service.py"><INLINE><![CDATA[#!/usr/bin/env python3
"""Shared read-only diagnostics and an opt-in guarded legacy Mover launcher."""
import argparse
import fcntl
import json
import os
import re
import time
from pathlib import Path
import shutil
import subprocess
import sys

from torrent_preflight import assess, read_snapshot
from wire_integrity_cron import ORIGINAL, REPLACEMENT, rewrite_cron
from wire_mover_gate import rewrite_launcher

ROOT = Path('/boot/config/plugins/dynamix.file.integrity')
LAUNCHER = Path('/boot/config/plugins/user.scripts/scripts/Filmek_Mover_Threshold/script')
CACHE = '/mnt/cache'
LOCK = '/var/run/fejes-mover-launch.lock'
ERRORS = (ValueError, TypeError, KeyError, AttributeError, OSError, subprocess.SubprocessError)
BACKUP_MARKER = Path('/tmp/appdata.backup/running')
MDSTAT = Path('/proc/mdstat')
ATTEMPT = Path('/var/run/filmek_mover_last_attempt')
MOVER_PID = Path('/var/run/mover.pid')
SHARE = Path('/mnt/user/Filmek')


def dry_run(container='binhex-qbittorrentvpn', include_items=False):
    """Read-only decision snapshot. Never execute a launcher or write a timestamp."""
    report = status(container, include_items=include_items)
    checks = []
    def add(key, state, detail=''):
        checks.append({'key': key, 'state': state, 'detail': detail})
    threshold = wait = None
    try:
        if LAUNCHER.is_symlink():
            raise ValueError('Symlink')
        source = LAUNCHER.read_text()
        rewrite_launcher(source)  # Reject drift; known guards only.
        if not SHARE.is_dir():
            raise ValueError('Required share unavailable')
        threshold = int(re.search(r'^KUSZOB_GIB=([0-9]+)$', source, re.M)[1])
        wait = int(re.search(r'^UJRA_PROBALKOZAS_MP=([0-9]+)$', source, re.M)[1])
        add('launcher', 'pass')
    except (IndexError, *ERRORS):
        add('launcher', 'unknown')
    free = report.get('cache_free_bytes')
    if report.get('cache') != 'available' or type(free) is not int or threshold is None:
        add('capacity', 'unknown')
    else:
        add('capacity', 'pass' if free < threshold*1024**3 else 'wait',
            {'free_gib': round(free/1024**3, 1), 'threshold_gib': threshold})
    decision = report.get('torrent')
    add('torrent', 'pass' if decision == 'no_torrent_blocker' else
        'wait' if decision == 'defer' else 'unknown', report.get('blocking_torrents'))
    try:
        if BACKUP_MARKER.exists():
            raw = BACKUP_MARKER.read_text().strip()
            if not raw.isdigit() or int(raw) <= 1:
                raise ValueError('Invalid backup PID')
            try:
                os.kill(int(raw), 0)
                add('backup', 'wait')
            except ProcessLookupError:
                add('backup', 'pass')
        else:
            add('backup', 'pass')
    except ERRORS:
        add('backup', 'unknown')
    try:
        values = re.findall(r'^mdResync=([0-9]+)$', MDSTAT.read_text(), re.M)
        if len(values) != 1:
            raise ValueError('Parity status missing')
        add('parity', 'pass' if int(values[0]) == 0 else 'wait')
    except ERRORS:
        add('parity', 'unknown')
    add('mover', 'wait' if MOVER_PID.exists() else 'pass')
    try:
        if wait is None:
            raise ValueError('Retry interval unknown')
        if ATTEMPT.exists():
            raw = ATTEMPT.read_text().strip()
            if not raw.isdigit():
                raise ValueError('Invalid timestamp')
            remaining = max(0, int(raw)+wait*60-int(time.time()))
            add('cooldown', 'wait' if remaining else 'pass', {'remaining_seconds': remaining})
        else:
            add('cooldown', 'pass', {'remaining_seconds': 0})
    except ERRORS:
        add('cooldown', 'unknown')
    states = {c['state'] for c in checks}
    report['dry_run'] = {'decision': 'unknown' if 'unknown' in states else
                         'wait' if 'wait' in states else 'ready',
                         'checks': checks, 'read_only': True}
    return report


def capacity(torrents, free, reserve):
    """All unfinished bytes are an upper bound, including array-backed downloads."""
    remaining = 0
    for item in torrents:
        value = item.get('amount_left')
        if isinstance(value, bool) or not isinstance(value, int) or value < 0:
            return {'remaining_upper_bound_bytes': None, 'pressure': 'unknown'}
        remaining += value
    return {'remaining_upper_bound_bytes': remaining,
            'pressure': 'warning' if free < remaining + reserve else 'ok'}


def cron_state(source):
    try:
        expected = rewrite_cron(source)
    except ValueError:
        return 'unknown'
    return 'wired' if source == expected else 'original'


def status(container='binhex-qbittorrentvpn', reserve_gib=20, include_items=False):
    result = {'torrent': 'unavailable', 'cache': 'unavailable',
              'integrity_config': 'unknown', 'integrity_active': 'unknown',
              'legacy_launcher_present': LAUNCHER.is_file(),
              'mover_gate': 'manual_integration_required'}
    try:
        launcher = LAUNCHER.read_text()
        result['mover_gate'] = 'wired' if rewrite_launcher(launcher) == launcher else 'original'
    except ERRORS:
        result['mover_gate'] = 'unknown'
    # Default reports contain no media filenames or paths. The authenticated
    # dry-run UI can explicitly request basenames only; never trackers or paths.
    try:
        configured = (ROOT / 'integrity-check.cron').read_text()
        result['integrity_config'] = cron_state(configured)
        active = Path('/etc/cron.d/root').read_text()
        jobs = [line.split(None, 5) for line in active.splitlines()
                if line.strip() and not line.lstrip().startswith('#')]
        wanted = [line.split(None, 5) for line in configured.splitlines()
                  if line.strip() and not line.lstrip().startswith('#')]
        related = [job for job in jobs if len(job) == 6 and
                   (REPLACEMENT in job[5] or ORIGINAL in job[5])]
        result['integrity_active'] = ('wired' if result['integrity_config'] == 'wired'
                                      and related == wanted else 'not_verified')
    except OSError:
        pass
    snapshot = None
    try:
        torrents, mounts = read_snapshot(container, 5)
        decision = assess(torrents, mounts)
        snapshot = torrents
        result.update(torrent=decision['decision'],
                      checked_torrents=decision['checked_torrents'],
                      blocking_torrents=decision['blocking_torrents'])
        if include_items:
            paths=decision['protected_paths']
            result['protected_items']=[{'name':Path(p).name,
                'kind':'folder' if Path(p).is_dir() else 'file' if Path(p).is_file() else 'unknown'}
                for p in paths[:25]]
            result['protected_items_total']=len(paths)
    except ERRORS:
        pass
    try:
        if not os.path.ismount(CACHE):
            raise ValueError('Cache is not mounted')
        usage = shutil.disk_usage(CACHE)
        result.update(cache='available', cache_free_bytes=usage.free,
                      cache_total_bytes=usage.total, reserve_gib=reserve_gib)
        if snapshot is not None:
            result.update(capacity(snapshot, usage.free, reserve_gib * 1024**3))
    except ERRORS:
        pass
    return result


def run_mover(container):
    # Only this opt-in entry point starts the pre-existing automation. Its own
    # backup/parity/threshold/cooldown checks and timestamp writes remain intact.
    # No cron or User Scripts file is rewritten here.
    try:
        with open(LOCK, 'w') as lock:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
            report = status(container)
            if (report['cache'] != 'available' or report['torrent'] == 'unavailable'
                    or not LAUNCHER.is_file() or LAUNCHER.is_symlink()):
                print('Mover deferred: required state or legacy launcher unavailable.')
                return 20
            if report['torrent'] != 'no_torrent_blocker':
                print('Mover deferred: unfinished or busy torrents. Cache pressure: ' +
                      report.get('pressure', 'unknown') + '.')
                return 10
            if Path('/var/run/mover.pid').exists():
                print('Mover deferred: Mover PID file is present.')
                return 10
            subprocess.run(['bash', '-n', str(LAUNCHER)], check=True,
                           capture_output=True, timeout=5)
            # Reject accidental recursion if this wrapper was copied into the
            # legacy script. The original script must remain at LAUNCHER.
            if any(marker in LAUNCHER.read_text() for marker in ('fejes_service.py', 'BEGIN FEJES MOVER LOCK')):
                raise ValueError('Recursive launcher')
            return subprocess.run(['bash', str(LAUNCHER)]).returncode
    except BlockingIOError:
        print('Mover deferred: another guarded launch is active.')
        return 10
    except ERRORS:
        print('Mover deferred: launch could not be verified.')
        return 20


def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('action', choices=['status', 'dry-run', 'run-mover'])
    parser.add_argument('--container', default='binhex-qbittorrentvpn')
    parser.add_argument('--include-items', action='store_true', help='Private UI: include protected file/folder basenames in dry-run output only')
    args = parser.parse_args(argv)
    if not args.container or args.container.startswith('-'):
        parser.error('Invalid container name')
    if args.include_items and args.action!='dry-run':
        parser.error('--include-items is only supported for a private dry-run preview')
    if args.action == 'run-mover':
        return run_mover(args.container)
    print(json.dumps(dry_run(args.container, args.include_items) if args.action == 'dry-run' else status(args.container), allow_nan=False))
    return 0


if __name__ == '__main__':
    sys.exit(main())
]]></INLINE></FILE>
<FILE Name="/tmp/fejes-mover-monitor-2026.10.25.4/wire_mover_gate.py"><INLINE><![CDATA[#!/usr/bin/env python3
"""Add an opt-in torrent gate to the reviewed legacy threshold script."""
import argparse
import datetime
import fcntl
import hashlib
import os
from pathlib import Path
import re
import shutil
import subprocess
import sys

from torrent_preflight import assess, read_snapshot
from wire_integrity_cron import atomic_write

LAUNCHER = Path('/boot/config/plugins/user.scripts/scripts/Filmek_Mover_Threshold/script')
BACKUPS = Path('/boot/config/plugins/fejes.mover.monitor/backups')
LOCK = '/var/run/fejes-mover-launch.lock'
SETTINGS_LOCK = '/var/run/fejes-mover-settings.lock'
GUARD = Path('/boot/config/plugins/fejes.mover.monitor/tools/torrent_preflight.py')
BASE_HASH = '111a0e8afd56149f3fc9ab153f1e6c5f726bf84e3e0f2dbf6becd62e871df9e3'
START = '[[ -d "$POOL" ]]'
STAMP = '''printf '%s\\n' "$MOST" > "$ALLAPOT"'''
LOCK_BLOCK = '''# BEGIN FEJES MOVER LOCK v1
exec 9>/var/run/fejes-mover-launch.lock
if ! flock -n 9; then
    log "Masik vedett Mover-inditas fut | Mover halasztva"
    exit 0
fi
python3 -c 'import os,sys; sys.exit(0 if os.path.ismount(sys.argv[1]) else 1)' "$POOL" || hiba "A cache pool nincs felcsatolva"
# END FEJES MOVER LOCK v1

'''
GATE_BLOCK = '''# BEGIN FEJES MOVER TORRENT GATE v1
if python3 /boot/config/plugins/fejes.mover.monitor/tools/torrent_preflight.py; then
    :
else
    log "Torrentellenorzes halasztast kert | Mover nem indul | Varakozasi idobelyeg valtozatlan"
    exit 0
fi
# END FEJES MOVER TORRENT GATE v1

'''

DISPATCH_BLOCK = '''# BEGIN FEJES SELECTIVE DISPATCH v1
# The age-filtered executor owns the same maintenance/launch locks.
exec python3 /boot/config/plugins/fejes.mover.monitor/tools/selective_mover.py run
# END FEJES SELECTIVE DISPATCH v1

'''


def rewrite_launcher(source, remove=False):
    selective = source.count(DISPATCH_BLOCK) == 1
    if selective:
        if remove:
            raise ValueError('Selective dispatch must be explicitly restored before removing legacy guards')
        source = source.replace(DISPATCH_BLOCK, '', 1)
    has_blocks = LOCK_BLOCK in source and GATE_BLOCK in source
    original = source.replace(LOCK_BLOCK, '', 1).replace(GATE_BLOCK, '', 1) if has_blocks else source
    normalized = re.sub(r'^(KUSZOB_GIB|UJRA_PROBALKOZAS_MP)=[0-9]+$', r'\1=VALUE', original, flags=re.M)
    if hashlib.sha256(normalized.encode()).hexdigest() != BASE_HASH:
        raise ValueError('Launcher differs from the reviewed format')
    expected = original.replace(START, LOCK_BLOCK + START, 1).replace(STAMP, GATE_BLOCK + STAMP, 1)
    if has_blocks and source != expected:
        raise ValueError('Gate placement differs from reviewed format')
    if selective:
        expected = expected.replace(LOCK_BLOCK, DISPATCH_BLOCK + LOCK_BLOCK, 1)
    return original if remove else expected


def check_environment():
    if not GUARD.is_file() or shutil.which('flock') is None or not os.path.ismount('/mnt/cache'):
        raise ValueError('Guard, lock utility or mounted cache unavailable')
    torrents, mounts = read_snapshot('binhex-qbittorrentvpn', 5)
    result = assess(torrents, mounts)
    values = [t.get('amount_left') for t in torrents]
    if not all(type(n) is int and n >= 0 for n in values):
        raise ValueError('Remaining download size unavailable')
    if shutil.disk_usage('/mnt/cache').free < sum(values) + 20 * 1024**3:
        raise ValueError('Insufficient conservative download headroom')
    # Also run the exact installed guard, not only this downloaded module.
    probe = subprocess.run(['python3', str(GUARD)], capture_output=True, text=True, timeout=20)
    if probe.returncode not in (0, 10):
        raise ValueError('Installed guard could not verify torrents')
    print('Blocking torrents:', result['blocking_torrents'])


def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__)
    group = parser.add_mutually_exclusive_group()
    group.add_argument('--apply', action='store_true')
    group.add_argument('--remove', action='store_true')
    args = parser.parse_args(argv)
    if args.remove and not LAUNCHER.exists():
        return 0
    # Same locks as the legacy settings editor and the installed guarded launch.
    with open(SETTINGS_LOCK, 'w') as settings, open(LOCK, 'w') as launch:
        for lock in (settings, launch):
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        if LAUNCHER.is_symlink():
            raise ValueError('Launcher is a symlink')
        source = LAUNCHER.read_text()
        if args.remove and 'FEJES MOVER' not in source:
            return 0
        changed = rewrite_launcher(source, remove=args.remove)
        subprocess.run(['bash', '-n'], input=changed, text=True, check=True, capture_output=True, timeout=5)
        if not args.remove:
            check_environment()
        if not args.apply and not args.remove:
            print('Check only: reviewed launcher and capacity verified. No changes or Mover start.')
            return 0
        if source == changed:
            print('Launcher already has the requested integration. No Mover started.')
            return 0
        if Path('/var/run/mover.pid').exists():
            raise ValueError('Mover PID file is present')
        BACKUPS.mkdir(parents=True, exist_ok=True)
        backup = BACKUPS / ('mover-gate-before-' + datetime.datetime.now().strftime('%Y%m%d-%H%M%S-%f') + '.txt')
        shutil.copy2(LAUNCHER, backup)
        if backup.read_text() != source or LAUNCHER.read_text() != source:
            raise ValueError('Launcher changed during preparation')
        atomic_write(LAUNCHER, changed, LAUNCHER.stat().st_mode & 0o777)
        print('Mover gate removed.' if args.remove else 'Mover gate installed in the existing launcher.')
        print('Backup:', backup)
        print('No schedule changed. No Mover started.')
    return 0


if __name__ == '__main__':
    try:
        sys.exit(main())
    except (ValueError, OSError, subprocess.SubprocessError) as exc:
        print('Mover wiring did not complete:', type(exc).__name__)
        sys.exit(20)
]]></INLINE></FILE>
<FILE Name="/tmp/fejes-mover-monitor-2026.10.25.4/selection_policy.py"><INLINE><![CDATA[#!/usr/bin/env python3
"""Pure selection policy; never authorizes or executes a live move.

Inputs must be collected by a trusted host adapter. Files and torrent content
paths must use one canonical host namespace (not mixed /mnt/user and disk paths).
"""
import math
from torrent_preflight import absolute_path, host_path, assess

AGE_OPTIONS = (1, 7, 14, 30)
DEFAULT_AGE_DAYS = 7
QUIET_STATES = {'stalledUP', 'queuedUP', 'stoppedUP', 'pausedUP'}
REQUIRED_GUARDS = ('backup', 'parity', 'integrity', 'mount', 'mover',
                   'cooldown', 'capacity', 'open_files', 'namespace')


def age_days(value):
    if type(value) is not int or value not in AGE_OPTIONS:
        raise ValueError('Age must be 1, 7, 14 or 30 days')
    return value


def timestamp(value):
    if type(value) not in (int, float) or not math.isfinite(value) or value < 0:
        raise ValueError('Unverifiable timestamp')
    return value


def within(path, parent):
    return path == parent or path.startswith(parent.rstrip('/') + '/')


def batch_bytes(value=16):
    if type(value) is not int or value not in (16, 32, 64, 128):
        raise ValueError('Batch size must be 16, 32, 64 or 128 GiB')
    return value * 1024**3


def ratio_target(value):
    if type(value) not in (int, float) or not math.isfinite(value) or not 0 <= value <= 100:
        raise ValueError('Ratio target must be between 0 and 100')
    return float(value)


def content_ratio(key, torrents, mounts):
    """Minimum across all owners; missing/invalid values remain unknown."""
    related = [t for t in torrents if within(key, host_path(t.get('content_path'), mounts))
               or within(host_path(t.get('content_path'), mounts), key)]
    if not related:
        return None
    values = [t.get('ratio') for t in related]
    if any(type(v) not in (int, float) or not math.isfinite(v) or v < 0 for v in values):
        return None
    return min(values)


def prioritize(candidates, torrents, mounts, target=0, sizes=None):
    """Order eligible files: ratio band first, then larger files if size is known.

    The size map never grants eligibility or changes the byte/file limits.
    Callers without a size map retain the former deterministic ordering.
    """
    target = ratio_target(target)
    if sizes is not None:
        for key in candidates:
            if key not in sizes or type(sizes[key]) is not int or sizes[key] < 0:
                raise ValueError('Candidate size unavailable')
    def order(key):
        ratio = content_ratio(key, torrents, mounts) if target else None
        band = 0 if target == 0 or (ratio is not None and ratio >= target) else 1
        return (band, -sizes[key] if sizes is not None else 0, key)
    return sorted(candidates, key=order)


def protected_content(torrents, mounts, now, days):
    # Reuse fail-closed validation, but never turn a global DEFER into a start.
    assess(torrents, mounts)
    protected = set()
    for torrent in torrents:
        path = host_path(torrent.get('content_path'), mounts)
        if torrent['progress'] < 1 or torrent['state'] not in QUIET_STATES:
            protected.add(path)
            continue
        completed = timestamp(torrent.get('completion_on'))
        if completed == 0 or completed > now:
            raise ValueError('Completion time unavailable')
        # Do not equate zero bandwidth with idle: explicit quiet state AND
        # verified zero rates are needed. Completed active seeds are excluded.
        rates = [torrent.get('upspeed'), torrent.get('dlspeed')]
        if any(type(rate) is not int or rate < 0 for rate in rates):
            raise ValueError('Transfer activity unavailable')
        if any(rates) or now - completed < days * 86400:
            protected.add(path)
    return protected


def plan(files, torrents, mounts, guards, *, days=DEFAULT_AGE_DAYS, now,
         observed_at, root):
    """Return private candidate paths, not an execution manifest or permission.

    Age uses the most recent of mtime, first_seen and known torrent completion.
    first_seen is required: copied old timestamps must not age new cache arrivals.
    Unknown global data produces no candidates. Local uncertainty skips that file.
    A second fresh observation and execution-time coordination remain mandatory.
    """
    result = {'read_only': True, 'execution_allowed': False,
              'age_days': days, 'candidates': [], 'skipped': [], 'blockers': []}
    try:
        days = age_days(days)
        now, observed_at = timestamp(now), timestamp(observed_at)
        if not 0 <= now - observed_at <= 30:
            raise ValueError('Snapshot stale or from the future')
        root = absolute_path(root)
        if root == '/':
            raise ValueError('Unbounded source root')
        if not isinstance(guards, dict):
            raise ValueError('Missing guards')
        result['blockers'] = [key for key in REQUIRED_GUARDS
                              if guards.get(key) != 'pass']
        if result['blockers']:
            result['decision'] = 'blocked'
            return result
        protected = protected_content(torrents, mounts, now, days)
        if not isinstance(files, list):
            raise ValueError('Invalid inventory')
        seen = set()
        for item in files:
            if not isinstance(item, dict):
                raise ValueError('Invalid inventory entry')
            path = absolute_path(item.get('path'))
            if path in seen or path == root or not within(path, root):
                raise ValueError('Duplicate or out-of-root file')
            seen.add(path)
            reason = None
            if any(within(path, p) or within(p, path) for p in protected):
                reason = 'protected_content'
            elif (item.get('regular') is not True or item.get('symlink') is not False
                  or type(item.get('nlink')) is not int or item['nlink'] != 1):
                reason = 'unsupported_file'
            elif item.get('open') is not False or item.get('stable') is not True:
                reason = 'busy_or_unverified'
            else:
                try:
                    modified = timestamp(item.get('mtime'))
                    arrived = timestamp(item.get('first_seen'))
                    if max(modified, arrived) > now:
                        reason = 'unknown_age'
                    elif now - max(modified, arrived) < days * 86400:
                        reason = 'too_young'
                except ValueError:
                    reason = 'unknown_age'
            if reason:
                result['skipped'].append({'path': path, 'reason': reason})
            else:
                result['candidates'].append(path)
        result['decision'] = 'preview_only'
    except (ValueError, TypeError, KeyError, AttributeError):
        # Avoid publishing partial candidates after an invalid snapshot.
        result.update(decision='unknown', candidates=[], skipped=[],
                      blockers=['unverifiable_snapshot'])
    return result


def waiting_table(files, torrents, mounts, inventory, guards, *, days, now, root,
                  max_bytes=16*1024**3, target_ratio=0):
    """Private read-only age forecast, never an execution time or authorization."""
    target_ratio = ratio_target(target_ratio)
    diagnostic = plan(files,torrents,mounts,{k:'pass' for k in REQUIRED_GUARDS},
                      days=days,now=now,observed_at=now,root=root)
    if diagnostic['decision']=='unknown':
        raise ValueError('Forecast snapshot unavailable')
    reasons={x['path']:x['reason'] for x in diagnostic['skipped']}
    resolved=[(host_path(t['content_path'],mounts),t) for t in torrents]
    rows=[]
    for item in files:
        key=item['path'];reason=reasons.get(key,'ready')
        size=inventory[key]['signature'][2]
        if type(size) is not int or size<0: raise ValueError('Unverifiable size')
        ready=None
        related=[t for path,t in resolved if within(key,path) or within(path,key)]
        quiet=all(t['progress']==1 and t['state'] in QUIET_STATES and
                  t.get('upspeed')==0 and t.get('dlspeed')==0 for t in related)
        if reason=='protected_content' and quiet and item.get('open') is False and item.get('stable') is True and item.get('regular') is True and item.get('symlink') is False and item.get('nlink')==1:
            # A known, recently completed idle torrent has a calculable age date.
            reason='too_young'
        if reason in ('ready','too_young'):
            dates=[timestamp(item['mtime']),timestamp(item['first_seen'])]
            dates.extend(timestamp(t['completion_on']) for t in related)
            ready=max(dates)+days*86400
        if size>max_bytes:
            reason='file_exceeds_batch_limit';ready=None
        ratio=content_ratio(key,torrents,mounts)
        rows.append({'file':key[len(root)+1:],'bytes':size,'age_ready_at':ready,'reason':reason,
                     'ratio':ratio,'ratio_target_met':ratio is not None and target_ratio>0 and ratio>=target_ratio})
    rows.sort(key=lambda r:(r['age_ready_at'] is None,r['age_ready_at'] or 0,r['file']))
    return {'version':1,'observed_at':now,'age_days':days,'rows':rows,
            'max_bytes':max_bytes,'ratio_target':target_ratio,'file_count':len(rows),'total_bytes':sum(r['bytes'] for r in rows),
            'blockers':[k for k in REQUIRED_GUARDS if guards.get(k)!='pass'],
            'execution_allowed':False}


def main(argv=None):
    import argparse
    import json
    import sys
    parser = argparse.ArgumentParser(description='Read-only selective Mover preview; no execution')
    parser.add_argument('snapshot', help='Trusted, canonical host inventory JSON')
    parser.add_argument('--days', type=int, choices=AGE_OPTIONS, default=DEFAULT_AGE_DAYS)
    parser.add_argument('--include-paths', action='store_true', help='Private local diagnostic output')
    args = parser.parse_args(argv)
    try:
        with open(args.snapshot, encoding='utf-8') as stream:
            snapshot = json.load(stream)
        output = plan(**snapshot, days=args.days)
    except (OSError, ValueError, TypeError):
        print(json.dumps({'decision': 'unknown', 'execution_allowed': False}))
        return 20
    if not args.include_paths:
        from collections import Counter
        output['candidate_count'] = len(output.pop('candidates'))
        output['skipped_counts'] = dict(Counter(item['reason'] for item in output.pop('skipped')))
    print(json.dumps(output, ensure_ascii=False, allow_nan=False))
    return 0 if output['decision'] == 'preview_only' else 20


if __name__ == '__main__':
    import sys
    sys.exit(main())
]]></INLINE></FILE>
<FILE Name="/tmp/fejes-mover-monitor-2026.10.25.4/selective_preview.py"><INLINE><![CDATA[#!/usr/bin/env python3
"""Live inventory and read-only selection preview. No movement entry point."""
import argparse
import fcntl
import json
import os
from pathlib import Path
import re
import stat
import subprocess
import tempfile
import time
from collections import Counter
from selection_policy import plan, age_days
from torrent_preflight import read_snapshot, absolute_path
from fejes_service import dry_run

CONFIG = Path('/boot/config/plugins/fejes.mover.monitor/selective.json')
INVENTORY = Path('/boot/config/plugins/fejes.mover.monitor/selective-inventory.json')
SOURCE = Path('/mnt/cache/Filmek')
CANONICAL = '/mnt/user/Filmek'


def read_json(path, default):
    if path.is_symlink():
        raise ValueError('Symlink configuration')
    if not path.exists():
        return default
    return json.loads(path.read_text())


def atomic_json(path, data):
    payload = json.dumps(data, allow_nan=False, sort_keys=True).encode()
    fd, temporary = tempfile.mkstemp(prefix='.selective-', dir=path.parent)
    try:
        with os.fdopen(fd, 'wb') as stream:
            stream.write(payload)
            stream.flush()
            os.fsync(stream.fileno())
        if Path(temporary).read_bytes() != payload:
            raise OSError('Readback failed')
        os.replace(temporary, path)
        directory=os.open(path.parent,os.O_RDONLY|os.O_DIRECTORY)
        try:os.fsync(directory)
        finally:os.close(directory)
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)


def canonical(path):
    path = absolute_path(path)
    # Known Unraid views only; the scanner itself traverses physical cache only.
    match = re.match(r'^/mnt/(?:cache|user0|disk[1-9][0-9]*)(/.*)?$', path)
    if match:
        return '/mnt/user' + (match[1] or '')
    if path == '/mnt/user' or path.startswith('/mnt/user/'):
        return path
    raise ValueError('Unrecognized host path namespace')


def open_paths():
    paths = set()
    for directory in Path('/proc').glob('[0-9]*/fd'):
        try:
            for fd in directory.iterdir():
                try:
                    target = os.readlink(fd)
                    if target.startswith('/mnt/'):
                        paths.add(canonical(target.removesuffix(' (deleted)')))
                except FileNotFoundError:
                    pass  # Process closed this descriptor during enumeration.
        except FileNotFoundError:
            pass
    return paths


def inventory(now, previous):
    if not os.path.ismount('/mnt/cache') or SOURCE.is_symlink() or not SOURCE.is_dir():
        raise ValueError('Source unavailable')
    opened = open_paths()
    files, current = [], {}
    device = SOURCE.stat().st_dev
    def fail(error):
        raise error
    for folder, directories, names in os.walk(SOURCE, followlinks=False, onerror=fail):
        directories[:] = [name for name in directories
                          if not (Path(folder)/name).is_symlink()]
        for name in names:
            path = Path(folder)/name
            info = path.lstat()
            if info.st_dev != device:
                raise ValueError('Nested mount')
            key = canonical(str(path))
            signature = [info.st_dev, info.st_ino, info.st_size, info.st_mtime_ns, info.st_ctime_ns]
            old = previous.get(key, {})
            same = old.get('signature') == signature
            first = old.get('first_seen') if same else now
            if type(first) not in (int, float) or not 0 <= first <= now:
                raise ValueError('Invalid inventory time')
            current[key] = {'signature': signature, 'first_seen': first}
            files.append(dict(path=key, regular=stat.S_ISREG(info.st_mode),
                              symlink=stat.S_ISLNK(info.st_mode), nlink=info.st_nlink,
                              open=key in opened, stable=same,
                              mtime=info.st_mtime, first_seen=first))
    return files, current


def integrity_observation(proc=Path('/proc'), run=Path('/var/run')):
    """Read-only evidence, never a movement authorization or a queue-drained claim."""
    watcher = b'/usr/local/emhttp/plugins/dynamix.file.integrity/scripts/watcher'
    try:
        listeners = 0
        for entry in proc.glob('[0-9]*/cmdline'):
            try:
                args = entry.read_bytes().split(b'\0')
            except FileNotFoundError:
                continue
            if watcher in args:
                listeners += 1
        pipes = sum(stat.S_ISFIFO(p.lstat().st_mode) for p in run.glob('hash.pipe.disk*'))
        return {'state': 'observed' if listeners and pipes else 'incomplete',
                'listeners': listeners, 'pipes': pipes,
                'movement_verified': False}
    except OSError:
        return {'state': 'unknown', 'movement_verified': False}


def collect(update_inventory=False):
    settings = read_json(CONFIG, {'version': 1, 'age_days': 7})
    if settings.get('version') != 1:
        raise ValueError('Unknown configuration version')
    days = age_days(settings.get('age_days'))
    now = time.time()
    previous = read_json(INVENTORY, {'version': 1, 'files': {}})
    if previous.get('version') != 1 or not isinstance(previous.get('files'), dict):
        raise ValueError('Invalid inventory')
    files, current = inventory(now, previous['files'])
    torrents, mounts = read_snapshot('binhex-qbittorrentvpn', 5)
    mounts = [dict(m, Source=canonical(m['Source'])) if m.get('Type') == 'bind' and
              m.get('Source', '').startswith('/mnt/') else m for m in mounts]
    # Require every resolved torrent path to be canonical, including completed ones.
    from torrent_preflight import host_path
    for torrent in torrents:
        resolved = host_path(torrent.get('content_path'), mounts)
        if canonical(resolved) != resolved:
            raise ValueError('Unresolved torrent namespace')
    report = dry_run()
    checks = {c['key']: c['state'] for c in report['dry_run']['checks']}
    guards = {k: checks.get(k, 'unknown') for k in ('backup', 'parity', 'mover', 'cooldown', 'capacity')}
    guards.update(mount='pass', namespace='pass', open_files='pass')
    # Cron wiring alone does not establish runtime watcher/hash safety.
    guards['integrity'] = 'unknown'
    if checks.get('launcher') != 'pass':
        guards['mount'] = 'unknown'
    result = plan(files, torrents, mounts, guards, days=days,
                  now=time.time(), observed_at=now, root=CANONICAL)
    # Selection diagnostics remain useful with global start blockers, but they
    # are explicitly hypothetical and can never authorize execution.
    selection_guards = dict(guards)
    selection_guards.update({key: 'pass' for key in selection_guards})
    selection = plan(files, torrents, mounts, selection_guards, days=days,
                     now=time.time(), observed_at=now, root=CANONICAL)
    if update_inventory:
        atomic_json(INVENTORY, {'version': 1, 'files': current})
    return {'age_days': days, 'execution_allowed': False, 'decision': result['decision'],
            'blockers': sorted(set(result['blockers'] + ['live_movement_not_integrated'])),
            'integrity_observation': integrity_observation(), 'selection_decision': selection['decision'],
            'candidate_count': len(selection['candidates']), 'file_count': len(files),
            'skipped_counts': dict(Counter(i['reason'] for i in selection['skipped'])),
            'inventory_updated': update_inventory, 'live_movement': 'not_integrated'}


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('action', choices=['preview', 'observe'])
    args = parser.parse_args()
    try:
        with open('/var/run/fejes-selective-inventory.lock', 'a') as lock:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
            print(json.dumps(collect(args.action == 'observe'), allow_nan=False))
        return 0
    except (OSError, ValueError, TypeError, KeyError, AttributeError, RuntimeError, subprocess.SubprocessError):
        print(json.dumps({'execution_allowed': False, 'decision': 'unknown',
                          'error': 'Inventory or protection state could not be verified'}))
        return 20


if __name__ == '__main__':
    raise SystemExit(main())
