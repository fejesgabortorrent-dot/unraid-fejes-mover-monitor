<script>
(()=>{if(window.fejesMoverDashTimer)clearInterval(window.fejesMoverDashTimer);let busy=false;window.fejesMoverDashTimer=setInterval(async()=>{if(document.hidden||busy)return;busy=true;const c=new AbortController(),t=setTimeout(()=>c.abort(),8000);try{const r=await fetch('/Tools/FejesMover',{cache:'no-store',credentials:'same-origin',signal:c.signal});if(!r.ok)throw Error();const doc=new DOMParser().parseFromString(await r.text(),'text/html'),p=doc.getElementById('fm-monitor');if(!p)throw Error();const banner=p.querySelector('.fmc-mode');if(!banner)throw Error();const d=p.dataset,run=d.running==='1',unknown=d.uncertain==='1';document.getElementById('fmd-mode').replaceChildren(banner);document.getElementById('fmd-status').textContent=d.mode==='demo'?'DEMO':run?'● Mover running':unknown?'⚠ Unverified status':'● Idle';document.getElementById('fmd-status').style.color=run?'#f2b84b':unknown?'#ef967a':'#64b99b';document.getElementById('fmd-percent').textContent=d.available==='1'?d.used+'%':'—';document.getElementById('fmd-ring').style.background='conic-gradient(#ef7d00 '+(d.available==='1'?Number(d.used):0)+'%,#7773 0)';document.getElementById('fmd-free').textContent=d.free;document.getElementById('fmd-updated').textContent='Updated: '+new Date().toLocaleTimeString('en-US');}catch(e){const p=document.getElementById('fmd-updated');if(p)p.textContent='⚠ Refresh failed · stale data';}finally{clearTimeout(t);busy=false;}},10000);})();
</script>



