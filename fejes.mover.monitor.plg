  $msLock=fopen('/var/run/fejes-mover-settings.lock','c');if(!$msLock||!flock($msLock,LOCK_EX|LOCK_NB))throw new RuntimeException('Ein anderer Speichervorgang läuft.');
  $msSource=file_get_contents($msPath);$msValues=$msParse($msSource);
  if(!is_string($_POST['source_hash']??null)||!hash_equals(hash('sha256',$msSource),$_POST['source_hash']))throw new RuntimeException('Das Skript wurde zwischenzeitlich geändert. Seite neu laden.');
  if($msNew===$msValues){$msMessage='Geprüft: Diese Werte sind bereits gespeichert. Keine Änderung vorgenommen.';}
  else{
