<?php
$fmdRaw=trim(@file_get_contents('/var/run/mover.pid')?:'');$fmdPid=ctype_digit($fmdRaw)?(int)$fmdRaw:0;
$fmdCmd=$fmdPid?str_replace(chr(0),' ',@file_get_contents("/proc/$fmdPid/cmdline")?:''):'';
$fmdRun=$fmdPid>1&&preg_match('~(?:^|[ /])mover(?: |$)~',$fmdCmd);
$fmdTotal=is_dir('/mnt/cache')?@disk_total_space('/mnt/cache'):false;$fmdFree=is_dir('/mnt/cache')?@disk_free_space('/mnt/cache'):false;$fmdUsed=$fmdTotal&&$fmdFree!==false?round(100*(1-$fmdFree/$fmdTotal),1):0;
$fmdDisplay=$fmdTotal?$fmdUsed.'%':'—';
$fmdFreeText=$fmdFree!==false?number_format($fmdFree/1073741824,1,',',' '):'—';
$fmdStatus=$fmdRun?'● Mover fut':($fmdRaw?'⚠ Nem ellenőrizhető':'● Várakozik');$fmdColor=$fmdRun?'#f2b84b':($fmdRaw?'#ef967a':'#64b99b');
$mytiles['fejes.mover.monitor']['column2']=<<<HTML
<tbody id="fejes-mover-dashboard" class="mixed" title="Mover figyelő">
<tr><td><span class="tile-header"><span class="tile-header-left"><i class="fa fa-exchange fa-2x"></i><div class="section"><h3 class="tile-header-main">MOVER FIGYELŐ</h3></div></span><span class="tile-header-right"><a href="/Tools/FejesMoverSettings" title="Mover beállítások" style="margin-right:12px"><i class="fa fa-cog"></i></a><a href="/Tools/FejesMover" title="Részletes Mover figyelő"><i class="fa fa-external-link"></i></a></span></span></td></tr>
<tr><td><div id="fmd-body" style="padding:12px 8px"><div style="display:flex;align-items:center;gap:20px"><div id="fmd-ring" style="width:86px;height:86px;flex-shrink:0;border-radius:50%;display:grid;place-items:center;background:conic-gradient(#519bce {$fmdUsed}%,#7773 0)"><span id="fmd-percent" style="width:65px;height:65px;border-radius:50%;display:grid;place-items:center;background:#20252b;color:#eee;font-size:19px">{$fmdDisplay}</span></div><div><strong id="fmd-status" style="font-size:20px;color:{$fmdColor}">{$fmdStatus}</strong><p style="margin:8px 0">Cache szabad: <b id="fmd-free">{$fmdFreeText}</b> GiB</p><small>Cache / SSD → Mover → Lemeztömb</small></div></div><p style="margin:14px 0 0"><a href="/Tools/FejesMover">Fájlok és részletes állapot →</a></p><small id="fmd-updated">Adatok betöltve · frissítés 10 mp-enként</small></div></td></tr>
</tbody>
HTML;
?>
<script>
(()=>{if(window.fejesMoverDashTimer)clearInterval(window.fejesMoverDashTimer);let busy=false;window.fejesMoverDashTimer=setInterval(async()=>{if(document.hidden||busy)return;busy=true;const c=new AbortController(),t=setTimeout(()=>c.abort(),8000);try{const r=await fetch('/Tools/FejesMover',{cache:'no-store',credentials:'same-origin',signal:c.signal});if(!r.ok)throw Error();const doc=new DOMParser().parseFromString(await r.text(),'text/html'),p=doc.getElementById('fm-monitor');if(!p)throw Error();const d=p.dataset,run=d.running==='1',unknown=d.uncertain==='1';document.getElementById('fmd-status').textContent=run?'● Mover fut':unknown?'⚠ Nem ellenőrizhető':'● Várakozik';document.getElementById('fmd-status').style.color=run?'#f2b84b':unknown?'#ef967a':'#64b99b';document.getElementById('fmd-percent').textContent=d.used+'%';document.getElementById('fmd-ring').style.background='conic-gradient(#519bce '+Number(d.used)+'%,#7773 0)';document.getElementById('fmd-free').textContent=d.free;document.getElementById('fmd-updated').textContent='Frissítve: '+new Date().toLocaleTimeString('hu-HU');}catch(e){const p=document.getElementById('fmd-updated');if(p)p.textContent='⚠ Sikertelen frissítés · elavult adatok';}finally{clearTimeout(t);busy=false;}},10000);})();
</script>


]]></INLINE></FILE>
