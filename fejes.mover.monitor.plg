#fm-monitor{max-width:1160px;margin:24px auto;padding:0 18px;font-size:15px}#fm-monitor h2{font-size:28px;margin:0 0 8px}#fm-monitor .fm-sub{opacity:.7;margin-bottom:24px}#fm-monitor .fm-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:16px}#fm-monitor .fm-card{border:1px solid #7775;border-radius:12px;padding:20px;margin-bottom:18px;background:#88808}#fm-monitor .fm-label{opacity:.7;font-size:13px;margin-bottom:12px}#fm-monitor .fm-value{font-size:25px;line-height:1.4}#fm-monitor progress{width:100%;height:18px;accent-color:#64b99b;margin-top:14px}#fm-monitor pre{white-space:pre-wrap;overflow-wrap:anywhere;max-height:260px;overflow:auto;font-size:12px;line-height:1.6;background:transparent}#fm-monitor table{width:100%;table-layout:fixed}#fm-monitor th,#fm-monitor td{text-align:left;padding:10px 6px;overflow-wrap:anywhere;border-bottom:1px solid #8884}#fm-monitor th:first-child{width:58%}#fm-monitor .fm-note{font-size:13px;opacity:.75;line-height:1.6}#fm-monitor button{margin-bottom:18px;padding:9px 14px}#fm-error{color:#ef967a;min-height:20px}
#fm-monitor .fm-flow{display:flex;align-items:center;justify-content:space-around;gap:12px;border:1px solid #659ed050;background:linear-gradient(110deg,#3996d51a,#64b99b18);border-radius:14px;padding:25px 12px;font-size:18px;font-weight:600}#fm-monitor .fm-flow b{font-size:30px;color:#888}#fm-monitor .fm-flow .fm-moving{color:#f2b84b;animation:fm-pulse 1s infinite alternate}#fm-monitor .fm-grid .fm-card:nth-child(1){border-top:3px solid #64b99b}#fm-monitor .fm-grid .fm-card:nth-child(2){border-top:3px solid #519bce}#fm-monitor .fm-grid .fm-card:nth-child(3){border-top:3px solid #c6a36d}#fm-monitor .fm-donut{width:110px;height:110px;border-radius:50%;display:grid;place-items:center;margin:10px auto;background:conic-gradient(#519bce calc(var(--used)*1%),#7773 0)}#fm-monitor .fm-donut span{display:grid;place-items:center;width:85px;height:85px;background:#20252b;color:#eee;border-radius:50%;font-size:24px}@keyframes fm-pulse{from{opacity:.3}to{opacity:1}}@media(max-width:600px){#fm-monitor .fm-flow{font-size:12px;gap:4px;padding:18px 8px}}@media(prefers-reduced-motion:reduce){#fm-monitor .fm-moving{animation:none!important}}
/* Compact panels that inherit the surrounding Unraid page typography. */
#fm-monitor{font:inherit;max-width:1160px;margin:20px auto;padding:0 16px}
#fm-monitor h2{font-size:24px;font-weight:600;margin:0 0 6px}
#fm-monitor h3{font-size:17px;font-weight:600;margin:0 0 14px}
#fm-monitor .fm-sub{margin-bottom:18px}
#fm-monitor .fm-card{background:transparent;border:1px solid #8885;border-radius:4px;padding:18px;margin-bottom:16px}
#fm-monitor .fm-label{font-size:12px;letter-spacing:.7px;font-weight:600}
#fm-monitor .fm-value{font-size:23px}
#fm-monitor .fm-flow{border-radius:4px;background:#88808;border:1px solid #8885;padding:18px 12px;font-size:16px}
#fm-monitor .fm-grid .fm-card:nth-child(n){border-top:2px solid #ef7d00}
#fm-monitor .fm-donut{background:conic-gradient(#ef7d00 calc(var(--used)*1%),#7773 0)}
#fm-monitor .fm-donut span{background:#252525}
#fm-monitor progress{accent-color:#ef7d00;height:12px}
#fm-monitor button{font:inherit;padding:7px 12px;border:1px solid #8887;border-radius:3px;background:transparent;color:inherit;cursor:pointer}
#fm-monitor button:hover{border-color:#ef7d00}
#fm-monitor button:focus-visible{outline:2px solid #ef7d00;outline-offset:3px}
#fm-monitor .fm-note{font-size:12px}
