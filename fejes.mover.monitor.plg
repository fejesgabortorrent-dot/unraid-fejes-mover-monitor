<h3><?=$e($t('Mikor kerülhet sorra?','When can files become eligible?','Wann können Dateien an die Reihe kommen?'))?></h3>
<?=$help($t('Mit jelent a korhatár?','What does age eligibility mean?','Was bedeutet die Altersfreigabe?'),$t('A táblázat a korhatár legkorábbi lejártát mutatja, nem garantált indulást vagy befejezést. A torrent aktivitása, a szabad hely, a várakozási idő és minden védelem továbbra is számít.','The table shows the earliest age eligibility, not a guaranteed start or finish. Torrent activity, free space, cooldown and every safety guard still apply.','Die Tabelle zeigt die früheste Altersfreigabe, keinen garantierten Start oder Abschluss. Torrent-Aktivität, Freiplatz, Wartezeit und Schutzprüfungen gelten weiterhin.'))?>
<?php if($forecast!==null):?>
<p><?=$e($t('Utolsó felmérés','Last observation','Letzte Erfassung'))?>: <time data-fms-time="<?=$e($forecast['observed_at']??0)?>"><?=$e(date('Y-m-d H:i:s',(int)($forecast['observed_at']??0)))?></time> · <?=$e(count($forecast['rows']))?> <?=$e($t('fájl','files','Dateien'))?> · <?=$e(number_format(($forecast['total_bytes']??0)/1073741824,2))?> GiB</p>
<p data-fms-stale="<?=$e($forecast['observed_at']??0)?>" role="status"><?=$e($t('Pillanatkép: frissítéshez használd a Friss állapot lekérése gombot. A régi felmérés már elmozdult vagy megváltozott fájlt is tartalmazhat.','Snapshot: use Refresh status to refresh. An older observation may include files that have moved or changed.','Momentaufnahme: mit Status aktualisieren erneuern. Ältere Erfassungen können inzwischen verschobene oder veränderte Dateien enthalten.'))?></p>
<?php if(!empty($forecast['blockers'])):?><p><?=$e($t('A felméréskor indítást akadályozó feltételek','Start blockers at observation','Startblockaden bei der Erfassung'))?>: <?=$e($blockerText($forecast['blockers']))?></p><?php endif?>
<div class="fms-filters"><input type="search" id="fms-search" aria-label="<?=$e($t('Fájl keresése','Search files','Dateien suchen'))?>" placeholder="<?=$e($t('Keresés fájlnév vagy útvonal alapján…','Search filename or path…','Dateiname oder Pfad suchen…'))?>"><select id="fms-filter" aria-label="<?=$e($t('Állapotszűrő','Status filter','Statusfilter'))?>">
<?php foreach(['all'=>$t('Minden állapot','All states','Alle Zustände'),'too_young'=>$t('Túl fiatal','Too young','Zu jung'),'protected_content'=>$t('Torrentvédelem','Torrent protection','Torrent-Schutz'),'ready'=>$t('Kor szerint alkalmas','Age eligible','Alter erfüllt'),'other'=>$t('Egyéb akadály','Other blocker','Andere Blockade')] as $value=>$label):?><option value="<?=$e($value)?>"><?=$e($label)?></option><?php endforeach?></select><label><input type="checkbox" id="fms-video"> <?=$e($t('Csak videók','Videos only','Nur Videos'))?></label><span class="fms-count" id="fms-visible" role="status" aria-live="polite"></span></div><div class="fms-sort-controls"><label for="fms-sort-key"><?=$e($t('Rendezés','Sort by','Sortieren nach'))?></label><select id="fms-sort-key"><?php foreach(['original'=>$t('Eredeti sorrend','Original order','Ursprüngliche Reihenfolge'),'name'=>$t('Fájl','File','Datei'),'size'=>$t('Méret','Size','Größe'),'ratio'=>$t('Megosztási arány','Share ratio','Freigabeverhältnis'),'ready'=>$t('Korhatár lejárta','Age eligible from','Altersfreigabe ab'),'remaining'=>$t('Korhatárig hátra','Time remaining','Verbleibende Zeit'),'status'=>$t('Állapot','Status','Status')] as $key=>$label):?><option value="<?=$e($key)?>"><?=$e($label)?></option><?php endforeach?></select><button type="button" id="fms-sort-direction" aria-label="<?=$e($t('Sorrend megfordítása','Reverse sort direction','Sortierrichtung umkehren'))?>" disabled>↑ <span><?=$e($t('Növekvő','Ascending','Aufsteigend'))?></span></button><small><?=$e($t('Csak a kijelzést rendezi.','Sorts the display only.','Sortiert nur die Anzeige.'))?></small></div><p id="fms-no-results" hidden><?=$e($t('Nincs találat ezekkel a szűrőkkel.','No files match these filters.','Keine Dateien entsprechen diesen Filtern.'))?></p><div class="fms-queue-scroll" style="max-height:540px;overflow:auto"><table style="width:100%;border-collapse:collapse;text-align:left" class="fms-queue"><thead><tr>
<?php foreach([$t('Fájl a Filmek megosztásban','File in Filmek share','Datei in der Filmek-Freigabe'),$t('Méret','Size','Größe'),$t('Megosztási arány','Share ratio','Freigabeverhältnis'),$t('Korhatár lejárta','Age eligible from','Altersfreigabe ab'),$t('Korhatárig hátra','Time until age eligible','Zeit bis Altersfreigabe'),$t('Állapot / akadály','Status / blocker','Status / Blockade')] as $column=>$heading):?><th aria-sort="none" style="padding:9px;border-bottom:1px solid #888"><button type="button" class="fms-sort-heading" data-fms-sort="<?=$e(['name','size','ratio','ready','remaining','status'][$column])?>"><?=$e($heading)?> <span data-sort-arrow aria-hidden="true">↕</span></button></th><?php endforeach?>
</tr></thead><tbody>
<?php foreach($forecast['rows'] as $row): if(!is_array($row))continue; $ready=$row['age_ready_at']??null;$reason=$row['reason']??'unknown'; ?>
<tr data-fms-row data-sort-name="<?=$e($row['file']??'')?>" data-sort-size="<?=$e($row['bytes']??'')?>" data-sort-ratio="<?=$e($row['ratio']??'')?>" data-sort-ready="<?=$e(is_numeric($ready)?$ready:'')?>" data-reason="<?=$e($reason)?>" data-video="<?=in_array(strtolower(pathinfo($row['file']??'',PATHINFO_EXTENSION)),['mkv','mp4','avi','m4v','mov','ts','m2ts','webm','wmv','mpg','mpeg'],true)?'1':'0'?>"><td style="padding:9px"><details class="fms-file"><summary><?=$e(basename($row['file']??'—'))?></summary><small><?=$e($row['file']??'—')?></small></details></td><td style="padding:9px;white-space:nowrap"><?=$e(number_format(($row['bytes']??0)/1073741824,3))?> GiB</td>
<td style="padding:9px;white-space:nowrap"><?php $ratio=$row['ratio']??null;echo $e(is_numeric($ratio)&&is_finite((float)$ratio)&&(float)$ratio>=0?number_format((float)$ratio,2):'—');if(($row['ratio_target_met']??false)===true):?><small> · <?=$e($t('Cél elérve','Target met','Ziel erreicht'))?></small><?php endif?></td>
<td style="padding:9px;white-space:nowrap"><?php if(is_numeric($ready)):?><time data-fms-time="<?=$e($ready)?>"><?=$e(date('Y-m-d H:i:s',(int)$ready))?></time><?php else:?>—<?php endif?></td>
<td style="padding:9px;white-space:nowrap" <?=is_numeric($ready)?'data-fms-countdown="'.$e($ready).'"':''?>><?=$e(is_numeric($ready)?$t('Számítás…','Calculating…','Berechnung…'):$t('Nem becsülhető','Cannot estimate','Nicht schätzbar'))?></td>
<td style="padding:9px"><?=$e($reason==='ready'?$t('Kor szerint kész; a többi feltételt újra ellenőrzi','Age eligible; other conditions will be rechecked','Alter erfüllt; weitere Bedingungen werden erneut geprüft'):($skipLabels[$reason]??$t('Bizonytalan állapot','Unverifiable state','Ungeprüfter Zustand')))?></td></tr>
<?php endforeach?>
</tbody></table></div>
<?php else:?><p><?=$e($t('Még nincs aktuális felmérés ehhez a korhatárhoz. Nyomd meg a Friss állapot lekérése gombot: ez nem mozgat fájlt.','No current observation for this age setting. Press Refresh status; it does not move files.','Keine aktuelle Erfassung für dieses Alter. Status aktualisieren drücken; dabei werden keine Dateien verschoben.'))?></p><?php endif?>
</section>
<details class="fms-panel"><summary><?=$e($t('Beállítások · korhatár és felmérés','Settings · age and observation','Einstellungen · Alter und Erfassung'))?></summary><fieldset><legend><?=$e($t('Minimumkor','Minimum age','Mindestalter'))?></legend>
<?php foreach([1,7,14,30] as $choice):?><label style="margin-right:22px"><input type="radio" name="age_days" value="<?=$choice?>" <?=$days===$choice?'checked':''?>> <?=$choice?> <?=$e($t('nap','days','Tage'))?></label><?php endforeach?>
</fieldset>
<fieldset><legend><?=$e($t('Mozgatási kör méretkorlátja','Movement batch limit','Größenlimit pro Lauf'))?></legend>
<label for="fms-batch"><?=$e($t('Legfeljebb GiB körönként','Maximum GiB per batch','Maximale GiB pro Lauf'))?></label><select id="fms-batch" name="batch_gib"><?php foreach([16,32,64,128] as $limit):?><option value="<?=$limit?>" <?=$batchGiB===$limit?'selected':''?>><?=$limit?> GiB</option><?php endforeach?></select>
<?=$help($t('Méretkorlát súgó','Batch limit help','Hilfe zum Lauflimit'),$t('Alapérték: 16 GiB. Nagyobb filmhez válassz nagyobb korlátot. Legfeljebb 8 fájl; a korhatár, a védelmek és az ellenőrzőösszeg-vizsgálat nem változik.','Default: 16 GiB. Select a higher limit for larger movies. Up to 8 files; age, safety guards and checksum verification remain unchanged.','Standard: 16 GiB. Für größere Filme ein höheres Limit wählen. Höchstens 8 Dateien; Alter, Schutz und Prüfsummenprüfung bleiben unverändert.'))?></fieldset>
<p class="fms-order-note"><?=$e($t('Mozgatási sorrend: előbb az aránycélt elért tartalom, azon belül a nagyobb fájlok. Kikapcsolt aránycélnál is a nagyobb fájl kerül előre. Az adagkorlátok és minden védelem változatlan.','Movement order: target-ratio content first, then larger files within each group. With ratio priority disabled, larger files still go first. Batch limits and all protections remain unchanged.','Verschiebereihenfolge: zuerst Inhalte mit erreichtem Verhältnisziel, innerhalb der Gruppen größere Dateien zuerst. Ohne Verhältnispriorität ebenfalls größere Dateien zuerst. Lauflimits und Schutzbedingungen bleiben unverändert.'))?></p>
<fieldset><legend><?=$e($t('Megosztási arány · sorrendezés','Share ratio · priority','Freigabeverhältnis · Priorität'))?></legend>
<label for="fms-ratio"><?=$e($t('Célérték (0 = kikapcsolva)','Target (0 = disabled)','Ziel (0 = deaktiviert)'))?></label>
<input id="fms-ratio" type="number" name="ratio_target" min="0" max="100" step="0.01" value="<?=$e($ratioTarget)?>">
<?=$help($t('Aránycél súgó','Ratio priority help','Hilfe zum Verhältnisziel'),$t('A célértéket elért torrentek alkalmas fájljai előre kerülnek. Az alacsony vagy ismeretlen arány nem akadályozza a mozgatást. A korhatár és minden védelem továbbra is érvényes; a seedelés folytatódhat.','Eligible files whose torrents meet the target go first. Low or unknown ratios do not block movement. Age and all safety guards still apply; seeding can continue.','Geeignete Dateien mit erreichtem Torrent-Ziel werden bevorzugt. Niedrige oder unbekannte Werte blockieren nichts. Alter und alle Schutzbedingungen gelten weiterhin; Seeding kann fortgesetzt werden.'))?></fieldset>
<p><button name="fms_action" value="save"><?=$e($t('Beállítások mentése','Save settings','Einstellungen speichern'))?></button>
</p><button name="fms_action" value="observe"><?=$e($t('Felmérés rögzítése','Record observation','Erfassung speichern'))?></button><p><a href="/Tools/FejesMoverSettings"><?=$e($t('Szabadhely-küszöb és várakozási idő','Free-space threshold and cooldown','Freiplatzgrenze und Wartezeit'))?></a></p></details>
<details class="fms-panel"><summary><?=$e($t('Kézi műveletek','Manual actions','Manuelle Aktionen'))?></summary><p><?=$e($t('Egy kör legfeljebb 8 fájl / '.$batchGiB.' GiB. Az elmentett korhatár érvényes; a kereső és szűrők nem jelölik ki a mozgatandó fájlokat. Indulás előtt minden védelmi feltételt újra ellenőriz.','Up to 8 files / '.$batchGiB.' GiB per batch. Uses the saved age; search and filters do not select files for movement. All guards are rechecked before starting.','Höchstens 8 Dateien / '.$batchGiB.' GiB pro Lauf. Gespeichertes Alter gilt; Suche und Filter wählen keine Dateien zum Verschieben aus. Alle Schutzbedingungen werden erneut geprüft.'))?></p><button id="fms-run" name="fms_action" value="run" class="fms-danger" onclick="return window.confirm(this.dataset.confirm)" data-confirm="<?=$e($t('Az elmentett korhatárral, minden alkalmas fájlra indulhat egy kör (legfeljebb 8 fájl / '.$batchGiB.' GiB). A táblázatszűrő nem fájlkijelölés. Folytatod?','Start a batch for all eligible files using the saved age (up to 8 files / '.$batchGiB.' GiB)? Table filters do not select files for movement. Continue?','Einen Lauf für alle geeigneten Dateien mit gespeichertem Alter starten (höchstens 8 Dateien / '.$batchGiB.' GiB)? Tabellenfilter wählen keine Dateien zum Verschieben aus. Fortfahren?'))?>" style="border:2px solid #ef7d00;padding:10px" <?=($fmc['error']||$fmc['mode']!=='advanced'||$fmc['pool']!=='cache'||!$fmc['mounted'])?'disabled':''?>><?=$e($t('Érett fájlok ellenőrzött mozgatása','Move eligible files with verification','Geeignete Dateien geprüft verschieben'))?></button>
</details></form>
<details class="fms-panel"><summary><?=$e($t('Működés és védelmek','How it works and protections','Funktionsweise und Schutz'))?></summary><p><?=$e($t('Csak cache/Filmek → lemeztömb. A félkész, aktív, megnyitott, megváltozott vagy túl fiatal tartalom kimarad. A felhasználói útvonal változatlan.','Only cache/Filmek → array. Incomplete, active, open, changed or young content is skipped. The user-share path is preserved.','Nur cache/Filmek → Array. Unvollständige, aktive, geöffnete, veränderte oder zu junge Inhalte werden übersprungen. Der Benutzerpfad bleibt erhalten.'))?></p>
<p><?=$e($t('A kor a legutóbbi módosítástól, a cache-ben történt első igazolt megfigyeléstől és a torrent befejezésétől is számít. Régi fájldátummal sem lehet az új érkezést megkerülni.','Age includes last modification, first verified cache observation and torrent completion. An old timestamp cannot bypass a recent arrival.','Das Alter berücksichtigt Änderung, erste bestätigte Cache-Erfassung und Torrent-Abschluss. Ein altes Datum umgeht keine neue Ankunft.'))?></p>
<p><?=$e($t('A szabad hely küszöbe és a várakozási idő is érvényes. Mentés, scrub, paritás, másik Mover vagy bizonytalan állapot esetén nincs indulás. Egy kör legfeljebb 8 fájl / '.$batchGiB.' GiB.','Free-space threshold and cooldown also apply. Backup, scrub, parity, another Mover or unknown state prevents starting. Each batch is limited to 8 files / '.$batchGiB.' GiB.','Freiplatzgrenze und Wartezeit gelten ebenfalls. Backup, Scrub, Parität, anderer Mover oder unbekannter Zustand verhindern den Start. Pro Lauf höchstens 8 Dateien / '.$batchGiB.' GiB.'))?></p>
</details>
<details class="fms-panel"><summary><?=$e($t('Utolsó futás részletei és napló','Last run details and log','Letzter Lauf und Protokoll'))?></summary><section id="fms-last" style="border:1px solid #8886;padding:18px;margin-top:24px">
<h3><?=$e($t('Utolsó szelektív futás','Last selective run','Letzter selektiver Lauf'))?></h3>
<p><?=$e($states[$last['state']??'unknown']??$t('Nem ellenőrizhető','Unverifiable','Nicht überprüfbar'))?></p>
<p><?=$e($t('Ellenőrzötten áthelyezve','Verified movement','Geprüft verschoben'))?>: <?=$e($last['moved_files']??0)?> <?=$e($t('fájl','files','Dateien'))?> · <?=$e(number_format(($last['moved_bytes']??0)/1073741824,3))?> GiB</p>
<?php foreach(($last['skipped']??[]) as $key=>$count):?><p><?=$e($skipLabels[$key]??$t('Bizonytalan vagy nem támogatott','Unverifiable or unsupported','Ungeprüft oder nicht unterstützt'))?>: <?=$e($count)?></p><?php endforeach?>
<?php if(!empty($last['blockers'])):?><pre><?=$e($blockerText($last['blockers']))?></pre><?php endif?>
<?php if(!empty($last['error'])):?><p role="alert"><?=$e($t('A további fájlok feldolgozása leállt. A privát rendszernapló ellenőrzése szükséges.','Further processing stopped. Inspect the private system log.','Weitere Verarbeitung gestoppt. Privates Systemprotokoll prüfen.'))?></p><?php endif?>
</section><p><a href="/Tools/FejesMover"><?=$e($t('Élő folyamatok és napló megnyitása','Open live processes and log','Live-Prozesse und Protokoll öffnen'))?></a></p></details>
</main>
<script>(()=>{
const table=document.querySelector('#fms table.fms-queue');if(!table)return;
const body=table.querySelector('tbody'),original=Array.from(body.querySelectorAll('[data-fms-row]')),headings=Array.from(table.querySelectorAll('[data-fms-sort]')),select=document.getElementById('fms-sort-key'),direction=document.getElementById('fms-sort-direction');
const ascending=<?=json_encode($t('Növekvő','Ascending','Aufsteigend'))?>,descending=<?=json_encode($t('Csökkenő','Descending','Absteigend'))?>;
const collator=new Intl.Collator(undefined,{numeric:true,sensitivity:'base'});let key='original',order=1;
function value(row){if(key==='name')return row.dataset.sortName||'';if(key==='status')return row.lastElementChild.textContent.trim();const raw=key==='remaining'?row.dataset.sortReady:row.dataset['sort'+key[0].toUpperCase()+key.slice(1)];return raw!==undefined&&raw!==''&&Number.isFinite(Number(raw))?Number(raw):null;}
function apply(){const index=new Map(original.map((r,i)=>[r,i]));const sorted=original.slice().sort((a,b)=>{if(key==='original')return index.get(a)-index.get(b);const av=value(a),bv=value(b);if(av===null||bv===null)return av===bv?index.get(a)-index.get(b):av===null?1:-1;const delta=typeof av==='number'?av-bv:collator.compare(av,bv);return delta*order||index.get(a)-index.get(b);});sorted.forEach(row=>body.appendChild(row));headings.forEach(button=>{const active=button.dataset.fmsSort===key;button.parentElement.setAttribute('aria-sort',active?(order===1?'ascending':'descending'):'none');button.querySelector('[data-sort-arrow]').textContent=active?(order===1?'↑':'↓'):'↕';});select.value=key;direction.disabled=key==='original';direction.textContent=(order===1?'↑ ':'↓ ')+(order===1?ascending:descending);}
headings.forEach(button=>button.addEventListener('click',()=>{if(key===button.dataset.fmsSort)order*=-1;else{key=button.dataset.fmsSort;order=1;}apply();}));select.addEventListener('change',()=>{key=select.value;order=1;apply();});direction.addEventListener('click',()=>{order*=-1;apply();});
})();</script>

<script>(()=>{
const readyLabel=<?=json_encode($t('Korhatár lejárt','Age eligible now','Alter erfüllt'))?>,dayLabel=<?=json_encode($t('nap','days','Tage'))?>;
function tick(){document.querySelectorAll('[data-fms-time]').forEach(el=>{const ms=Number(el.dataset.fmsTime)*1000;if(Number.isFinite(ms))el.textContent=new Date(ms).toLocaleString();});document.querySelectorAll('[data-fms-countdown]').forEach(el=>{const seconds=Math.max(0,Math.ceil(Number(el.dataset.fmsCountdown)-Date.now()/1000));if(!Number.isFinite(seconds))return;const days=Math.floor(seconds/86400),hours=Math.floor(seconds%86400/3600),minutes=Math.floor(seconds%3600/60),secs=seconds%60;el.textContent=seconds===0?readyLabel:(days?days+' '+dayLabel+' ':'')+[hours,minutes,secs].map(n=>String(n).padStart(2,'0')).join(':');});}tick();setInterval(tick,1000);

const rows=Array.from(document.querySelectorAll('[data-fms-row]')),search=document.getElementById('fms-search'),filter=document.getElementById('fms-filter'),video=document.getElementById('fms-video');
function applyFilters(){let count=0;for(const row of rows){const reason=row.dataset.reason,match=filter.value==='all'||filter.value===reason||(filter.value==='other'&&!['ready','too_young','protected_content'].includes(reason));row.hidden=!(match&&(!video.checked||row.dataset.video==='1')&&row.textContent.toLocaleLowerCase().includes(search.value.toLocaleLowerCase().trim()));if(!row.hidden)count++;}document.getElementById('fms-visible').textContent=count+' / '+rows.length;document.getElementById('fms-no-results').hidden=count!==0;}
if(search&&filter&&video){search.addEventListener('input',applyFilters);filter.addEventListener('change',applyFilters);video.addEventListener('change',applyFilters);applyFilters();}
const freshLabel=<?=json_encode($t('Kijelzés frissítve. A felmérés időpontja külön látható.','Display refreshed. The observation timestamp is shown separately.','Anzeige aktualisiert. Der Erfassungszeitpunkt wird separat angezeigt.'))?>,staleLabel=<?=json_encode($t('⚠ Sikertelen frissítés · az utoljára látott adatokat mutatjuk. Ellenőrizd a kapcsolatot vagy a bejelentkezést.','⚠ Refresh failed · showing last-known data. Check the connection or sign-in.','⚠ Aktualisierung fehlgeschlagen · zuletzt bekannte Daten. Verbindung oder Anmeldung prüfen.'))?>;
let busy=false;setInterval(async()=>{if(document.hidden||busy)return;busy=true;const c=new AbortController(),timer=setTimeout(()=>c.abort(),8000);try{const response=await fetch(location.pathname,{cache:'no-store',credentials:'same-origin',signal:c.signal});if(!response.ok)throw Error();const doc=new DOMParser().parseFromString(await response.text(),'text/html');const part=doc.getElementById('fms-last'),current=document.getElementById('fms-last'),nextRun=doc.getElementById('fms-run'),oldRun=document.getElementById('fms-run');if(!part||!current||!nextRun||!oldRun)throw Error('Missing selective status');current.replaceWith(part);for(const selector of ['[data-fms-status-card]','[data-fms-space-card]']){const next=doc.querySelector(selector),old=document.querySelector(selector);if(next&&old)old.replaceWith(next);}oldRun.disabled=nextRun.disabled;const status=document.getElementById('fms-refresh-state');if(status&&status.textContent!==freshLabel)status.textContent=freshLabel;tick();}catch{const status=document.getElementById('fms-refresh-state');if(status&&status.textContent!==staleLabel)status.textContent=staleLabel;const run=document.getElementById('fms-run');if(run)run.disabled=true;}finally{clearTimeout(timer);busy=false;}},5000);
})();</script>
]]></INLINE></FILE>
