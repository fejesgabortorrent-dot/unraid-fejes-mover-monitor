$raw=@file_get_contents($path);$error='';$message='';$report=null;$days=7;$ratioTarget=0;$batchGiB=16;
try {
 if(is_link($path)||($raw===false&&file_exists($path)))throw new RuntimeException('Configuration unavailable');
 if($raw!==false){$settings=json_decode($raw,true,512,JSON_THROW_ON_ERROR);if(($settings['version']??null)!==1||!in_array($settings['age_days']??null,[1,7,14,30],true))throw new RuntimeException('Invalid configuration');$days=$settings['age_days'];$batchGiB=$settings['batch_gib']??16;if(!in_array($batchGiB,[16,32,64,128],true))throw new RuntimeException('Invalid batch size');$ratioTarget=$settings['ratio_target']??0;if((!is_int($ratioTarget)&&!is_float($ratioTarget))||!is_finite((float)$ratioTarget)||$ratioTarget<0||$ratioTarget>100)throw new RuntimeException('Invalid ratio target');}
 if(($_SERVER['REQUEST_METHOD']??'GET')==='POST'){
  if($fmc['error']||$fmc['mode']!=='advanced'||$fmc['pool']!=='cache'||!$fmc['mounted'])throw new RuntimeException('Advanced cache mode required');
  if(!is_string($_POST['fejes_csrf']??null)||!is_string($fmc['token'])||$fmc['token']===''||!hash_equals($fmc['token'],$_POST['fejes_csrf']))throw new RuntimeException('Invalid session');
  $action=$_POST['fms_action']??$_POST['action']??null;
  if($action==='save'){
   $new=$_POST['age_days']??null;if(!is_string($new)||!in_array($new,['1','7','14','30'],true))throw new RuntimeException('Invalid age');
   $batch=$_POST['batch_gib']??(string)$batchGiB;if(!is_string($batch)||!in_array($batch,['16','32','64','128'],true))throw new RuntimeException('Invalid batch size');
   $ratio=$_POST['ratio_target']??(string)$ratioTarget;if(!is_string($ratio)||!preg_match('/^(?:[0-9]{1,3})(?:\.[0-9]{1,2})?$/D',$ratio)||(float)$ratio>100)throw new RuntimeException('Invalid ratio target');
   $lock=fopen('/var/run/fejes-selective-inventory.lock','c');if(!$lock||!flock($lock,LOCK_EX|LOCK_NB))throw new RuntimeException('Busy');
   try {
    $current=@file_get_contents($path);if($current!==$raw||!is_string($_POST['source_hash']??null)||!hash_equals(hash('sha256',$raw===false?'':$raw),$_POST['source_hash']))throw new RuntimeException('Configuration changed');
    $data=json_encode(array_replace($settings??[],['version'=>1,'age_days'=>(int)$new,'ratio_target'=>(float)$ratio,'batch_gib'=>(int)$batch]),JSON_THROW_ON_ERROR)."\n";
    if($data!==$raw){
     if($raw!==false){$backup=$path.'.before-'.date('Ymd-His').'-'.bin2hex(random_bytes(3));if(file_put_contents($backup,$raw,LOCK_EX)!==strlen($raw)||file_get_contents($backup)!==$raw)throw new RuntimeException('Backup failed');}
     $tmp=tempnam(dirname($path),'.selective-');if(!$tmp)throw new RuntimeException('Save failed');
     try{if(!chmod($tmp,0600)||file_put_contents($tmp,$data)!==strlen($data)||file_get_contents($tmp)!==$data||!rename($tmp,$path))throw new RuntimeException('Save failed');}finally{if(is_file($tmp))unlink($tmp);}
     if(file_get_contents($path)!==$data)throw new RuntimeException('Readback failed');$raw=$data;
    }
    $days=(int)$new;$ratioTarget=(float)$ratio;$batchGiB=(int)$batch;$message=$t('A mozgatás korhatára elmentve.','Movement age saved.','Verschiebealter gespeichert.');
   }finally{flock($lock,LOCK_UN);fclose($lock);}
  }elseif(in_array($action,['preview','observe','run'],true)){
   if(!is_string($_POST['source_hash']??null)||!hash_equals(hash('sha256',$raw===false?'':$raw),$_POST['source_hash']))throw new RuntimeException('Configuration changed');
   $cmd='python3 /boot/config/plugins/fejes.mover.monitor/tools/selective_mover.py '.($action==='run'?'start':$action);
   exec('timeout 60 '.$cmd.' 2>/dev/null',$lines,$code);
   if($code!==0)throw new RuntimeException('Worker unavailable');
   $report=json_decode(implode("\n",$lines),true,512,JSON_THROW_ON_ERROR);
   if(!is_array($report))throw new RuntimeException('Invalid report');
   if($action==='run')$message=$t('Indítási kérés elküldve. A háttérfolyamat minden védelmet újraellenőriz; ez még nem jelent fájlmozgatást.','Start requested. The worker rechecks every guard; this does not yet mean files were moved.','Start angefordert. Der Prozess prüft alle Schutzbedingungen erneut; dies bestätigt noch keine Verschiebung.');
  }else throw new RuntimeException('Invalid action');
 }
}catch(Throwable $exception){$error=$t('A kérés nem teljesült. Ellenőrizd az állapotot; új mozgatást nem igazoltunk.','Request failed. Check status; no new movement has been confirmed.','Anfrage fehlgeschlagen. Status prüfen; keine neue Verschiebung bestätigt.');}
