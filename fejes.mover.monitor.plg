<?php
$fmRead=static fn($p)=>@file_get_contents($p)?:'';
$fmEsc=static fn($s)=>htmlspecialchars((string)$s,ENT_QUOTES|ENT_SUBSTITUTE,'UTF-8');
$fmRaw=trim($fmRead('/var/run/mover.pid'));$fmPid=ctype_digit($fmRaw)?(int)$fmRaw:0;
$fmCmd=$fmPid?str_replace(chr(0),' ',$fmRead("/proc/$fmPid/cmdline")):'';
$fmRun=$fmPid>1&&preg_match('~(?:^|[ /])mover(?: |$)~',$fmCmd);
$fmIds=[];$fmFiles=[];
if($fmRun){
$fmIds[$fmPid]=true;$fmParents=[];
foreach(glob('/proc/[0-9]*/status')?:[] as $p){$s=$fmRead($p);if(preg_match('/^Pid:\s+(\d+)/m',$s,$a)&&preg_match('/^PPid:\s+(\d+)/m',$s,$b))$fmParents[(int)$a[1]]=(int)$b[1];}
do{$add=false;foreach($fmParents as $p=>$parent)if(isset($fmIds[$parent])&&!isset($fmIds[$p])){$fmIds[$p]=true;$add=true;}}while($add);
foreach($fmIds as $p=>$_)foreach(glob("/proc/$p/fd/*")?:[] as $fd){
$path=@readlink($fd);if(!$path||!str_starts_with($path,'/mnt/')||str_ends_with($path,' (deleted)'))continue;
$st=@stat($fd);if(!$st||(($st['mode']&0170000)!==0100000))continue;
$info=$fmRead("/proc/$p/fdinfo/".basename($fd));preg_match('/^pos:\s+(\d+)/m',$info,$pos);preg_match('/^flags:\s+([0-7]+)/m',$info,$fl);
$fmFiles[]=['path'=>$path,'pos'=>(int)($pos[1]??0),'size'=>$st['size'],'mode'=>isset($fl[1])?(octdec($fl[1])&3):-1];if(count($fmFiles)>=40)break 2;
}}
$fmTotal=is_dir('/mnt/cache')?@disk_total_space('/mnt/cache'):false;$fmFree=is_dir('/mnt/cache')?@disk_free_space('/mnt/cache'):false;
$fmUsed=$fmTotal&&$fmFree!==false?round(100*(1-$fmFree/$fmTotal),1):null;
$fmScript=$fmRead('/boot/config/plugins/user.scripts/scripts/Filmek_Mover_Threshold/script');preg_match('/^KUSZOB_GIB=(\d+)/m',$fmScript,$fmMatch);$fmThreshold=$fmMatch[1]??null;
$fmGiB=static fn($n)=>number_format($n/1073741824,1,',',' ');
$fmTail=static function($path,$limit){$f=@fopen($path,'rb');if(!$f)return '';$sz=fstat($f)['size'];$offset=max(0,$sz-$limit);fseek($f,$offset);$s=stream_get_contents($f);fclose($f);if($offset){$nl=strpos($s,"\n");$s=$nl===false?'':substr($s,$nl+1);}return $s;};
$fmLines=preg_split('/\r?\n/',$fmTail('/var/log/syslog',262144));$fmLines=array_filter($fmLines,static fn($s)=>preg_match('/\bmover(?:\[|:| )|Filmek Mover/i',$s));$fmLog=implode("\n",array_slice($fmLines,-30));
$fmScriptLog=$fmTail('/tmp/user.scripts/tmpScripts/Filmek_Mover_Threshold/log.txt',8192);
?>
<style>
#fm-monitor{max-width:1160px;margin:24px auto;padding:0 18px;font-size:15px}#fm-monitor h2{font-size:28px;margin:0 0 8px}#fm-monitor .fm-sub{opacity:.7;margin-bottom:24px}#fm-monitor .fm-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:16px}#fm-monitor .fm-card{border:1px solid #7775;border-radius:12px;padding:20px;margin-bottom:18px;background:#88808}#fm-monitor .fm-label{opacity:.7;font-size:13px;margin-bottom:12px}#fm-monitor .fm-value{font-size:25px;line-height:1.4}#fm-monitor progress{width:100%;height:18px;accent-color:#64b99b;margin-top:14px}#fm-monitor pre{white-space:pre-wrap;overflow-wrap:anywhere;max-height:260px;overflow:auto;font-size:12px;line-height:1.6;background:transparent}#fm-monitor table{width:100%;table-layout:fixed}#fm-monitor th,#fm-monitor td{text-align:left;padding:10px 6px;overflow-wrap:anywhere;border-bottom:1px solid #8884}#fm-monitor th:first-child{width:58%}#fm-monitor .fm-note{font-size:13px;opacity:.75;line-height:1.6}#fm-monitor button{margin-bottom:18px;padding:9px 14px}#fm-error{color:#ef967a;min-height:20px}
#fm-monitor .fm-flow{display:flex;align-items:center;justify-content:space-around;gap:12px;border:1px solid #659ed050;background:linear-gradient(110deg,#3996d51a,#64b99b18);border-radius:14px;padding:25px 12px;font-size:18px;font-weight:600}#fm-monitor .fm-flow b{font-size:30px;color:#888}#fm-monitor .fm-flow .fm-moving{color:#f2b84b;animation:fm-pulse 1s infinite alternate}#fm-monitor .fm-grid .fm-card:nth-child(1){border-top:3px solid #64b99b}#fm-monitor .fm-grid .fm-card:nth-child(2){border-top:3px solid #519bce}#fm-monitor .fm-grid .fm-card:nth-child(3){border-top:3px solid #c6a36d}#fm-monitor .fm-donut{width:110px;height:110px;border-radius:50%;display:grid;place-items:center;margin:10px auto;background:conic-gradient(#519bce calc(var(--used)*1%),#7773 0)}#fm-monitor .fm-donut span{display:grid;place-items:center;width:85px;height:85px;background:#20252b;color:#eee;border-radius:50%;font-size:24px}@keyframes fm-pulse{from{opacity:.3}to{opacity:1}}@media(max-width:600px){#fm-monitor .fm-flow{font-size:12px;gap:4px;padding:18px 8px}}@media(prefers-reduced-motion:reduce){#fm-monitor .fm-moving{animation:none!important}}</style>
<div id="fm-monitor" data-running="<?=$fmRun?1:0?>" data-uncertain="<?=$fmRaw&&!$fmRun?1:0?>" data-used="<?=$fmUsed??0?>" data-free="<?=$fmFree!==false?$fmGiB($fmFree):'—'?>">
<h2>Mover figyelő</h2><p class="fm-sub">FejesNAS · Élő állapot · Csak megfigyelés</p>
<a href="/Tools/FejesMoverProtection" style="display:inline-block;margin-right:16px">🛡 Összehangolt védelem</a><a href="/Tools/FejesMoverSettings" style="display:inline-block;margin-right:16px;color:#64c7ff">⚙ Beállítások</a><button type="button" id="fm-toggle">Automatikus frissítés: BE (5 mp)</button> <span>Adatok ideje: <?=date('Y-m-d H:i:s')?></span><div id="fm-error" role="status"></div>
<div class="fm-flow"><span>▣ CACHE / SSD</span><b class="<?=$fmRun?'fm-moving':''?>">➜</b><span>⇄ MOVER</span><b class="<?=$fmRun?'fm-moving':''?>">➜</b><span>▤ LEMEZTÖMB</span></div><p class="fm-note">Cache / lemeztömb szemléltetés; a tényleges irány megosztásonként eltérhet · <?=$fmRun?'A mover aktív.':'Jelenleg várakozik.'?></p><div class="fm-grid">
<section class="fm-card"><div class="fm-label">MOVER ÁLLAPOTA</div><div class="fm-value" style="color:<?=$fmRun?'#f2b84b':'#64b99b'?>"><?=$fmRun?'● Mover fut':($fmRaw?'⚠ Nem ellenőrizhető PID':'● Nem fut')?></div><p><?=$fmRun?count($fmIds).' kapcsolódó folyamat · PID '.$fmPid:'Jelenleg nincs igazolt aktív mozgatás.'?></p></section>
<section class="fm-card"><div class="fm-label">CACHE FOGLALTSÁGA</div><div class="fm-donut" style="--used:<?=$fmUsed??0?>"><span><?=$fmUsed!==null?$fmUsed.'%':'—'?></span></div><?php if($fmUsed!==null):?><progress max="100" value="<?=$fmUsed?>"></progress><p><?=$fmGiB($fmTotal-$fmFree)?> / <?=$fmGiB($fmTotal)?> GiB<br>Szabad: <?=$fmGiB($fmFree)?> GiB</p><?php endif?></section>
<section class="fm-card"><div class="fm-label">MEGLÉVŐ SCRIPT INDÍTÁSI KÜSZÖBE</div><div class="fm-value"><?=$fmThreshold!==null?$fmThreshold.' GiB alatt':'Nem olvasható'?></div><p><?=$fmFree!==false&&$fmThreshold!==null?($fmFree/1073741824>=$fmThreshold?'A szabad hely most a küszöb felett van.':'A szabad hely a küszöb alatt van. A script további feltételeket is ellenőriz.'):'A küszöb nem ellenőrizhető.'?></p></section>
</div>
<section class="fm-card"><h3>Éppen megnyitott fájlok</h3>
<?php if($fmFiles):?><table><thead><tr><th>Fájl / hely</th><th>Művelet</th><th>Fájlpozíció / méret</th></tr></thead><tbody><?php foreach($fmFiles as $f):?><tr><td><?=$fmEsc($f['path'])?></td><td><?=(['Olvasás','Írás','Olvasás és írás'][$f['mode']]??'Ismeretlen')?></td><td><?=$fmGiB($f['pos'])?> / <?=$fmGiB($f['size'])?> GiB</td></tr><?php endforeach?></tbody></table><?php else:?><p><?=$fmRun?'A mover fut, de most nincs megfigyelhető nyitott adatfájl. Lehet, hogy keres vagy várakozik.':'Várakozás a következő mover-futásra.'?></p><?php endif?>
<p class="fm-note">A mover és gyermekfolyamatai nyitott fájljainak pillanatképe. A fájlpozíció nem igazolja a mozgatás befejezését. A teljes hátralévő mennyiség, sebesség és befejezési idő ebből az adatforrásból nem állapítható meg megbízhatóan.</p></section>
<section class="fm-card"><h3>Legutóbbi mover-naplóbejegyzések</h3><pre><?=$fmEsc($fmLog?:'A rendszernapló utolsó 256 KiB-os részében nincs mover-bejegyzés. Ez önmagában nem hiba; a korábbi futások vagy a részletes fájlnaplózás nem feltétlenül érhetők el.')?></pre></section>
<?php if($fmScriptLog):?><section class="fm-card"><h3>Filmek Mover · legutóbbi scriptnapló</h3><pre><?=$fmEsc($fmScriptLog)?></pre></section><?php endif?>
<p class="fm-note">A figyelő a folyamatokat, a cache szabad helyét és a meglévő naplókat olvassa. A mozgatást a meglévő Unraid-beállítások és esetleges saját scripted vezérlik. Ez a kiadás cache nevű poolt figyel. Frissítés csak a lap megnyitása közben történik.</p></div>
<script>
(()=>{let enabled=true,busy=false;if(window.fejesMoverTimer)clearInterval(window.fejesMoverTimer);function bind(){document.getElementById('fm-toggle').onclick=()=>{enabled=!enabled;document.getElementById('fm-toggle').textContent='Automatikus frissítés: '+(enabled?'BE (5 mp)':'SZÜNET');};}bind();window.fejesMoverTimer=setInterval(async()=>{if(!enabled||busy||document.hidden)return;busy=true;const c=new AbortController(),t=setTimeout(()=>c.abort(),8000);try{const r=await fetch(location.href,{cache:'no-store',credentials:'same-origin',signal:c.signal});if(!r.ok)throw Error();const doc=new DOMParser().parseFromString(await r.text(),'text/html'),part=doc.getElementById('fm-monitor');if(!part)throw Error();document.getElementById('fm-monitor').replaceWith(part);bind();}catch(e){document.getElementById('fm-error').textContent='A frissítés sikertelen. A kijelzett adatok elavultak; ellenőrizd a kapcsolatot vagy a bejelentkezést.';}finally{clearTimeout(t);busy=false;}},5000);})();
</script>


]]></INLINE></FILE>
<FILE Name="/tmp/fejes-mover-monitor-2026.10.18/FejesMoverProtection.page"><INLINE><![CDATA[Menu="Utilities"
Title="FejesMover védelem"
Icon="fa-shield"
