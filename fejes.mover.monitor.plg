<script>
(()=>{let enabled=true,busy=false;if(window.fejesMoverTimer)clearInterval(window.fejesMoverTimer);function bind(){const button=document.getElementById('fm-toggle');button.textContent='Auto-refresh: '+(enabled?'ON (5 sec)':'PAUSED');button.onclick=()=>{enabled=!enabled;bind();};}bind();window.fejesMoverTimer=setInterval(async()=>{if(!enabled||busy||document.hidden)return;busy=true;const c=new AbortController(),t=setTimeout(()=>c.abort(),8000);try{const r=await fetch(location.href,{cache:'no-store',credentials:'same-origin',signal:c.signal});if(!r.ok)throw Error();const doc=new DOMParser().parseFromString(await r.text(),'text/html'),part=doc.getElementById('fm-monitor');if(!part)throw Error();document.getElementById('fm-monitor').replaceWith(part);bind();}catch(e){document.getElementById('fm-error').textContent='Refresh failed. Displayed data is stale; check the connection or sign-in status.';}finally{clearTimeout(t);busy=false;}},5000);})();
</script>



