<?php
$fmCookie=$_COOKIE['fejes_mover_lang']??'hu';
$fmLang=is_string($fmCookie)&&in_array($fmCookie,['hu','en','de'],true)?$fmCookie:'hu';
$fmLanguageSelector="<label style=\"display:inline-block;margin:10px 12px;font-size:14px\">🌐 <select aria-label=\"Language / Nyelv / Sprache\" onchange=\"document.cookie='fejes_mover_lang='+this.value+'; Path=/; Max-Age=31536000; SameSite=Lax';location.assign(location.pathname)\"><option value=\"hu\" HU_SELECTED>Magyar</option><option value=\"en\" EN_SELECTED>English (US)</option><option value=\"de\" DE_SELECTED>Deutsch</option></select></label>";
$fmLanguageSelector=str_replace(['HU_SELECTED','EN_SELECTED','DE_SELECTED'],[$fmLang==='hu'?'selected':'',$fmLang==='en'?'selected':'',$fmLang==='de'?'selected':''],$fmLanguageSelector);
if($fmLang==='en'){ ?>
<?php
echo $fmLanguageSelector;
$fmMounted=(static function(){foreach(explode("\n",@file_get_contents('/proc/self/mountinfo')?:'') as $line){$fields=explode(' ',$line);if(($fields[4]??'')==='/mnt/cache')return true;}return false;})();
$fmRead=static fn($p)=>@file_get_contents($p)?:'';
$fmEsc=static fn($s)=>htmlspecialchars((string)$s,ENT_QUOTES|ENT_SUBSTITUTE,'UTF-8');
$fmRaw=trim($fmRead('/var/run/mover.pid'));$fmPid=ctype_digit($fmRaw)?(int)$fmRaw:0;
$fmCmd=$fmPid?str_replace(chr(0),' ',$fmRead("/proc/$fmPid/cmdline")):'';
$fmRun=$fmPid>1&&preg_match('~(?:^|[ /])mover(?: |$)~',$fmCmd);
$fmIds=[];$fmFiles=[];
if($fmRun){
$fmIds[$fmPid]=true;$fmParents=[];
foreach(glob('/proc/[0-9]*/status')?:[] as $p){$s=$fmRead($p);if(preg_match('/^Pid:\s+(\d+)/m',$s,$a)&&preg_match('/^PPid:\s+(\d+)/m',$s,$b))$fmParents[(int)$a[1]]=(int)$b[1];}
do{$add=false;foreach($fmParents as $p=>$parent)if(isset($fmIds[$parent])&&!isset($fmIds[$p])){$fmIds[$p]=true;$add=true;}}while($add);
foreach($fmIds as $p=>$_)foreach(glob("/proc/$p/fd/*")?:[] as $fd){
$path=@readlink($fd);if(!$path||!str_starts_with($path,'/mnt/')||str_ends_with($path,' (deleted)'))continue;
$st=@stat($fd);if(!$st||(($st['mode']&0170000)!==0100000))continue;
$info=$fmRead("/proc/$p/fdinfo/".basename($fd));preg_match('/^pos:\s+(\d+)/m',$info,$pos);preg_match('/^flags:\s+([0-7]+)/m',$info,$fl);
$fmFiles[]=['path'=>$path,'pos'=>(int)($pos[1]??0),'size'=>$st['size'],'mode'=>isset($fl[1])?(octdec($fl[1])&3):-1];if(count($fmFiles)>=40)break 2;
}}
$fmTotal=$fmMounted?@disk_total_space('/mnt/cache'):false;$fmFree=$fmMounted?@disk_free_space('/mnt/cache'):false;
$fmUsed=$fmTotal&&$fmFree!==false?round(100*(1-$fmFree/$fmTotal),1):null;
$fmScript=$fmRead('/boot/config/plugins/user.scripts/scripts/Filmek_Mover_Threshold/script');preg_match('/^KUSZOB_GIB=(\d+)/m',$fmScript,$fmMatch);$fmThreshold=$fmMatch[1]??null;
$fmGiB=static fn($n)=>number_format($n/1073741824,1,'.',',');
$fmTail=static function($path,$limit){$f=@fopen($path,'rb');if(!$f)return '';$sz=fstat($f)['size'];$offset=max(0,$sz-$limit);fseek($f,$offset);$s=stream_get_contents($f);fclose($f);if($offset){$nl=strpos($s,"\n");$s=$nl===false?'':substr($s,$nl+1);}return $s;};
$fmLines=preg_split('/\r?\n/',$fmTail('/var/log/syslog',262144));$fmLines=array_filter($fmLines,static fn($s)=>preg_match('/\bmover(?:\[|:| )|Filmek Mover/i',$s));$fmLog=implode("\n",array_slice($fmLines,-30));
$fmScriptLog=$fmTail('/tmp/user.scripts/tmpScripts/Filmek_Mover_Threshold/log.txt',8192);
?>
<style>
#fm-monitor{max-width:1160px;margin:24px auto;padding:0 18px;font-size:15px}#fm-monitor h2{font-size:28px;margin:0 0 8px}#fm-monitor .fm-sub{opacity:.7;margin-bottom:24px}#fm-monitor .fm-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:16px}#fm-monitor .fm-card{border:1px solid #7775;border-radius:12px;padding:20px;margin-bottom:18px;background:#88808}#fm-monitor .fm-label{opacity:.7;font-size:13px;margin-bottom:12px}#fm-monitor .fm-value{font-size:25px;line-height:1.4}#fm-monitor progress{width:100%;height:18px;accent-color:#64b99b;margin-top:14px}#fm-monitor pre{white-space:pre-wrap;overflow-wrap:anywhere;max-height:260px;overflow:auto;font-size:12px;line-height:1.6;background:transparent}#fm-monitor table{width:100%;table-layout:fixed}#fm-monitor th,#fm-monitor td{text-align:left;padding:10px 6px;overflow-wrap:anywhere;border-bottom:1px solid #8884}#fm-monitor th:first-child{width:58%}#fm-monitor .fm-note{font-size:13px;opacity:.75;line-height:1.6}#fm-monitor button{margin-bottom:18px;padding:9px 14px}#fm-error{color:#ef967a;min-height:20px}
#fm-monitor .fm-flow{display:flex;align-items:center;justify-content:space-around;gap:12px;border:1px solid #659ed050;background:linear-gradient(110deg,#3996d51a,#64b99b18);border-radius:14px;padding:25px 12px;font-size:18px;font-weight:600}#fm-monitor .fm-flow b{font-size:30px;color:#888}#fm-monitor .fm-flow .fm-moving{color:#f2b84b;animation:fm-pulse 1s infinite alternate}#fm-monitor .fm-grid .fm-card:nth-child(1){border-top:3px solid #64b99b}#fm-monitor .fm-grid .fm-card:nth-child(2){border-top:3px solid #519bce}#fm-monitor .fm-grid .fm-card:nth-child(3){border-top:3px solid #c6a36d}#fm-monitor .fm-donut{width:110px;height:110px;border-radius:50%;display:grid;place-items:center;margin:10px auto;background:conic-gradient(#519bce calc(var(--used)*1%),#7773 0)}#fm-monitor .fm-donut span{display:grid;place-items:center;width:85px;height:85px;background:#20252b;color:#eee;border-radius:50%;font-size:24px}@keyframes fm-pulse{from{opacity:.3}to{opacity:1}}@media(max-width:600px){#fm-monitor .fm-flow{font-size:12px;gap:4px;padding:18px 8px}}@media(prefers-reduced-motion:reduce){#fm-monitor .fm-moving{animation:none!important}}
/* Compact panels that inherit the surrounding Unraid page typography. */
#fm-monitor{font:inherit;max-width:1160px;margin:20px auto;padding:0 16px}
#fm-monitor h2{font-size:24px;font-weight:600;margin:0 0 6px}
#fm-monitor h3{font-size:17px;font-weight:600;margin:0 0 14px}
#fm-monitor .fm-sub{margin-bottom:18px}
#fm-monitor .fm-card{background:transparent;border:1px solid #8885;border-radius:4px;padding:18px;margin-bottom:16px}
#fm-monitor .fm-label{font-size:12px;letter-spacing:.7px;font-weight:600}
#fm-monitor .fm-value{font-size:23px}
#fm-monitor .fm-flow{border-radius:4px;background:#88808;border:1px solid #8885;padding:18px 12px;font-size:16px}
#fm-monitor .fm-grid .fm-card:nth-child(n){border-top:2px solid #ef7d00}
#fm-monitor .fm-donut{background:conic-gradient(#ef7d00 calc(var(--used)*1%),#7773 0)}
#fm-monitor .fm-donut span{background:#252525}
#fm-monitor progress{accent-color:#ef7d00;height:12px}
#fm-monitor button{font:inherit;padding:7px 12px;border:1px solid #8887;border-radius:3px;background:transparent;color:inherit;cursor:pointer}
#fm-monitor button:hover{border-color:#ef7d00}
#fm-monitor button:focus-visible{outline:2px solid #ef7d00;outline-offset:3px}
#fm-monitor .fm-note{font-size:12px}
</style>
<div id="fm-monitor" data-running="<?=$fmRun?1:0?>" data-uncertain="<?=$fmRaw&&!$fmRun?1:0?>" data-available="<?=$fmUsed!==null?1:0?>" data-used="<?=$fmUsed??0?>" data-free="<?=$fmFree!==false?$fmGiB($fmFree):'—'?>">
<h2>Mover Monitor</h2><p class="fm-sub">FejesNAS · Live status · Monitoring only</p>
<a href="/Tools/FejesMoverSettings" style="display:inline-block;margin-right:16px;color:#64c7ff">⚙ Settings</a><button type="button" id="fm-toggle">Auto-refresh: ON (5 sec)</button> <span>Data timestamp: <?=date('Y-m-d H:i:s')?></span><div id="fm-error" role="status"></div>
<div class="fm-flow"><span>▣ CACHE / SSD</span><b class="<?=$fmRun?'fm-moving':''?>">➜</b><span>⇄ MOVER</span><b class="<?=$fmRun?'fm-moving':''?>">➜</b><span>▤ ARRAY</span></div><p class="fm-note">Cache / array illustration; actual direction may vary by share · <?=$fmRun?'Mover is active.':'Currently idle.'?></p><div class="fm-grid">
<section class="fm-card"><div class="fm-label">MOVER STATUS</div><div class="fm-value" style="color:<?=$fmRun?'#f2b84b':'#64b99b'?>"><?=$fmRun?'● Mover running':($fmRaw?'⚠ Unverified PID':'● Not running')?></div><p><?=$fmRun?count($fmIds).' related processes · PID '.$fmPid:'No active transfer is currently confirmed.'?></p></section>
<section class="fm-card"><div class="fm-label">CACHE USAGE</div><div class="fm-donut" style="--used:<?=$fmUsed??0?>"><span><?=$fmUsed!==null?$fmUsed.'%':'—'?></span></div><?php if($fmUsed!==null):?><progress max="100" value="<?=$fmUsed?>"></progress><p><?=$fmGiB($fmTotal-$fmFree)?> / <?=$fmGiB($fmTotal)?> GiB<br>Free: <?=$fmGiB($fmFree)?> GiB</p><?php endif?></section>
<section class="fm-card"><div class="fm-label">EXISTING SCRIPT START THRESHOLD</div><div class="fm-value"><?=$fmThreshold!==null?$fmThreshold.' GiB threshold':'Unavailable'?></div><p><?=$fmFree!==false&&$fmThreshold!==null?($fmFree/1073741824>=$fmThreshold?'Free space is currently above the threshold.':'Free space is below the threshold. The script checks additional conditions.'):'The threshold cannot be verified.'?></p></section>
</div>
<section class="fm-card"><h3>Currently open files</h3>
<?php if($fmFiles):?><table><thead><tr><th>File / location</th><th>Operation</th><th>File position / size</th></tr></thead><tbody><?php foreach($fmFiles as $f):?><tr><td><?=$fmEsc($f['path'])?></td><td><?=(['Read','Write','Read and write'][$f['mode']]??'Unknown')?></td><td><?=$fmGiB($f['pos'])?> / <?=$fmGiB($f['size'])?> GiB</td></tr><?php endforeach?></tbody></table><?php else:?><p><?=$fmRun?'Mover is running, but no open data file is visible right now. It may be scanning or waiting.':'Waiting for the next Mover run.'?></p><?php endif?>
<p class="fm-note">Snapshot of files opened by Mover and its child processes. File position does not confirm transfer completion. Remaining data, speed and completion time cannot be reliably determined from this source.</p></section>
<section class="fm-card"><h3>Recent Mover log entries</h3><pre><?=$fmEsc($fmLog?:'No Mover entries in the last 256 KiB of syslog. This alone is not an error; earlier runs or detailed file logs may be unavailable.')?></pre></section>
<?php if($fmScriptLog):?><section class="fm-card"><h3>Filmek Mover · latest script log</h3><pre><?=$fmEsc($fmScriptLog)?></pre></section><?php endif?>
<p class="fm-note">The monitor reads processes, cache free space and existing logs. Existing Unraid settings and any custom script control transfers. This release monitors a pool named cache. Refresh runs only while the page is open.</p></div>
<script>
(()=>{let enabled=true,busy=false;if(window.fejesMoverTimer)clearInterval(window.fejesMoverTimer);function bind(){const button=document.getElementById('fm-toggle');button.textContent='Auto-refresh: '+(enabled?'ON (5 sec)':'PAUSED');button.onclick=()=>{enabled=!enabled;bind();};}bind();window.fejesMoverTimer=setInterval(async()=>{if(!enabled||busy||document.hidden)return;busy=true;const c=new AbortController(),t=setTimeout(()=>c.abort(),8000);try{const r=await fetch(location.href,{cache:'no-store',credentials:'same-origin',signal:c.signal});if(!r.ok)throw Error();const doc=new DOMParser().parseFromString(await r.text(),'text/html'),part=doc.getElementById('fm-monitor');if(!part)throw Error();document.getElementById('fm-monitor').replaceWith(part);bind();}catch(e){document.getElementById('fm-error').textContent='Refresh failed. Displayed data is stale; check the connection or sign-in status.';}finally{clearTimeout(t);busy=false;}},5000);})();
</script>



<?php } elseif($fmLang==='de'){ ?>
<?php
echo $fmLanguageSelector;
$fmMounted=(static function(){foreach(explode("\n",@file_get_contents('/proc/self/mountinfo')?:'') as $line){$fields=explode(' ',$line);if(($fields[4]??'')==='/mnt/cache')return true;}return false;})();
$fmRead=static fn($p)=>@file_get_contents($p)?:'';
$fmEsc=static fn($s)=>htmlspecialchars((string)$s,ENT_QUOTES|ENT_SUBSTITUTE,'UTF-8');
$fmRaw=trim($fmRead('/var/run/mover.pid'));$fmPid=ctype_digit($fmRaw)?(int)$fmRaw:0;
$fmCmd=$fmPid?str_replace(chr(0),' ',$fmRead("/proc/$fmPid/cmdline")):'';
$fmRun=$fmPid>1&&preg_match('~(?:^|[ /])mover(?: |$)~',$fmCmd);
$fmIds=[];$fmFiles=[];
if($fmRun){
$fmIds[$fmPid]=true;$fmParents=[];
foreach(glob('/proc/[0-9]*/status')?:[] as $p){$s=$fmRead($p);if(preg_match('/^Pid:\s+(\d+)/m',$s,$a)&&preg_match('/^PPid:\s+(\d+)/m',$s,$b))$fmParents[(int)$a[1]]=(int)$b[1];}
do{$add=false;foreach($fmParents as $p=>$parent)if(isset($fmIds[$parent])&&!isset($fmIds[$p])){$fmIds[$p]=true;$add=true;}}while($add);
foreach($fmIds as $p=>$_)foreach(glob("/proc/$p/fd/*")?:[] as $fd){
$path=@readlink($fd);if(!$path||!str_starts_with($path,'/mnt/')||str_ends_with($path,' (deleted)'))continue;
$st=@stat($fd);if(!$st||(($st['mode']&0170000)!==0100000))continue;
$info=$fmRead("/proc/$p/fdinfo/".basename($fd));preg_match('/^pos:\s+(\d+)/m',$info,$pos);preg_match('/^flags:\s+([0-7]+)/m',$info,$fl);
$fmFiles[]=['path'=>$path,'pos'=>(int)($pos[1]??0),'size'=>$st['size'],'mode'=>isset($fl[1])?(octdec($fl[1])&3):-1];if(count($fmFiles)>=40)break 2;
}}
$fmTotal=$fmMounted?@disk_total_space('/mnt/cache'):false;$fmFree=$fmMounted?@disk_free_space('/mnt/cache'):false;
$fmUsed=$fmTotal&&$fmFree!==false?round(100*(1-$fmFree/$fmTotal),1):null;
$fmScript=$fmRead('/boot/config/plugins/user.scripts/scripts/Filmek_Mover_Threshold/script');preg_match('/^KUSZOB_GIB=(\d+)/m',$fmScript,$fmMatch);$fmThreshold=$fmMatch[1]??null;
$fmGiB=static fn($n)=>number_format($n/1073741824,1,',',' ');
$fmTail=static function($path,$limit){$f=@fopen($path,'rb');if(!$f)return '';$sz=fstat($f)['size'];$offset=max(0,$sz-$limit);fseek($f,$offset);$s=stream_get_contents($f);fclose($f);if($offset){$nl=strpos($s,"\n");$s=$nl===false?'':substr($s,$nl+1);}return $s;};
$fmLines=preg_split('/\r?\n/',$fmTail('/var/log/syslog',262144));$fmLines=array_filter($fmLines,static fn($s)=>preg_match('/\bmover(?:\[|:| )|Filmek Mover/i',$s));$fmLog=implode("\n",array_slice($fmLines,-30));
$fmScriptLog=$fmTail('/tmp/user.scripts/tmpScripts/Filmek_Mover_Threshold/log.txt',8192);
?>
<style>
#fm-monitor{max-width:1160px;margin:24px auto;padding:0 18px;font-size:15px}#fm-monitor h2{font-size:28px;margin:0 0 8px}#fm-monitor .fm-sub{opacity:.7;margin-bottom:24px}#fm-monitor .fm-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:16px}#fm-monitor .fm-card{border:1px solid #7775;border-radius:12px;padding:20px;margin-bottom:18px;background:#88808}#fm-monitor .fm-label{opacity:.7;font-size:13px;margin-bottom:12px}#fm-monitor .fm-value{font-size:25px;line-height:1.4}#fm-monitor progress{width:100%;height:18px;accent-color:#64b99b;margin-top:14px}#fm-monitor pre{white-space:pre-wrap;overflow-wrap:anywhere;max-height:260px;overflow:auto;font-size:12px;line-height:1.6;background:transparent}#fm-monitor table{width:100%;table-layout:fixed}#fm-monitor th,#fm-monitor td{text-align:left;padding:10px 6px;overflow-wrap:anywhere;border-bottom:1px solid #8884}#fm-monitor th:first-child{width:58%}#fm-monitor .fm-note{font-size:13px;opacity:.75;line-height:1.6}#fm-monitor button{margin-bottom:18px;padding:9px 14px}#fm-error{color:#ef967a;min-height:20px}
#fm-monitor .fm-flow{display:flex;align-items:center;justify-content:space-around;gap:12px;border:1px solid #659ed050;background:linear-gradient(110deg,#3996d51a,#64b99b18);border-radius:14px;padding:25px 12px;font-size:18px;font-weight:600}#fm-monitor .fm-flow b{font-size:30px;color:#888}#fm-monitor .fm-flow .fm-moving{color:#f2b84b;animation:fm-pulse 1s infinite alternate}#fm-monitor .fm-grid .fm-card:nth-child(1){border-top:3px solid #64b99b}#fm-monitor .fm-grid .fm-card:nth-child(2){border-top:3px solid #519bce}#fm-monitor .fm-grid .fm-card:nth-child(3){border-top:3px solid #c6a36d}#fm-monitor .fm-donut{width:110px;height:110px;border-radius:50%;display:grid;place-items:center;margin:10px auto;background:conic-gradient(#519bce calc(var(--used)*1%),#7773 0)}#fm-monitor .fm-donut span{display:grid;place-items:center;width:85px;height:85px;background:#20252b;color:#eee;border-radius:50%;font-size:24px}@keyframes fm-pulse{from{opacity:.3}to{opacity:1}}@media(max-width:600px){#fm-monitor .fm-flow{font-size:12px;gap:4px;padding:18px 8px}}@media(prefers-reduced-motion:reduce){#fm-monitor .fm-moving{animation:none!important}}
/* Compact panels that inherit the surrounding Unraid page typography. */
#fm-monitor{font:inherit;max-width:1160px;margin:20px auto;padding:0 16px}
#fm-monitor h2{font-size:24px;font-weight:600;margin:0 0 6px}
#fm-monitor h3{font-size:17px;font-weight:600;margin:0 0 14px}
#fm-monitor .fm-sub{margin-bottom:18px}
#fm-monitor .fm-card{background:transparent;border:1px solid #8885;border-radius:4px;padding:18px;margin-bottom:16px}
#fm-monitor .fm-label{font-size:12px;letter-spacing:.7px;font-weight:600}
#fm-monitor .fm-value{font-size:23px}
#fm-monitor .fm-flow{border-radius:4px;background:#88808;border:1px solid #8885;padding:18px 12px;font-size:16px}
#fm-monitor .fm-grid .fm-card:nth-child(n){border-top:2px solid #ef7d00}
#fm-monitor .fm-donut{background:conic-gradient(#ef7d00 calc(var(--used)*1%),#7773 0)}
#fm-monitor .fm-donut span{background:#252525}
#fm-monitor progress{accent-color:#ef7d00;height:12px}
#fm-monitor button{font:inherit;padding:7px 12px;border:1px solid #8887;border-radius:3px;background:transparent;color:inherit;cursor:pointer}
#fm-monitor button:hover{border-color:#ef7d00}
#fm-monitor button:focus-visible{outline:2px solid #ef7d00;outline-offset:3px}
#fm-monitor .fm-note{font-size:12px}
</style>
<div id="fm-monitor" data-running="<?=$fmRun?1:0?>" data-uncertain="<?=$fmRaw&&!$fmRun?1:0?>" data-available="<?=$fmUsed!==null?1:0?>" data-used="<?=$fmUsed??0?>" data-free="<?=$fmFree!==false?$fmGiB($fmFree):'—'?>">
<h2>Mover-Monitor</h2><p class="fm-sub">FejesNAS · Live-Status · Nur Überwachung</p>
<a href="/Tools/FejesMoverSettings" style="display:inline-block;margin-right:16px;color:#64c7ff">⚙ Einstellungen</a><button type="button" id="fm-toggle">Automatische Aktualisierung: AN (5 Sek.)</button> <span>Datenstand: <?=date('Y-m-d H:i:s')?></span><div id="fm-error" role="status"></div>
<div class="fm-flow"><span>▣ CACHE / SSD</span><b class="<?=$fmRun?'fm-moving':''?>">➜</b><span>⇄ MOVER</span><b class="<?=$fmRun?'fm-moving':''?>">➜</b><span>▤ ARRAY</span></div><p class="fm-note">Cache-/Array-Darstellung; die tatsächliche Richtung kann je Freigabe abweichen · <?=$fmRun?'Mover ist aktiv.':'Derzeit im Leerlauf.'?></p><div class="fm-grid">
<section class="fm-card"><div class="fm-label">MOVER-STATUS</div><div class="fm-value" style="color:<?=$fmRun?'#f2b84b':'#64b99b'?>"><?=$fmRun?'● Mover läuft':($fmRaw?'⚠ PID nicht verifiziert':'● Nicht aktiv')?></div><p><?=$fmRun?count($fmIds).' zugehörige Prozesse · PID '.$fmPid:'Derzeit ist keine aktive Übertragung bestätigt.'?></p></section>
<section class="fm-card"><div class="fm-label">CACHE-BELEGUNG</div><div class="fm-donut" style="--used:<?=$fmUsed??0?>"><span><?=$fmUsed!==null?$fmUsed.'%':'—'?></span></div><?php if($fmUsed!==null):?><progress max="100" value="<?=$fmUsed?>"></progress><p><?=$fmGiB($fmTotal-$fmFree)?> / <?=$fmGiB($fmTotal)?> GiB<br>Frei: <?=$fmGiB($fmFree)?> GiB</p><?php endif?></section>
<section class="fm-card"><div class="fm-label">STARTSCHWELLE DES VORHANDENEN SKRIPTS</div><div class="fm-value"><?=$fmThreshold!==null?$fmThreshold.' GiB Schwellenwert':'Nicht verfügbar'?></div><p><?=$fmFree!==false&&$fmThreshold!==null?($fmFree/1073741824>=$fmThreshold?'Der freie Speicher liegt derzeit über dem Schwellenwert.':'Der freie Speicher liegt unter dem Schwellenwert. Das Skript prüft weitere Bedingungen.'):'Der Schwellenwert kann nicht geprüft werden.'?></p></section>
</div>
<section class="fm-card"><h3>Aktuell geöffnete Dateien</h3>
<?php if($fmFiles):?><table><thead><tr><th>Datei / Speicherort</th><th>Vorgang</th><th>Dateiposition / Größe</th></tr></thead><tbody><?php foreach($fmFiles as $f):?><tr><td><?=$fmEsc($f['path'])?></td><td><?=(['Lesen','Schreiben','Lesen und Schreiben'][$f['mode']]??'Unbekannt')?></td><td><?=$fmGiB($f['pos'])?> / <?=$fmGiB($f['size'])?> GiB</td></tr><?php endforeach?></tbody></table><?php else:?><p><?=$fmRun?'Mover läuft, aber derzeit ist keine geöffnete Datendatei sichtbar. Möglicherweise sucht oder wartet er.':'Warten auf den nächsten Mover-Lauf.'?></p><?php endif?>
<p class="fm-note">Momentaufnahme der von Mover und seinen Kindprozessen geöffneten Dateien. Die Dateiposition bestätigt keinen abgeschlossenen Transfer. Restmenge, Geschwindigkeit und Endzeit lassen sich aus dieser Quelle nicht zuverlässig bestimmen.</p></section>
<section class="fm-card"><h3>Letzte Mover-Protokolleinträge</h3><pre><?=$fmEsc($fmLog?:'Keine Mover-Einträge in den letzten 256 KiB des Systemprotokolls. Dies allein ist kein Fehler; frühere Läufe oder detaillierte Dateiprotokolle sind möglicherweise nicht verfügbar.')?></pre></section>
<?php if($fmScriptLog):?><section class="fm-card"><h3>Filmek Mover · letztes Skriptprotokoll</h3><pre><?=$fmEsc($fmScriptLog)?></pre></section><?php endif?>
<p class="fm-note">Der Monitor liest Prozesse, freien Cache-Speicher und vorhandene Protokolle. Vorhandene Unraid-Einstellungen und eigene Skripte steuern die Übertragung. Diese Version überwacht einen Pool namens cache. Die Aktualisierung erfolgt nur bei geöffneter Seite.</p></div>
<script>
(()=>{let enabled=true,busy=false;if(window.fejesMoverTimer)clearInterval(window.fejesMoverTimer);function bind(){const button=document.getElementById('fm-toggle');button.textContent='Automatische Aktualisierung: '+(enabled?'AN (5 Sek.)':'PAUSIERT');button.onclick=()=>{enabled=!enabled;bind();};}bind();window.fejesMoverTimer=setInterval(async()=>{if(!enabled||busy||document.hidden)return;busy=true;const c=new AbortController(),t=setTimeout(()=>c.abort(),8000);try{const r=await fetch(location.href,{cache:'no-store',credentials:'same-origin',signal:c.signal});if(!r.ok)throw Error();const doc=new DOMParser().parseFromString(await r.text(),'text/html'),part=doc.getElementById('fm-monitor');if(!part)throw Error();document.getElementById('fm-monitor').replaceWith(part);bind();}catch(e){document.getElementById('fm-error').textContent='Aktualisierung fehlgeschlagen. Die angezeigten Daten sind veraltet; Verbindung oder Anmeldung prüfen.';}finally{clearTimeout(t);busy=false;}},5000);})();
</script>



