echo $fmLanguageSelector;
$fmc=require '/usr/local/emhttp/plugins/fejes.mover.monitor/FejesMoverRuntime.php';
$fmEsc=$fmc['esc'];
if($fmc['mode']!=='demo'){
$fmMounted=$fmc['mounted'];
$fmRead=static fn($p)=>@file_get_contents($p)?:'';
$fmEsc=static fn($s)=>htmlspecialchars((string)$s,ENT_QUOTES|ENT_SUBSTITUTE,'UTF-8');
$fmRaw=trim($fmRead('/var/run/mover.pid'));$fmPid=ctype_digit($fmRaw)?(int)$fmRaw:0;
$fmCmd=$fmPid?str_replace(chr(0),' ',$fmRead("/proc/$fmPid/cmdline")):'';
$fmRun=$fmPid>1&&preg_match('~(?:^|[ /])mover(?: |$)~',$fmCmd);
$fmIds=[];$fmFiles=[];
if($fmRun){
$fmIds[$fmPid]=true;$fmParents=[];
foreach(glob('/proc/[0-9]*/status')?:[] as $p){$s=$fmRead($p);if(preg_match('/^Pid:\s+(\d+)/m',$s,$a)&&preg_match('/^PPid:\s+(\d+)/m',$s,$b))$fmParents[(int)$a[1]]=(int)$b[1];}
do{$add=false;foreach($fmParents as $p=>$parent)if(isset($fmIds[$parent])&&!isset($fmIds[$p])){$fmIds[$p]=true;$add=true;}}while($add);
foreach($fmIds as $p=>$_)foreach(glob("/proc/$p/fd/*")?:[] as $fd){
$path=@readlink($fd);if(!$path||!str_starts_with($path,'/mnt/')||str_ends_with($path,' (deleted)'))continue;
$st=@stat($fd);if(!$st||(($st['mode']&0170000)!==0100000))continue;
$info=$fmRead("/proc/$p/fdinfo/".basename($fd));preg_match('/^pos:\s+(\d+)/m',$info,$pos);preg_match('/^flags:\s+([0-7]+)/m',$info,$fl);
$fmFiles[]=['path'=>$path,'pos'=>(int)($pos[1]??0),'size'=>$st['size'],'mode'=>isset($fl[1])?(octdec($fl[1])&3):-1];if(count($fmFiles)>=40)break 2;
}}
$fmTotal=$fmMounted?@disk_total_space($fmc['path']):false;$fmFree=$fmMounted?@disk_free_space($fmc['path']):false;
$fmUsed=$fmTotal&&$fmFree!==false?round(100*(1-$fmFree/$fmTotal),1):null;
$fmScript=$fmc['pool']==='cache'?$fmRead('/boot/config/plugins/user.scripts/scripts/Filmek_Mover_Threshold/script'):'';preg_match('/^KUSZOB_GIB=(\d+)/m',$fmScript,$fmMatch);$fmThreshold=$fmMatch[1]??null;
$fmGiB=static fn($n)=>number_format($n/1073741824,1,',',' ');
$fmTail=static function($path,$limit){$f=@fopen($path,'rb');if(!$f)return '';$sz=fstat($f)['size'];$offset=max(0,$sz-$limit);fseek($f,$offset);$s=stream_get_contents($f);fclose($f);if($offset){$nl=strpos($s,"\n");$s=$nl===false?'':substr($s,$nl+1);}return $s;};
$fmLines=preg_split('/\r?\n/',$fmTail('/var/log/syslog',262144));$fmLines=array_filter($fmLines,static fn($s)=>preg_match('/\bmover(?:\[|:| )|Filmek Mover/i',$s));$fmLog=implode("\n",array_slice($fmLines,-30));
$fmScriptLog=$fmTail('/tmp/user.scripts/tmpScripts/Filmek_Mover_Threshold/log.txt',8192);
}else{
$fmRaw='';$fmPid=0;$fmRun=false;$fmIds=[];$fmFiles=[];$fmTotal=1073741824000;$fmFree=375809638400;$fmUsed=65;$fmThreshold=null;$fmGiB=static fn($n)=>number_format($n/1073741824,1,',',' ');$fmLog='DEMO · No live logs';$fmScriptLog='';
}

