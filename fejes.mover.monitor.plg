echo $fmLanguageSelector;
$msMounted=(static function(){foreach(explode("\n",@file_get_contents('/proc/self/mountinfo')?:'') as $line){$fields=explode(' ',$line);if(($fields[4]??'')==='/mnt/cache')return true;}return false;})();
$msToken=(parse_ini_file('/var/local/emhttp/var.ini')['csrf_token']??'');
