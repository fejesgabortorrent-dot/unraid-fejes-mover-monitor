echo $fmLanguageSelector;
$fmcConfigWrite=true;
$fmc=require '/usr/local/emhttp/plugins/fejes.mover.monitor/FejesMoverRuntime.php';
$fmcT=$fmc['t'];$fmcEsc=$fmc['esc'];$fmcMessage='';$fmcError='';
if(($_SERVER['REQUEST_METHOD']??'GET')==='POST'){
 try{
  if(!is_resource($fmc['lock'])||$fmc['lockError']||$fmc['readError'])throw new RuntimeException('Mode change is unavailable. Reload the page.');
  if(!is_string($_POST['fmc_csrf']??null)||!is_string($fmc['token'])||$fmc['token']===''||!hash_equals($fmc['token'],$_POST['fmc_csrf']))throw new RuntimeException('Session expired. Reload the page.');
  if(!is_string($_POST['config_hash']??null)||!hash_equals($fmc['hash'],$_POST['config_hash']))throw new RuntimeException('Mode configuration changed. Reload the page.');
  $newMode=$_POST['mode']??null;$newPool=$_POST['pool']??null;
  if(!is_string($newMode)||!in_array($newMode,['demo','observer','advanced'],true))throw new RuntimeException('Invalid operating mode.');
  if(!is_string($newPool)||!preg_match('/^[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}$/D',$newPool))throw new RuntimeException('Invalid pool.');
  if($newMode!=='demo'&&!array_key_exists($newPool,$fmc['pools']))throw new RuntimeException('Only a configured Unraid pool can be selected.');
  if($newMode==='advanced'&&($_POST['advanced_ack']??'')!=='yes')throw new RuntimeException('Advanced mode requires explicit acknowledgment.');
  // The existing automation is explicitly hard-coded for cache. Do not imply it
  // follows the monitor pool selector or reinterpret a custom script.
  if($newMode==='advanced'&&$newPool!=='cache')throw new RuntimeException('The existing script editor is only available with the cache pool.');
  $saved=['version'=>1,'mode'=>$newMode,'pool'=>$newPool];
  $data=json_encode($saved,JSON_UNESCAPED_SLASHES|JSON_THROW_ON_ERROR)."\n";
  if($data!==$fmc['raw']){
   $dir=dirname($fmc['pathConfig']);
   if(!is_dir($dir)&&!@mkdir($dir,0700,true))throw new RuntimeException('Failed to save mode configuration.');
   $tmp=tempnam($dir,'.settings-');
   if(!$tmp)throw new RuntimeException('Failed to save mode configuration.');
   try{
    if(!chmod($tmp,0600)||file_put_contents($tmp,$data)!==strlen($data)||file_get_contents($tmp)!==$data||!rename($tmp,$fmc['pathConfig']))throw new RuntimeException('Failed to save mode configuration.');
   }finally{if(is_file($tmp))unlink($tmp);}
   if(file_get_contents($fmc['pathConfig'])!==$data)throw new RuntimeException('Mode configuration verification failed.');
  }
  $fmcMessage='Mode and monitored pool saved. This does not start Mover.';
  $fmc['mode']=$newMode;$fmc['pool']=$newPool;$fmc['hash']=hash('sha256',$data);
 }catch(Throwable $e){$fmcError=$e->getMessage();}
}
