$msParse=function($s){$r=[];foreach(['KUSZOB_GIB','UJRA_PROBALKOZAS_MP'] as $k){if(preg_match_all('/^'.preg_quote($k,'/').'=(\d+)[ \t]*$/m',(string)$s,$m)!==1)throw new RuntimeException('The script parameters are ambiguous.');$r[$k]=(int)$m[1][0];}return $r;};
$msTotal=$msMounted?@disk_total_space('/mnt/cache'):false;$msFree=$msMounted?@disk_free_space('/mnt/cache'):false;$msMax=$msTotal?max(1,(int)floor($msTotal/1073741824)-1):0;
$msMessage='';$msError='';$msValues=['KUSZOB_GIB'=>300,'UJRA_PROBALKOZAS_MP'=>360];$msLock=null;$msTmp=null;
try{
 $msValues=$msParse($msSource);
 if(($_SERVER['REQUEST_METHOD']??'GET')==='POST'){
  if(!is_string($_POST['ms_csrf']??null)||empty($msToken)||!hash_equals($msToken,$_POST['ms_csrf']))throw new RuntimeException('Session expired. Reload the page.');
  $msNew=[];foreach(['KUSZOB_GIB'=>$msMax,'UJRA_PROBALKOZAS_MP'=>10080] as $k=>$max){$v=$_POST[$k]??null;if(!is_string($v)||!preg_match('/^[1-9][0-9]{0,4}$/D',$v)||(int)$v>$max)throw new RuntimeException('Invalid value or cache unavailable.');$msNew[$k]=(int)$v;}
  $msLock=fopen('/var/run/fejes-mover-settings.lock','c');if(!$msLock||!flock($msLock,LOCK_EX|LOCK_NB))throw new RuntimeException('Another save is in progress.');
  $msSource=file_get_contents($msPath);$msValues=$msParse($msSource);
  if(!is_string($_POST['source_hash']??null)||!hash_equals(hash('sha256',$msSource),$_POST['source_hash']))throw new RuntimeException('The script changed in the meantime. Reload the page.');
  if($msNew===$msValues){$msMessage='Verified: these values are already saved. Nothing changed.';}
  else{
   if(file_exists('/var/run/mover.pid'))throw new RuntimeException('Settings cannot be changed while Mover is running.');
   $msChanged=$msSource;foreach($msNew as $k=>$v)$msChanged=preg_replace('/^'.preg_quote($k,'/').'=[0-9]+[ \t]*$/m',$k.'='.$v,$msChanged);
   $msDir='/boot/config/plugins/fejes.mover.monitor/backups';if(!is_dir($msDir)&&!mkdir($msDir,0700,true))throw new RuntimeException('Unable to create the backup directory.');
   $msBackup=$msDir.'/threshold-'.date('Ymd-His').'-'.bin2hex(random_bytes(3)).'.sh';
   if(file_put_contents($msBackup,$msSource,LOCK_EX)!==strlen($msSource)||file_get_contents($msBackup)!==$msSource)throw new RuntimeException('Backup verification failed.');
   $msTmp=tempnam(dirname($msPath),'.mover-');if(!$msTmp||file_put_contents($msTmp,$msChanged)!==strlen($msChanged))throw new RuntimeException('Unable to prepare the save.');
   chmod($msTmp,fileperms($msPath)&0777);exec('/bin/bash -n '.escapeshellarg($msTmp).' 2>&1',$msOut,$msCode);if($msCode!==0)throw new RuntimeException('Script validation failed.');
   if(file_get_contents($msPath)!==$msSource)throw new RuntimeException('The script changed in the meantime.');
   if(!rename($msTmp,$msPath))throw new RuntimeException('Script replacement failed.');$msTmp=null;
   if(file_get_contents($msPath)!==$msChanged)throw new RuntimeException('Read-back verification failed. Backup: '.$msBackup);
   $msSource=$msChanged;$msValues=$msNew;$msMessage='Saved and verified. The next script run will use these values. Backup: '.basename($msBackup);
  }
 }
}catch(Throwable $e){$msError=$e->getMessage();}
finally{if($msTmp&&is_file($msTmp))unlink($msTmp);if(is_resource($msLock)){flock($msLock,LOCK_UN);fclose($msLock);}}
