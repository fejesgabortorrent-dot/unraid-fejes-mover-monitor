<script>(()=>{const label=<?=json_encode($fmPageTitle)?>;const host=document.querySelector('div.title > span.left');if(host){const node=Array.from(host.childNodes).find(n=>n.nodeType===3&&n.textContent.trim());if(node)node.nodeValue=label;}document.title=document.title.split('/')[0]+'/'+label;})();</script>
<?php
if($fmLang==='en'){ ?>
<?php
echo $fmLanguageSelector;
$fpEsc=static fn($v)=>htmlspecialchars((string)$v,ENT_QUOTES|ENT_SUBSTITUTE,'UTF-8');
$fmc=require '/usr/local/emhttp/plugins/fejes.mover.monitor/FejesMoverRuntime.php';
$fpToken=$fmc['token'];
$fpTools='/boot/config/plugins/fejes.mover.monitor/tools/';
$fpError='';$fpMessage='';$fpReport=null;
$fpLabels=[
 'unavailable'=>'Nem ellenőrizhető', 'available'=>'Available',
 'unknown'=>'Nem ellenőrizhető', 'no_torrent_blocker'=>'No torrent blocker',
 'defer'=>'Deferred: unfinished or busy torrent',
 'wired'=>'Integrated', 'original'=>'Uses the original launcher',
 'not_verified'=>'Active integration not verified',
 'ok'=>'Estimated remaining data and reserve fit',
 'warning'=>'Space may be insufficient for remaining downloads and reserve'
];
try {
 if(($_SERVER['REQUEST_METHOD']??'GET')==='POST') {
  if(!is_string($_POST['fp_csrf']??null)||!is_string($fpToken)||$fpToken===''||!hash_equals($fpToken,$_POST['fp_csrf']))throw new RuntimeException('Session expired. Reload the page.');
  $fpAction=$_POST['fp_action']??'';
  if(!is_string($fpAction)||!in_array($fpAction,['check','dry-run','wire'],true))throw new RuntimeException('Unknown action.');
  if($fmc['error']||!is_resource($fmc['lock']))throw new RuntimeException('Configuration cannot be read safely.');
  if($fmc['mode']==='demo'){
   if(!in_array($fpAction,['check','dry-run'],true))throw new RuntimeException('No live operation in Demo mode.');
   $fpReport=['torrent'=>'no_torrent_blocker','checked_torrents'=>7,'blocking_torrents'=>0,'cache_free_bytes'=>633*1073741824,'remaining_upper_bound_bytes'=>20*1073741824,'pressure'=>'ok'];
   if($fpAction==='dry-run')$fpReport['dry_run']=['decision'=>'wait','read_only'=>true,'checks'=>[['key'=>'capacity','state'=>'wait','detail'=>['free_gib'=>633,'threshold_gib'=>300]],['key'=>'torrent','state'=>'pass','detail'=>0],['key'=>'backup','state'=>'pass'],['key'=>'parity','state'=>'pass'],['key'=>'mover','state'=>'pass'],['key'=>'cooldown','state'=>'pass'],['key'=>'launcher','state'=>'pass']]];
   $fpMessage='Simulated state. No live query.';
  }else{
  if($fmc['pool']!=='cache')throw new RuntimeException('Torrent protection currently requires the cache pool.');
  if($fpAction==='wire'&&($fmc['mode']!=='advanced'||!$fmc['mounted']||($_POST['wire_ack']??'')!=='yes'))throw new RuntimeException('Integration requires Advanced mode, a mounted cache and separate consent.');
  $fpScript=$fpTools.($fpAction!=='wire'?'fejes_service.py':'wire_integrity_cron.py');
  if(!is_file($fpScript))throw new RuntimeException('Shared helpers are not installed.');
  $fpCommand='timeout 35s python3 '.escapeshellarg($fpScript).($fpAction==='check'?' status':($fpAction==='dry-run'?' dry-run --include-items':'')).' 2>/dev/null';
  $fpOut=[];$fpCode=0;exec($fpCommand,$fpOut,$fpCode);
  if($fpCode!==0)throw new RuntimeException('The action did not complete. Check Python, Docker and File Integrity availability.');
  if($fpAction!=='wire') {
   $fpReport=json_decode(implode("\n",$fpOut),true,32,JSON_THROW_ON_ERROR);
   if(!is_array($fpReport))throw new RuntimeException('Invalid status response.');
   $fpMessage='Snapshot time: '.date('Y-m-d H:i:s');
  } else $fpMessage='Existing File Integrity schedule integration completed. Check status to verify the active cron.';
  }
 }
} catch(Throwable $e) {$fpError=$e instanceof JsonException?'Cannot read status response.':$e->getMessage();}
$fpLabel=static fn($v)=>$fpLabels[is_string($v)?$v:'unknown']??'Nem ellenőrizhető';
$fpGiB=static fn($v)=>is_numeric($v)?number_format((float)$v/1073741824,1,'.',',').' GiB':'Nem ellenőrizhető';
?>
<style>
#fp{max-width:1050px;margin:24px auto;padding:0 18px;font-size:15px;line-height:1.6}#fp .grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:16px}#fp section,#fp .fp-notice{border:1px solid #8885;border-radius:12px;padding:20px;margin-bottom:18px;background:#88808}#fp h2{font-size:28px}#fp h3{margin-top:0}#fp .fp-error{border-color:#d88868}#fp button{padding:10px 16px;margin:8px 8px 8px 0}#fp code{overflow-wrap:anywhere}#fp .muted{opacity:.75}
</style>
<div id="fp">
<?=$fmc['banner']?>
<p><a href="/Dashboard#fejes-mover-dashboard">← Back to dashboard card</a></p>
<h2>FejesMover · Coordinated protection</h2>
<p><a href="/Tools/FejesMover">← Mover Monitor</a> · <a href="/Tools/FejesMoverSettings">Threshold and retry interval</a></p>
<p>Torrent state, cache capacity and scheduled File Integrity in one place.</p>
<?php if($fpError):?><div class="fp-notice fp-error" role="alert"><?=$fpEsc($fpError)?></div><?php endif?>
<?php if($fpMessage):?><div class="fp-notice" role="status"><?=$fpEsc($fpMessage)?></div><?php endif?>
<form method="post" action="/Tools/FejesMoverProtection">
 <input type="hidden" name="csrf_token" value="<?=$fpEsc($fpToken)?>"><input type="hidden" name="fp_csrf" value="<?=$fpEsc($fpToken)?>">
 <button type="submit" name="fp_action" value="dry-run" style="background:#d96316;color:white;border:2px solid #ff9c55;font-size:17px;font-weight:600">▶ Dry run – no file movement</button>
 <button type="submit" name="fp_action" value="check">Check status</button>
 <p class="muted">The check reads a snapshot. It starts neither Mover nor hashing.</p>
<?php if(isset($fpReport['dry_run'])&&is_array($fpReport['dry_run'])):
 $fpDry=$fpReport['dry_run'];$fpT=$fmc['t'];
 $fpDecision=in_array($fpDry['decision']??null,['ready','wait','unknown'],true)?$fpDry['decision']:'unknown';
 $fpColors=['ready'=>'#62d4a3','wait'=>'#ffb55c','unknown'=>'#ed9587'];
 $fpHead=['ready'=>$fpT('A feltételek alapján indulna','Conditions allow a start','Bedingungen erlauben den Start'),'wait'=>$fpT('Most várakozna','Would wait now','Würde jetzt warten'),'unknown'=>$fpT('Nem dönthető el biztonságosan','Cannot safely determine readiness','Startbereitschaft nicht sicher prüfbar')];
 $fpNames=['launcher'=>$fpT('Indító ellenőrzése','Reviewed launcher','Geprüftes Startskript'),'capacity'=>$fpT('Szabad hely és küszöb','Free space and threshold','Freier Platz und Schwelle'),'torrent'=>$fpT('Torrent protection','Torrent protection','Torrent-Schutz'),'backup'=>$fpT('Appdata-mentés','Appdata backup','Appdata-Sicherung'),'parity'=>$fpT('Paritásművelet','Parity operation','Paritätsvorgang'),'mover'=>$fpT('Futó Mover','Running Mover','Laufender Mover'),'cooldown'=>$fpT('Újrapróbálkozási várakozás','Retry cooldown','Wartezeit bis zum nächsten Versuch')];
 $fpStates=['pass'=>$fpT('Rendben','Clear','In Ordnung'),'wait'=>$fpT('Várakozás','Wait','Warten'),'unknown'=>$fpT('Nem ellenőrizhető','Unavailable','Nicht prüfbar')];
?>
<section id="fp-dry-run" aria-live="polite" style="border:2px solid <?=$fpColors[$fpDecision]?>;background:#8881">
<h3><?=$fpEsc($fpT('Indítási próba · csak olvasás','Start preview · read only','Startvorschau · nur lesen'))?></h3>
<p style="font-size:26px;font-weight:700;color:<?=$fpColors[$fpDecision]?>"><?=$fpEsc($fpHead[$fpDecision])?></p>
<p><?=$fpEsc($fpT('Pillanatkép, nem indítás. Nem mozgat fájlokat, nem írja az időbélyeget és nem foglal indítási jogot.','Snapshot only. No files moved, no timestamp written and no launch reservation.','Nur Momentaufnahme. Keine Dateien verschoben, kein Zeitstempel geschrieben und kein Start reserviert.'))?></p>
<div class="grid">
<?php foreach(($fpDry['checks']??[]) as $fpCheck):
 if(!is_array($fpCheck)||!isset($fpNames[$fpCheck['key']??'']))continue;
 $fpKey=$fpCheck['key'];$fpState=$fpCheck['state']??'unknown';if(!isset($fpStates[$fpState]))$fpState='unknown';
 $fpColor=$fpState==='pass'?'#62d4a3':($fpState==='wait'?'#ffb55c':'#ed9587');
 $fpDetail=$fpCheck['detail']??null;
?>
<div style="padding:14px;border:1px solid #8885;border-left:5px solid <?=$fpColor?>;border-radius:4px"><strong><?=$fpEsc($fpNames[$fpKey])?></strong><br><span style="color:<?=$fpColor?>;font-weight:600"><?=$fpState==='pass'?'✓':($fpState==='wait'?'⏸':'?')?> <?=$fpEsc($fpStates[$fpState])?></span>
<?php if($fpKey==='capacity'&&is_array($fpDetail)):?><p><?=$fpEsc($fpDetail['free_gib']??'—')?> GiB / <?=$fpEsc($fpT('küszöb','threshold','Schwelle'))?>: <?=$fpEsc($fpDetail['threshold_gib']??'—')?> GiB</p><?php endif?>
<?php if($fpKey==='torrent'&&is_int($fpDetail)):?><p><?=$fpEsc($fpT('Halasztást okozó torrentek: ','Blocking torrents: ','Blockierende Torrents: '))?><?=$fpDetail?></p><?php endif?>
