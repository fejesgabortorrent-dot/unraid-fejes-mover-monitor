$fmc=require '/usr/local/emhttp/plugins/fejes.mover.monitor/FejesMoverRuntime.php';
if($fmc['mode']!=='demo'){
$fmdMounted=$fmc['mounted'];
$fmdRaw=trim(@file_get_contents('/var/run/mover.pid')?:'');$fmdPid=ctype_digit($fmdRaw)?(int)$fmdRaw:0;
$fmdCmd=$fmdPid?str_replace(chr(0),' ',@file_get_contents("/proc/$fmdPid/cmdline")?:''):'';
$fmdRun=$fmdPid>1&&preg_match('~(?:^|[ /])mover(?: |$)~',$fmdCmd);
$fmdTotal=$fmdMounted?@disk_total_space($fmc['path']):false;$fmdFree=$fmdMounted?@disk_free_space($fmc['path']):false;$fmdUsed=$fmdTotal&&$fmdFree!==false?round(100*(1-$fmdFree/$fmdTotal),1):0;
$fmdDisplay=$fmdTotal&&$fmdFree!==false?$fmdUsed.'%':'—';
$fmdFreeText=$fmdFree!==false?number_format($fmdFree/1073741824,1,'.',','):'—';
$fmdStatus=$fmdRun?'● Mover running':($fmdRaw?'⚠ Unverified status':'● Idle');$fmdColor=$fmdRun?'#f2b84b':($fmdRaw?'#ef967a':'#64b99b');
}else{
$fmdRun=false;$fmdRaw='';$fmdUsed=65;$fmdDisplay='65%';$fmdFreeText='350';$fmdStatus='DEMO';$fmdColor='#ef7d00';
}
$fmcBanner=$fmc['banner'];
$mytiles['fejes.mover.monitor']['column2']=<<<HTML
<tbody id="fejes-mover-dashboard" class="mixed" title="Mover Monitor">
<tr><td><span class="tile-header"><span class="tile-header-left"><img src="data:image/svg+xml;base64," alt="FM — Fejes Mover" width="56" height="56" style="display:inline-block;vertical-align:middle;margin-right:10px;border-radius:10px"><div class="section"><h3 class="tile-header-main">MOVER MONITOR</h3></div></span><span class="tile-header-right">{$fmLanguageSelector}<a href="/Tools/FejesMoverSettings" title="Mover Settings" style="margin-right:12px"><i class="fa fa-cog"></i></a><a href="/Tools/FejesMover" title="Detailed Mover Monitor"><i class="fa fa-external-link"></i></a></span></span></td></tr>
<tr><td><div id="fmd-mode">{$fmcBanner}</div><div id="fmd-body" style="padding:12px 8px"><div style="display:flex;align-items:center;gap:20px"><div id="fmd-ring" style="width:86px;height:86px;flex-shrink:0;border-radius:50%;display:grid;place-items:center;background:conic-gradient(#ef7d00 {$fmdUsed}%,#7773 0)"><span id="fmd-percent" style="width:65px;height:65px;border-radius:50%;display:grid;place-items:center;background:#252525;color:#eee;font-size:19px">{$fmdDisplay}</span></div><div><strong id="fmd-status" style="font-size:20px;color:{$fmdColor}">{$fmdStatus}</strong><p style="margin:8px 0">Cache free: <b id="fmd-free">{$fmdFreeText}</b> GiB</p><small>Cache / SSD → Mover → Array</small></div></div><p style="margin:14px 0 0"><a href="/Tools/FejesMover">Files and detailed status →</a></p><small id="fmd-updated">Data loaded · refresh every 10 sec</small></div></td></tr>
</tbody>
HTML;
