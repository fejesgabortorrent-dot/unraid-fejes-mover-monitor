   $msChanged=$msSource;foreach($msNew as $k=>$v)$msChanged=preg_replace('/^'.preg_quote($k,'/').'=[0-9]+[ \t]*$/m',$k.'='.$v,$msChanged);
   $msDir='/boot/config/plugins/fejes.mover.monitor/backups';if(!is_dir($msDir)&&!mkdir($msDir,0700,true))throw new RuntimeException('Der Sicherungsordner kann nicht erstellt werden.');
   $msBackup=$msDir.'/threshold-'.date('Ymd-His').'-'.bin2hex(random_bytes(3)).'.sh';
