<?php
echo $fmLanguageSelector;
$fpEsc=static fn($v)=>htmlspecialchars((string)$v,ENT_QUOTES|ENT_SUBSTITUTE,'UTF-8');
$fmc=require '/usr/local/emhttp/plugins/fejes.mover.monitor/FejesMoverRuntime.php';
$fpToken=$fmc['token'];
$fpTools='/boot/config/plugins/fejes.mover.monitor/tools/';
$fpError='';$fpMessage='';$fpReport=null;
$fpLabels=[
 'unavailable'=>'Nem ellenőrizhető', 'available'=>'Elérhető',
 'unknown'=>'Nem ellenőrizhető', 'no_torrent_blocker'=>'Nincs torrentoldali akadály',
 'defer'=>'Halasztás: félkész vagy elfoglalt torrent',
 'wired'=>'Bekötve', 'original'=>'Az eredeti indítót használja',
 'not_verified'=>'Az aktív bekötés nem igazolt',
 'ok'=>'A becsült hátralévő adatmennyiség és a tartalék elfér',
 'warning'=>'Kevés hely lehet a hátralévő letöltéshez és a tartalékhoz'
];
try {
 if(($_SERVER['REQUEST_METHOD']??'GET')==='POST') {
  if(!is_string($_POST['fp_csrf']??null)||!is_string($fpToken)||$fpToken===''||!hash_equals($fpToken,$_POST['fp_csrf']))throw new RuntimeException('Session expired. Reload the page.');
  $fpAction=$_POST['fp_action']??'';
  if(!is_string($fpAction)||!in_array($fpAction,['check','dry-run','wire'],true))throw new RuntimeException('Unknown művelet.');
  if($fmc['error']||!is_resource($fmc['lock']))throw new RuntimeException('A konfiguráció nem olvasható biztonságosan.');
  if($fmc['mode']==='demo'){
   if(!in_array($fpAction,['check','dry-run'],true))throw new RuntimeException('Demo módban nincs élő művelet.');
   $fpReport=['torrent'=>'no_torrent_blocker','checked_torrents'=>7,'blocking_torrents'=>0,'cache_free_bytes'=>633*1073741824,'remaining_upper_bound_bytes'=>20*1073741824,'pressure'=>'ok'];
   if($fpAction==='dry-run')$fpReport['dry_run']=['decision'=>'wait','read_only'=>true,'checks'=>[['key'=>'capacity','state'=>'wait','detail'=>['free_gib'=>633,'threshold_gib'=>300]],['key'=>'torrent','state'=>'pass','detail'=>0],['key'=>'backup','state'=>'pass'],['key'=>'parity','state'=>'pass'],['key'=>'mover','state'=>'pass'],['key'=>'cooldown','state'=>'pass'],['key'=>'launcher','state'=>'pass']]];
   $fpMessage='Szimulált állapot. Nincs élő lekérdezés.';
  }else{
  if($fmc['pool']!=='cache')throw new RuntimeException('A torrentvédelem jelenleg csak cache pool mellett ellenőrizhető.');
  if($fpAction==='wire'&&($fmc['mode']!=='advanced'||!$fmc['mounted']||($_POST['wire_ack']??'')!=='yes'))throw new RuntimeException('A bekötéshez Advanced mód, csatolt cache és külön jóváhagyás szükséges.');
  $fpScript=$fpTools.($fpAction!=='wire'?'fejes_service.py':'wire_integrity_cron.py');
  if(!is_file($fpScript))throw new RuntimeException('A közös segédek nincsenek telepítve.');
  $fpCommand='timeout 35s python3 '.escapeshellarg($fpScript).($fpAction==='check'?' status':($fpAction==='dry-run'?' dry-run':'')).' 2>/dev/null';
  $fpOut=[];$fpCode=0;exec($fpCommand,$fpOut,$fpCode);
  if($fpCode!==0)throw new RuntimeException('A művelet nem fejeződött be. Ellenőrizd a Python, Docker és File Integrity elérhetőségét.');
  if($fpAction!=='wire') {
   $fpReport=json_decode(implode("\n",$fpOut),true,32,JSON_THROW_ON_ERROR);
   if(!is_array($fpReport))throw new RuntimeException('Érvénytelen állapotválasz.');
   $fpMessage='Pillanatkép ideje: '.date('Y-m-d H:i:s');
  } else $fpMessage='A meglévő File Integrity ütemezés bekötése lefutott. Kérj állapotellenőrzést az aktív cron igazolásához.';
  }
 }
} catch(Throwable $e) {$fpError=$e instanceof JsonException?'Unavailable állapotválasz.':$e->getMessage();}
$fpLabel=static fn($v)=>$fpLabels[is_string($v)?$v:'unknown']??'Nem ellenőrizhető';
$fpGiB=static fn($v)=>is_numeric($v)?number_format((float)$v/1073741824,1,'.',',').' GiB':'Nem ellenőrizhető';
?>
