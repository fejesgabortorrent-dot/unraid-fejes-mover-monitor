<?php
/* Universal, read-only Mover status page. Development preview. */
$fmEsc=static fn($v)=>htmlspecialchars((string)$v,ENT_QUOTES|ENT_SUBSTITUTE,'UTF-8');
$fmRead=static fn($p)=>@file_get_contents($p)?:'';
$fmRaw=trim($fmRead('/var/run/mover.pid'));
$fmPid=ctype_digit($fmRaw)?(int)$fmRaw:0;
$fmCmd=$fmPid>1?str_replace(chr(0),' ',$fmRead("/proc/$fmPid/cmdline")):'';
$fmRun=$fmPid>1&&(bool)preg_match('~(?:^|[ /])mover(?: |$)~',$fmCmd);
$fmPools=[];
foreach(glob('/mnt/*',GLOB_ONLYDIR)?:[] as $mount){
  $name=basename($mount);
  if(!is_file('/boot/config/pools/'.$name.'.cfg') && $name!=='cache')continue;
  $total=@disk_total_space($mount);$free=@disk_free_space($mount);
  if($total===false||$total<=0||$free===false)continue;
  $fmPools[]=['name'=>$name,'total'=>$total,'free'=>$free,'used'=>round(100*(1-$free/$total),1)];
}
usort($fmPools,static fn($a,$b)=>strcmp($a['name'],$b['name']));
$primary=$fmPools[0]??null;
$fmGiB=static fn($v)=>number_format($v/1073741824,1,',',' ');
$fmLog='';
$fh=@fopen('/var/log/syslog','rb');
if($fh){$size=@fstat($fh)['size']??0;$offset=max(0,$size-262144);@fseek($fh,$offset);$buf=stream_get_contents($fh);fclose($fh);if($offset){$pos=strpos($buf,"\n");$buf=$pos===false?'':substr($buf,$pos+1);} $lines=array_filter(preg_split('/\r?\n/',$buf),static fn($s)=>preg_match('/\bmover(?:\[|:| )/i',$s));$fmLog=implode("\n",array_slice($lines,-30));}
$fmFiles=[];
if($fmRun){
  $children=[$fmPid=>true];$parents=[];
  foreach(glob('/proc/[0-9]*/status')?:[] as $status){$data=$fmRead($status);if(preg_match('/^Pid:\s+(\d+)/m',$data,$m)&&preg_match('/^PPid:\s+(\d+)/m',$data,$p))$parents[(int)$m[1]]=(int)$p[1];}
  do{$changed=false;foreach($parents as $pid=>$ppid){if(isset($children[$ppid])&&!isset($children[$pid])){$children[$pid]=true;$changed=true;}}}while($changed);
  foreach($children as $pid=>$_){foreach(glob("/proc/$pid/fd/*")?:[] as $fd){
    $path=@readlink($fd);if(!$path||!str_starts_with($path,'/mnt/')||str_ends_with($path,' (deleted)'))continue;
    $st=@stat($fd);if(!$st||(($st['mode']&0170000)!==0100000))continue;
    $info=$fmRead("/proc/$pid/fdinfo/".basename($fd));preg_match('/^pos:\s+(\d+)/m',$info,$pos);
    $fmFiles[]=['path'=>$path,'position'=>(int)($pos[1]??0),'size'=>$st['size']];
    if(count($fmFiles)>=40)break 2;
  }}
}
?>
<style>
#fm-monitor{max-width:1100px;margin:24px auto;padding:0 18px}#fm-monitor .fm-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:16px}#fm-monitor .fm-card{border:1px solid #7775;border-radius:12px;padding:20px;margin:12px 0}#fm-monitor progress{width:100%;height:16px}#fm-monitor pre{white-space:pre-wrap;overflow-wrap:anywhere;max-height:250px;overflow:auto}#fm-monitor td,#fm-monitor th{text-align:left;padding:7px;border-bottom:1px solid #7774}#fm-monitor table{width:100%}#fm-monitor .fm-muted{opacity:.7;font-size:13px}
</style>
<div id="fm-monitor" data-running="<?=$fmRun?1:0?>" data-uncertain="<?=$fmRaw&&!$fmRun?1:0?>" data-used="<?=$primary?$primary['used']:0?>" data-free="<?=$primary?$fmGiB($primary['free']):'—'?>" data-pool="<?=$fmEsc($primary['name']??'')?>">
<h2>Mover figyelő</h2><p class="fm-muted">FejesNAS · Univerzális, csak olvasható állapotfigyelő</p>
<p><strong><?=$fmRun?'● Mover fut':($fmRaw?'⚠ A Mover állapota nem ellenőrizhető':'● Mover nem fut')?></strong> · Frissítve: <?=date('Y-m-d H:i:s')?></p>
<div class="fm-grid"><section class="fm-card"><h3>Pool tárhelyek</h3>
<?php if(!$fmPools):?><p>Nem található konfigurált, olvasható pool.</p><?php endif;?>
<?php foreach($fmPools as $pool):?>
<p><strong><?=$fmEsc($pool['name'])?></strong> — <?=$pool['used']?>% foglalt</p>
<progress max="100" value="<?=$pool['used']?>"></progress>
<p><?=$fmGiB($pool['total']-$pool['free'])?> / <?=$fmGiB($pool['total'])?> GiB · Szabad: <?=$fmGiB($pool['free'])?> GiB</p>
<?php endforeach;?></section>
<section class="fm-card"><h3>Nyitott fájlok</h3>
<?php if($fmFiles):?><table><thead><tr><th>Fájl</th><th>Pozíció / méret</th></tr></thead><tbody><?php foreach($fmFiles as $file):?><tr><td><?=$fmEsc($file['path'])?></td><td><?=$fmGiB($file['position'])?> / <?=$fmGiB($file['size'])?> GiB</td></tr><?php endforeach;?></tbody></table>
<?php else:?><p>Nincs megfigyelhető, megnyitott adatfájl.</p><?php endif;?>
<p class="fm-muted">Pillanatkép; a fájlpozíció nem a teljes mozgatási folyamat előrehaladása.</p></section></div>
<section class="fm-card"><h3>Legutóbbi Mover-naplóbejegyzések</h3><pre><?=$fmEsc($fmLog?:'Nem található Mover-bejegyzés a rendszernapló utolsó 256 KiB-jában.')?></pre></section>
<p class="fm-muted">A plugin csak olvas; a mozgatást az Unraid vezérli. A kijelzett adatok nem alkalmasak megbízható hátralévő idő számítására.</p></div>
<script>
(()=>{if(window.fejesMoverTimer)clearInterval(window.fejesMoverTimer);let busy=false;window.fejesMoverTimer=setInterval(async()=>{if(document.hidden||busy)return;busy=true;const c=new AbortController(),t=setTimeout(()=>c.abort(),8000);try{const r=await fetch(location.href,{credentials:'same-origin',cache:'no-store',signal:c.signal});if(!r.ok)throw Error('HTTP');const doc=new DOMParser().parseFromString(await r.text(),'text/html'),next=doc.getElementById('fm-monitor'),old=document.getElementById('fm-monitor');if(!next||!old)throw Error('Parse');old.replaceWith(next);}catch(e){const old=document.getElementById('fm-monitor');if(old&&!old.querySelector('.fm-refresh-error')){const p=document.createElement('p');p.className='fm-refresh-error';p.textContent='⚠ A frissítés sikertelen; a kijelzett adatok elavultak.';old.prepend(p);}}finally{clearTimeout(t);busy=false;}},10000);})();
</script>
