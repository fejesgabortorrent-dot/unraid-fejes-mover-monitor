   }finally{if(is_file($tmp))unlink($tmp);}
   if(file_get_contents($fmc['pathConfig'])!==$data)throw new RuntimeException('Prüfung der Moduskonfiguration fehlgeschlagen.');
  }
  $fmcMessage='Modus und überwachter Pool gespeichert. Mover wird nicht gestartet.';
  $fmc['mode']=$newMode;$fmc['pool']=$newPool;$fmc['hash']=hash('sha256',$data);
 }catch(Throwable $e){$fmcError=$e->getMessage();}
