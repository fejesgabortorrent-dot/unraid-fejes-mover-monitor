<?php
$fmcConfigWrite=false;
$runtime=require '/usr/local/emhttp/plugins/fejes.mover.monitor/FejesMoverRuntime.php';
$esc=$runtime['esc'];
$lang=$_COOKIE['fejes_mover_lang']??'hu';
$t=static fn($hu,$en,$de)=>($lang==='en'?$en:($lang==='de'?$de:$hu));
$base='/boot/config/plugins/fejes.mover.monitor/';
$profile=json_decode(@file_get_contents($base.'selective-profile.json')?:'null',true);
$data=json_decode(@file_get_contents($base.'automation.json')?:'null',true);
$message='';$error='';
if(($_SERVER['REQUEST_METHOD']??'GET')==='POST'){
 try{
  $token=$runtime['token']??'';
  if(!is_string($_POST['fmc_csrf']??null)||$token===''||!hash_equals($token,$_POST['fmc_csrf']))throw new RuntimeException('CSRF');
  if($runtime['lockError']||$runtime['readError'])throw new RuntimeException('Configuration unavailable');
  if(!is_array($profile))throw new RuntimeException('Save an explicit profile first');
  $new=['version'=>1,'enabled'=>($_POST['enabled']??'')==='1','scope'=>array_intersect_key($profile,array_flip(['pool','share','torrent_container']))];
  foreach(['threshold_gib','cooldown_minutes','interval_minutes'] as $key){
   $v=$_POST[$key]??null;if(!is_string($v)||!ctype_digit($v))throw new RuntimeException('Invalid value');$new[$key]=(int)$v;
  }
  // The helper acquires the exclusive lock and revalidates the current scope.
  if(is_resource($runtime['lock'])){flock($runtime['lock'],LOCK_UN);fclose($runtime['lock']);}
  $proc=proc_open(['/usr/bin/python3',$base.'tools/managed_schedule.py','configure'],[0=>['pipe','r'],1=>['pipe','w'],2=>['pipe','w']],$pipes);
  if(!is_resource($proc))throw new RuntimeException('Save unavailable');
  fwrite($pipes[0],json_encode($new,JSON_THROW_ON_ERROR));fclose($pipes[0]);
  $out=stream_get_contents($pipes[1]);fclose($pipes[1]);stream_get_contents($pipes[2]);fclose($pipes[2]);
  $code=proc_close($proc);$result=json_decode($out,true);
  if($code!==0||($result['saved']??false)!==true)throw new RuntimeException('Save failed; inspect automation state');
  $data=$new;$message=$t('Beállítások mentve.','Settings saved.','Einstellungen gespeichert.');
 }catch(Throwable $e){$error=$t('Nem sikerült menteni. Ellenőrizd a profilt, a Haladó módot és az automatika állapotát.','Save failed. Check the profile, Advanced mode and automation state.','Speichern fehlgeschlagen. Profil, erweiterten Modus und Automationsstatus prüfen.');}
}
