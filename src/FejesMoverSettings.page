<script>
(()=>{const form=document.querySelector('#ms form');if(!form)return;const fields=Array.from(form.querySelectorAll('input[type=number]'));if(!fields.length)return;const saved=fields.map(e=>e.value);const status=document.createElement('p');status.setAttribute('role','status');status.setAttribute('aria-live','polite');form.prepend(status);
const labels=<?=json_encode([$fmc['t']('Elmentett értékek változatlanok.','Saved values unchanged.','Gespeicherte Werte unverändert.'),$fmc['t']('Még nincs elmentve: ','Not saved yet: ','Noch nicht gespeichert: '),$fmc['t']('Érvénytelen érték: a megadott tartományon belül válassz.','Invalid value: choose within the displayed range.','Ungültiger Wert: innerhalb des angezeigten Bereichs wählen.')],JSON_HEX_TAG|JSON_HEX_AMP|JSON_HEX_APOS|JSON_HEX_QUOT)?>;
function update(){const invalid=fields.some(e=>!e.checkValidity());status.textContent=invalid?labels[2]:fields.some((e,i)=>e.value!==saved[i])?labels[1]+fields.map((e,i)=>saved[i]+' → '+e.value+' '+(e.name==='KUSZOB_GIB'?'GiB':'min')).join(' · '):labels[0];status.style.color=invalid?'#ed916e':'';}form.addEventListener('input',update);form.addEventListener('change',update);update();})();
</script>
