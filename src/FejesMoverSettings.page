<?php
$msMounted=(static function(){foreach(explode("\n",@file_get_contents('/proc/self/mountinfo')?:'') as $line){$fields=explode(' ',$line);if(($fields[4]??'')==='/mnt/cache')return true;}return false;})();
$msToken=(parse_ini_file('/var/local/emhttp/var.ini')['csrf_token']??'');
$msPath='/boot/config/plugins/user.scripts/scripts/Filmek_Mover_Threshold/script';
$msEsc=fn($v)=>htmlspecialchars((string)$v,ENT_QUOTES,'UTF-8');
$msSource=@file_get_contents($msPath);
if($msSource===false){
 echo '<div style="max-width:900px;margin:30px auto"><h2>Mover beállítások</h2><p>Ez az opcionális oldal a meglévő Filmek_Mover_Threshold User Scripts automatika paramétereit kezeli. A script nincs telepítve ezen a rendszeren.</p><p>A Mover figyelő ettől függetlenül használható. Ez a bővítmény nem telepít és nem ütemez automatikus mozgatást.</p><a href="/Tools/FejesMover">Vissza a Mover figyelőhöz</a></div>';
 return;
}

$msParse=function($s){$r=[];foreach(['KUSZOB_GIB','UJRA_PROBALKOZAS_MP'] as $k){if(preg_match_all('/^'.preg_quote($k,'/').'=(\d+)[ \t]*$/m',(string)$s,$m)!==1)throw new RuntimeException('A script paraméterei nem egyértelműek.');$r[$k]=(int)$m[1][0];}return $r;};
$msTotal=$msMounted?@disk_total_space('/mnt/cache'):false;$msFree=$msMounted?@disk_free_space('/mnt/cache'):false;$msMax=$msTotal?max(1,(int)floor($msTotal/1073741824)-1):0;
$msMessage='';$msError='';$msValues=['KUSZOB_GIB'=>300,'UJRA_PROBALKOZAS_MP'=>360];$msLock=null;$msTmp=null;
try{
 $msValues=$msParse($msSource);
 if(($_SERVER['REQUEST_METHOD']??'GET')==='POST'){
  if(!is_string($_POST['ms_csrf']??null)||empty($msToken)||!hash_equals($msToken,$_POST['ms_csrf']))throw new RuntimeException('Lejárt munkamenet. Töltsd újra az oldalt.');
  $msNew=[];foreach(['KUSZOB_GIB'=>$msMax,'UJRA_PROBALKOZAS_MP'=>10080] as $k=>$max){$v=$_POST[$k]??null;if(!is_string($v)||!preg_match('/^[1-9][0-9]{0,4}$/D',$v)||(int)$v>$max)throw new RuntimeException('Érvénytelen érték vagy nem elérhető cache.');$msNew[$k]=(int)$v;}
  $msLock=fopen('/var/run/fejes-mover-settings.lock','c');if(!$msLock||!flock($msLock,LOCK_EX|LOCK_NB))throw new RuntimeException('Másik mentés folyamatban.');
  $msSource=file_get_contents($msPath);$msValues=$msParse($msSource);
  if(!is_string($_POST['source_hash']??null)||!hash_equals(hash('sha256',$msSource),$_POST['source_hash']))throw new RuntimeException('A script közben megváltozott. Töltsd újra az oldalt.');
  if($msNew===$msValues){$msMessage='Ellenőrzés sikeres: az értékek már el vannak mentve. Nem történt módosítás.';}
  else{
   if(file_exists('/var/run/mover.pid'))throw new RuntimeException('Futó Mover mellett nem módosíthatók az értékek.');
   $msChanged=$msSource;foreach($msNew as $k=>$v)$msChanged=preg_replace('/^'.preg_quote($k,'/').'=[0-9]+[ \t]*$/m',$k.'='.$v,$msChanged);
   $msDir='/boot/config/plugins/fejes.mover.monitor/backups';if(!is_dir($msDir)&&!mkdir($msDir,0700,true))throw new RuntimeException('Nem hozható létre a mentési mappa.');
   $msBackup=$msDir.'/threshold-'.date('Ymd-His').'-'.bin2hex(random_bytes(3)).'.sh';
   if(file_put_contents($msBackup,$msSource,LOCK_EX)!==strlen($msSource)||file_get_contents($msBackup)!==$msSource)throw new RuntimeException('A biztonsági másolat ellenőrzése sikertelen.');
   $msTmp=tempnam(dirname($msPath),'.mover-');if(!$msTmp||file_put_contents($msTmp,$msChanged)!==strlen($msChanged))throw new RuntimeException('A mentés előkészítése sikertelen.');
   chmod($msTmp,fileperms($msPath)&0777);exec('/bin/bash -n '.escapeshellarg($msTmp).' 2>&1',$msOut,$msCode);if($msCode!==0)throw new RuntimeException('A script ellenőrzése sikertelen.');
   if(file_get_contents($msPath)!==$msSource)throw new RuntimeException('A script közben megváltozott.');
   if(!rename($msTmp,$msPath))throw new RuntimeException('A script cseréje sikertelen.');$msTmp=null;
   if(file_get_contents($msPath)!==$msChanged)throw new RuntimeException('A visszaolvasás sikertelen. Biztonsági másolat: '.$msBackup);
   $msSource=$msChanged;$msValues=$msNew;$msMessage='Sikeresen mentve és visszaellenőrizve. A következő scriptfutás ezeket használja. Biztonsági másolat: '.basename($msBackup);
  }
 }
}catch(Throwable $e){$msError=$e->getMessage();}
finally{if($msTmp&&is_file($msTmp))unlink($msTmp);if(is_resource($msLock)){flock($msLock,LOCK_UN);fclose($msLock);}}
?>
