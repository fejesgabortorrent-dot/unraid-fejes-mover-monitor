<script>
(()=>{const t=document.getElementById('ms-threshold'),s=document.getElementById('ms-slider'),c=document.getElementById('ms-cooldown'),free=<?=json_encode($msFree!==false?$msFree/1073741824:null)?>,total=<?=json_encode($msTotal?$msTotal/1073741824:null)?>;function preview(){document.getElementById('ms-hours').textContent=(Number(c.value)/60).toLocaleString('hu-HU',{maximumFractionDigits:2})+' óra';document.getElementById('ms-marker').style.left=Math.max(0,Math.min(100,100*(1-Number(t.value)/total)))+'%';document.getElementById('ms-preview').textContent=free===null?'A cache adatai most nem érhetők el.':free<Number(t.value)?'A szabad hely már a küszöb alatt van. A következő ellenőrzés a védelmek és a várakozás alapján dönt az indításról.':'Még '+(free-Number(t.value)).toLocaleString('hu-HU',{maximumFractionDigits:1})+' GiB szabad hely fogyhat el a küszöbig.';}t.addEventListener('input',()=>{s.value=t.value;preview()});s.addEventListener('input',()=>{t.value=s.value;preview()});c.addEventListener('input',preview);t.form.addEventListener('reset',()=>setTimeout(preview,0));preview();})();
